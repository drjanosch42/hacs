@article{emerton_eis,
  author  = {Emerton, Matthew},
  title   = {The {E}isenstein ideal in {H}ida's ordinary {H}ecke algebra},
  journal = {Internat. Math. Res. Notices}, number = {15}, pages = {793--802}, year = {1999},
  note    = {Thm.~5, p.~6 of the library copy (= the Theorem of the introduction, p.~2), VERIFIED: for $p\ge5$ and
             $i\not\equiv0\pmod{p-1}$, $\Lambda_{(i)}/L_p(\omega^{i},1-s)\to\mathbf T^{\mathrm{ord}}_{\mathrm{par},(i)}/I^{0}_{\mathrm{Eis}}$
             is an isomorphism, at tame level~$1$. The library copy is an 8-page preprint without journal header, so the
             journal data (IMRN 1999, no.~15) are NOT checked against it. Also used at [U] v0.1.1-pre.2 (lem:u-emerton):
             pp.~2--3 (the set-up, $\langle\gamma\rangle$ acting as $\gamma^{k}$ on $M_k$, $\mathbf T_{\mathrm{par}}$ = Hida's $h$), p.~5
             (ord = Hida's superscript $0$), p.~7 (the shift by $2$ against Mazur--Wiles).}}

@article{ohta_cong,
  author  = {Ohta, Masami},
  title   = {Congruence modules related to {E}isenstein series},
  journal = {Ann. Sci. \'Ecole Norm. Sup. (4)}, volume = {36}, number = {2}, pages = {225--269}, year = {2003},
  note    = {Thm.~(1.5.5), p.~238, VERIFIED (journal data from the library copy): under (1.5.2) the congruence modules of
             the four $\Lambda$-adic Eisenstein sequences (I)--(IV) of tame level $N$ are all $\Lambda_{\mathfrak r}/(A(T;\theta,\psi))$,
             $A$ of (1.5.4), $G(T,\theta\omega^{2})$ normalised by (1.4.5). Also used at [U] v0.1.1-pre.2 (rmk:u-ohta,
             rmk:u-classzero): (1.1.4), (1.1.6) pp.~229--230; (3.2.2)--(3.2.3) pp.~253--254; the $\psi=\mathbf1$ case of (II) via
             Appendix~A (from p.~263, the vanishing case p.~265).}}

