@misc{fam_ghitza,
  author  = {Fam, Yiannis and Ghitza, Alexandru},
  title   = {Hecke structure of quaternionic modular forms mod $p$},
  howpublished = {arXiv:2609.15495v1 [math.NT]}, year = {2026},
  note    = {Preprint, 14 Sep 2026 (the library copy, read). Thm.~5.6: the mod-$p$ Hecke eigensystems of the Shimura curve
             of an indefinite quaternion algebra of discriminant $\delta>1$ (all weights, fixed level $N\ge4$) are those of the
             mod-$p$ algebraic modular forms of the definite algebra of discriminant $p\delta$ --- Serre's letter to Tate
             beyond $\delta=1$.}}

