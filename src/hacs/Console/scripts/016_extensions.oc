# 016_extensions.oc -- the EXTENSION LAYER's own console verbs, registered from
# HeckeExt/RegisterHeckeExtensionVerbs.cpp ([OD] hecke-extensions slot-3
# close-out 1; slot-4 plan Sec. 2.3 item 4).
#
# The point of the placement is architectural: check_heckeext_includes.sh
# rule 1 forbids Console/Bindings/ from including a HeckeExt/ header, so the
# extension layer registers its own verbs instead, at the cost of exactly one
# exact-path exception in each of the two guards' rule 2.  This script is what
# proves the verbs are reachable from an ordinary session.
#
# Both units are PURE in the sense that matters here: HeckeSturmBound consumes
# nothing of the pipeline (guard rule 3) and HeckeUEllBudget is a frozen closed
# form.  So the script pins published numbers -- the twenty bounds of [E]
# def:bprime that slot-1 WP-3 froze, and the u_ell_rss/v2-2026-09-17 model --
# and not golden objects, of which these units have none.

include("prelude.oc");

# --- the computed Sturm bound B'(k, ell) ([E] def:bprime / cl:bprime) -------
# The pairs are (k, ell) with k the WEIGHT, k = n + 2.
for cell in [[12, 691], [34, 131], [162, 691], [200, 691]] {
    S = sturm_bound(cell[0], cell[1]);
    assert(S.found, "B' exists at (" + str(cell[0]) + ", " + str(cell[1]) + ")");
    assert(S.B_prime == 2, "B' = 2 at (" + str(cell[0]) + ", " + str(cell[1]) + ")");
    assert(S.certified, "and its certificate re-derives");
    assert(S.verify == 0, "with code 0");
}
for cell in [[24, 5], [30, 5], [32, 5], [36, 5], [60, 5]] {
    S = sturm_bound(cell[0], cell[1]);
    assert(S.B_prime == 5, "B' = 5 at (" + str(cell[0]) + ", " + str(cell[1]) + ")");
    assert(S.certified, "and its certificate re-derives");
}
assert(sturm_bound(28, 7).B_prime == 7, "B' = 7 at (28, 7)");
assert(sturm_bound(36, 7).B_prime == 3, "B' = 3 at (36, 7)");

S = sturm_bound(24, 5);
print(S.k, S.ell, S.B_prime, S.dim_M_k, S.closure_dim, S.primes_done, S.cap);

# The counterexample that makes the NAIVE B(k) sweep unsound: at (24, 5) the
# subalgebra generated by T_2 and T_3 alone is PROPER, so a cap of 3 cannot
# find B'.  Recorded, not thrown -- and resumable ([X] Sec. 1.3.1 R3).
CUT = sturm_bound(24, 5, 3);
assert(CUT.found == false, "a cap of 3 does not reach the closure at (24, 5)");
assert(CUT.outcome == "none_at_cap", "and says so");
assert(CUT.closure_dim < CUT.dim_M_k, "the closure is still proper");
assert(state(CUT).resumable.resumable == true, "the handle is resumable");
print(CUT.outcome, CUT.closure_dim, CUT.dim_M_k, CUT.primes_done);

CONT = resume(CUT, 36);
assert(CONT.found, "resuming under a higher cap finds it");
assert(CONT.B_prime == S.B_prime, "and finds the SAME B' a fresh run does");
assert(state(CONT).resumable.progress.budget_history == [3, 36],
       "R3.1 item 4: every run/resume appends its budget");
print(CONT.B_prime, state(CONT).resumable.progress.budget_history);

# --- the U_ell admission decision (HeckeExt/HeckeUEllBudget) ---------------
# The frozen model u_ell_rss/v2-2026-09-17 and the pinned refusal of [X]:
# U_43867 at n = 16 is predicted at 8254.76 MB against a 2048 MB budget.
V = u_ell_decision(16, 43867, 2048);
assert(V.included == false, "U_43867 at n = 16 is refused");
assert(V.reason == "u_ell_over_budget", "on memory grounds");
assert(V.predicted_mb == "8254.76", "the frozen model's prediction");
assert(V.model_version == "u_ell_rss/v2-2026-09-17", "the frozen model version");
print(V.included, V.reason, V.predicted_mb, V.budget_mb, V.model_version);

# A cell inside the budget, and the monotonicity of the model in n.
W = u_ell_decision(10, 691, 2048);
assert(W.included == true, "U_691 at n = 10 fits");
assert(W.reason == "within_budget", "within budget");
assert(W.predicted_centi_mb < V.predicted_centi_mb, "the model is monotone in (n, ell)");
print(W.included, W.reason, W.predicted_mb);

# `u_ell = off` refuses WITHOUT forming a prediction ([X]: the record then says
# "the user said no", never "it was too big").
set u_ell = "off";
OFF = u_ell_decision(10, 691);
assert(OFF.included == false, "off refuses");
assert(OFF.reason == "off", "and says the user said so");
assert(OFF.predicted_centi_mb == 0, "without forming a prediction");
print(OFF.included, OFF.reason);
set u_ell = "auto";
assert(fingerprint() == "0x0000000000000000", "the defaults are restored");
annotate("016_extensions: sturm_bound + u_ell_decision through HeckeExt/");
