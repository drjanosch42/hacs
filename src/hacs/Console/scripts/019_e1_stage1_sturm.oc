# 019_e1_stage1_sturm.oc -- phase E1's two INPUTS, from the console
# (slot-5 WP-10 item 3; [X] Sec. 2.2 Stage 1, [E] def:bprime / cl:bprime /
# cert:sturm).
#
# Stage 1 of the extension driver decides two things before any linear algebra
# happens, and both are decidable from the console today:
#
#   1. WHICH OPERATORS the local algebra A_S is generated by --
#      S_0 = {2, 3, 5, 7} union {ell, iff the frozen RSS model admits U_ell
#      inside the `u_ell` budget}.  That admission is `u_ell_decision`.
#   2. HOW FAR the Sturm sweep of generation certificate (c) has to go --
#      B'(k, ell), the least prime bound at which the F_ell-ALGEBRA generated
#      by T_q, q <= B, reaches dim M_k.  That is `sturm_bound`.
#
# 016 pins four of the twenty frozen bounds and two u_ell cells.  What is here
# and nowhere else in the script set is the pair of decisions ON [E] CLAIM 1.8's
# TEN KUMMER CELLS -- the case list E1 and E2 are about -- with the Kummer
# property of each cell DERIVED by `bernoulli_mod` (slot-5 WP-10 item 1) rather
# than copied from the claim, and the two counterexample cells of [E] cl:bprime
# that make the naive B(k) sweep unsound.

include("prelude.oc");

# ---------------------------------------------------------------------------
# The ten Kummer cells: derived, then decided.
# ---------------------------------------------------------------------------

KUMMER = [[10, 691], [14, 3617], [16, 43867], [18, 283], [18, 617],
          [20, 131], [20, 593], [22, 103], [22, 2294797], [24, 657931]];

admitted = 0;
refused = 0;
for cell in KUMMER {
    n = cell[0];
    ell = cell[1];
    k = n + 2;

    # (i) the cell IS a Kummer cell -- ell | num(B_k / k), read off B_k in
    # F_ell, which is legitimate because k < ell - 1 on every row.
    assert(bernoulli_mod(k, ell) == 0,
           "(" + str(n) + ", " + str(ell) + ") is a Kummer cell");

    # (ii) Stage 1's U_ell admission, by the frozen model u_ell_rss/v2-2026-09-17.
    V = u_ell_decision(n, ell);
    if V.included {
        assert(V.reason == "within_budget", "an admitted cell is admitted on budget");
        admitted = admitted + 1;
    }
    if V.included == false {
        assert(V.reason == "u_ell_over_budget",
               "a refused cell is refused on MEMORY, never on principle");
        refused = refused + 1;
    }

    # (iii) the Sturm bound of the cell's weight.  B' = 2 on all ten: T_2 alone
    # already generates the Hecke algebra of M_{n+2}(F_ell) there, which is why
    # [E] Claim 2.11's single-operator reading is the default everywhere below.
    S = sturm_bound(k, ell);
    assert(S.found, "B' exists at (" + str(k) + ", " + str(ell) + ")");
    assert(S.B_prime == 2, "and equals 2 on every Kummer cell");
    assert(S.certified, "with a certificate that re-derives");
    assert(S.closure_dim == S.dim_M_k, "the closure reached dim M_k");
}
assert(admitted + refused == 10, "all ten cells were decided");
assert(admitted == 7, "seven Kummer cells admit U_ell at the shipped budget");
assert(refused == 3, "and three are refused: (16, 43867), (22, 2294797), (24, 657931)");
print(admitted, refused);

# The three refusals, spelled out -- the predicted RSS is the model's, not a
# guess, and a refused U_ell leaves ell OUT of S_0 rather than running a
# 1.3e8-coset job.
for cell in [[16, 43867], [22, 2294797], [24, 657931]] {
    V = u_ell_decision(cell[0], cell[1]);
    assert(V.included == false, "refused");
    assert(V.model_version == "u_ell_rss/v2-2026-09-17", "by the frozen model");
    print(cell[0], cell[1], V.reason, V.predicted_mb, V.budget_mb);
}

# ---------------------------------------------------------------------------
# The two counterexamples of [E] cl:bprime -- why B'(k, ell) and not B(k).
# ---------------------------------------------------------------------------
#
# The classical Sturm bound B(k) = floor(k/12) + 1 bounds the primes needed to
# separate MODULAR FORMS; it does NOT bound the primes needed to GENERATE the
# Hecke algebra.  At (n, ell) = (22, 5) and (26, 7) the subalgebra generated by
# the primes up to 3 is PROPER, so a sweep stopped there would certify nothing
# -- which is exactly what a cap of 3 reports, resumably, rather than throwing.

for cell in [[22, 5, 5], [26, 7, 7]] {
    n = cell[0];
    ell = cell[1];
    k = n + 2;
    want = cell[2];

    S = sturm_bound(k, ell);
    assert(S.B_prime == want, "B'(" + str(k) + ", " + str(ell) + ") = " + str(want));
    assert(S.closure_dim == S.dim_M_k, "the full sweep reaches dim M_k");

    CUT = sturm_bound(k, ell, 3);
    assert(CUT.found == false, "the primes {2, 3} do not generate at (" +
                               str(k) + ", " + str(ell) + ")");
    assert(CUT.outcome == "none_at_cap", "recorded, never thrown");
    assert(CUT.closure_dim < CUT.dim_M_k, "the closure is strictly proper");
    assert(CUT.primes_done == [2, 3], "and exactly {2, 3} were consumed");
    assert(state(CUT).resumable.resumable == true, "the cut state is resumable");

    CONT = resume(CUT, S.cap);
    assert(CONT.B_prime == S.B_prime, "resuming reaches the same B' a fresh run does");
    assert(state(CONT).resumable.progress.budget_history == [3, S.cap],
           "R3.1 item 4: every run and resume appends its budget");
    print(k, ell, S.B_prime, CUT.outcome, CUT.closure_dim, CUT.dim_M_k, CONT.B_prime);
}

# `u_ell = off` is Stage 1's other branch: ell is kept out of S_0 because the
# USER said so, and the record must be able to say that rather than "it was too
# big" -- so no prediction is formed at all.
set u_ell = "off";
OFF = u_ell_decision(10, 691);
assert(OFF.included == false, "off keeps ell out of S_0");
assert(OFF.reason == "off", "for the user's reason, not the model's");
assert(OFF.predicted_centi_mb == 0, "without forming a prediction");
set u_ell = "auto";
assert(fingerprint() == "0x0000000000000000", "the defaults are restored");
print(OFF.reason, u_ell_decision(10, 691).reason);
annotate("019_e1_stage1_sturm: 10 Kummer cells decided, 2 counterexamples");
