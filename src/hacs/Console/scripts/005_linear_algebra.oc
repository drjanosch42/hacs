# 005_linear_algebra.oc -- the plan Sec. 3.5 surface, on the REAL operators of
# the (10, 691) cell and on small hand-written matrices.
#
# These are the verbs the extension engine's authors prototype against
# ([S Stage 2-5], [I G4-G7]), so the script exercises each one at least once and
# asserts an identity rather than a frozen number.

include("prelude.oc");

H = cohomology(symmetric_power(MODEL, N_SYM, ELL));
F = family(H);
T2 = F.T(2)[1];
T3 = F.T(3)[1];
d = H.dims[1];

# --- the algebra generated by T_2 and T_3, and its commutant ---------------
A = algebra([T2, T3]);
assert(A.dim >= 1, "the unital algebra contains the identity");
assert(A.ambient_dim == d, "the algebra acts on H^1");
assert(in_span(A.basis, identity(ELL, d)), "1 is in the generated algebra");
assert(in_span(A.basis, T2), "T_2 is in the generated algebra");
assert(in_span(A.basis, mul(T2, T3)), "the algebra is closed under multiplication");

C = commutant([T2, T3]);
assert(C.dim >= A.dim, "a commutative algebra sits inside its own commutant");
assert(in_span(C.basis, T2), "T_2 commutes with T_2 and T_3");

# --- solve / restrict, with the invariance certificate ---------------------
I = identity(ELL, d);
assert(hash(solve(I, T2)) == hash(T2), "solve(I, B) = B");
assert(hash(restrict(T2, I)) == hash(T2), "restrict to the whole space is the identity");

# The whole space is invariant; a NON-invariant subspace must be REJECTED by the
# exact solve, which is the invariance certificate.  J = [[0,1],[0,0]] sends the
# span of e_1 to the span of e_0, so that span is not J-invariant.
J = matrix(7, [[0, 1], [0, 0]]);
e1 = columns(identity(7, 2), [1]);
expect_error "not invariant" { restrict(J, e1); }
assert(hash(restrict(J, identity(7, 2))) == hash(J), "the whole space IS invariant");

# --- the subspace lattice --------------------------------------------------
K = kernel(sub(T2, T2));              # ker 0 = everything
assert(K.cols == d, "ker 0 is the whole space");
assert(rank(K) == d, "and it is non-degenerate");
assert(contains(K, columns(I, [0])), "e_0 is in the whole space");
assert(rank(sum_spaces(K, K)) == rank(K), "U + U = U");
assert(intersect(K, K).cols == d, "U /\\ U = U");
assert(nullity(I) == 0, "the identity has trivial kernel");

# --- vec / unvec, the End(V) <-> F_ell^{d^2} coordinates -------------------
assert(hash(unvec(vec(T2), d, d)) == hash(T2), "unvec . vec = id");
assert(vec(T2).rows == d * d, "vec lands in F_ell^{d^2}");

# --- polynomials of a matrix ----------------------------------------------
cp = charpoly(T2);
assert(cp.deg == d, "deg charpoly = dim");
assert(cp.monic or d == 0, "the characteristic polynomial is monic");
mp = minpoly(T2);
assert(hash(eval_at(mp, T2)) == hash(zero(ELL, d, d)), "Cayley-Hamilton for the minimal polynomial");
fac = factor(cp);
assert(fac.certified, "FactorPoly always certifies before returning");

# --- small hand-written checks (shape / error paths) -----------------------
S = matrix(7, [[1, 2], [3, 4]]);
assert(rank(S) == 2);
assert(hash(mul(S, inverse(S))) == hash(identity(7, 2)), "S S^{-1} = I");
assert(hash(transpose(transpose(S))) == hash(S), "transpose is an involution");
assert(S.entry(1, 0) == 3);
assert(hash(submatrix(S, 0, 1, 0, 2)) == hash(matrix(7, [[1, 2]])));
assert(hash(hstack([S, S])) == hash(matrix(7, [[1, 2, 1, 2], [3, 4, 3, 4]])));
assert(hash(vstack([S, S])) == hash(matrix(7, [[1, 2], [3, 4], [1, 2], [3, 4]])));

# A nilpotent Jordan type, from the nullities of the powers.
N = matrix(7, [[0, 1, 0], [0, 0, 1], [0, 0, 0]]);
assert(jordan_type(N) == [3], "one Jordan block of size 3");
N2 = matrix(7, [[0, 1, 0], [0, 0, 0], [0, 0, 0]]);
assert(jordan_type(N2) == [2, 1], "blocks 2 + 1");
expect_error "not nilpotent" { jordan_type(identity(7, 2)); }

# Seeded randomness is reproducible, and the seed is mandatory.
r1 = random_matrix(7, 3, 3, 12345);
r2 = random_matrix(7, 3, 3, 12345);
assert(hash(r1) == hash(r2), "the same seed gives the same matrix");
assert(hash(r1) != hash(random_matrix(7, 3, 3, 12346)), "a different seed gives a different one");

# Cyclicity, on a hand-built example whose answer is not in doubt: J = [[0,1],[0,0]]
# sends e_1 to e_0, so F_7[J].e_1 is the whole plane, while F_7[J].e_0 is a line.
e0 = columns(identity(7, 2), [0]);
assert(is_cyclic([J], e1), "F_7[J].e_1 is the whole plane");
assert(is_cyclic([J], e0) == false, "F_7[J].e_0 is a line");
assert(is_cyclic([J], cyclic_vector([J], 20260917)), "cyclic_vector returns a cyclic vector");


# (C1b) The frozen line: the dimension of the algebra F_ell[T_2, T_3] on H^1.
print(d, A.dim);

annotate("005_linear_algebra: dim H^1 = " + str(d) + ", dim F_ell[T_2, T_3] = " + str(A.dim));
