import GL2.Checkers.MerelData

/-!
# M4-i (slot 20, L20-4): the Heilbronn–Merel checker on real C++ output (kernel-checked)

[GT] `chk:merel-n5`.  Every `_check` below is `decide +kernel` on `GL2/Checkers/MerelData.lean`, generated by
`lean/tools/merel_dump_to_lean.py` from the `HECKE_DUMP_MEREL` dump of `HeckeLevelNValidation` (no `native_decide`,
no axiom): the C++ `HeilbronnOperator` at the validation's cell `(N, n) = (5, 2)` over `F_1000003`, `p = 2`
(`T_2^{(5)}`) and `p = 5` (`U_5^{(5)}`).  The `_sound` theorems are `merelCheck_sound` applied: the dumped dense
matrix is, entrywise in `ZMod 1000003`, the matrix of the spec operator `heilbronnApply` on the dumped table.
-/

namespace GL2.M4.Data
open GL2.M4

theorem merel_N5_n2_p2_check : merelCheck merel_N5_n2_p2 = true := by decide +kernel
theorem merel_N5_n2_p5_check : merelCheck merel_N5_n2_p5 = true := by decide +kernel

theorem merel_N5_n2_p2_sound : merel_N5_n2_p2.Sound := merelCheck_sound merel_N5_n2_p2 merel_N5_n2_p2_check
theorem merel_N5_n2_p5_sound : merel_N5_n2_p5.Sound := merelCheck_sound merel_N5_n2_p5 merel_N5_n2_p5_check

/-- Negative control: the first entry of the first block of the `p = 2` dump moved by one is rejected. -/
theorem merel_tampered_rejected :
    merelCheck { merel_N5_n2_p2 with
      terms := merel_N5_n2_p2.terms.modifyHead fun t =>
        (t.1, t.2.1, t.2.2.1, t.2.2.2.modifyHead fun x => (x + 1) % 1000003) } = false := by
  decide +kernel

end GL2.M4.Data
