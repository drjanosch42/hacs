import GL2.Checkers.TauP2Data

/-!
# L16-4: the checkers on real C++ output (kernel-checked)

[GT] `chk:tau-p2`, `orc:rhogolden`.  Every theorem below is `decide +kernel` on the data
`GL2/Checkers/TauP2Data.lean`, generated by `lean/tools/tau_dump_to_lean.py` from the
`HECKE_DUMP_TAU` dump of `HeckeTauDumpValidation` (no `native_decide`, no axiom).

* `tauP2_spec`: the dumped `p = 2` τ-table satisfies `obl:tau` (i)–(v), (vii) (`TauSpec`), via `tauCheck_sound`.
* `tauP2_fnv`, `tauP2_golden`: the Lean FNV-1a-64 of the checked table equals the C++'s, and its
  `HashScalar64` is the golden object `tau_table_fnv64_p2_r1` -- so the table the kernel checked is
  the table the golden reference pins.
* `tauP2_tampered_rejected`, `tauP2_tampered_off_golden`: the negative control (one coefficient of
  one edge slot negated) is rejected and leaves the golden hash.
* `rho_*_ok`: the C++ `ρ_n` matrices at the three golden cells `(2, 5)`, `(10, 691)`, `(16, 13)` are
  `ρ_n(A mod ℓ)` (`rhoCheck_sound`).
-/

namespace GL2.TauChk.Data
open GL2.TauChk

theorem tauP2_check : tauCheck tauP2 = true := by decide +kernel

/-- **Clauses (i)–(v), (vii) of `obl:tau` hold on the real `p = 2` table** (clause (vi) is not in
`TauSpec`; the pool matrices are covered by `rho_golden_cells`): (T1)–(T3) on generators, structure,
the bound `max(‖γ_t‖, 4N²) < 2^31`, integral regime, face closure. -/
theorem tauP2_spec : TauSpec tauP2 := tauCheck_sound _ tauP2_check

theorem tauP2_fnv : tableFnv tauP2 = tauP2.fnv := by decide +kernel

/-- The checked table is the golden one: `HashScalar64(fnv) = tau_table_fnv64_p2_r1`. -/
theorem tauP2_golden : hashScalar64 (tableFnv tauP2) = goldenTauHash := by decide +kernel

/-- Negative control: negate the coefficient of the first term of slot `(i, q, σ) = (1, 1, 0)`. -/
def tauP2Tampered : TauData :=
  { tauP2 with slots := tauP2.slots.map fun s =>
      if s.i = 1 ∧ s.q = 1 ∧ s.sigma = 0 then
        { s with terms := match s.terms with
                          | t :: ts => { t with coeff := -t.coeff } :: ts
                          | [] => [] }
      else s }

theorem tauP2_tampered_rejected : tauCheck tauP2Tampered = false := by decide +kernel

theorem tauP2_tampered_off_golden : hashScalar64 (tableFnv tauP2Tampered) ≠ goldenTauHash := by
  decide +kernel

end GL2.TauChk.Data

namespace GL2.Exec.Data
open GL2.Exec

theorem rho_n2_ell5_ok : rhoCheck 2 5 rho_n2_ell5 = true := by decide +kernel
theorem rho_n10_ell691_ok : rhoCheck 10 691 rho_n10_ell691 = true := by decide +kernel
theorem rho_n16_ell13_ok : rhoCheck 16 13 rho_n16_ell13 = true := by decide +kernel

/-- **The differential oracle at three golden cells**: every dumped C++ matrix is the executable
`ρ_n` of its key over `ZMod ℓ`, and expands `subst A (u n j)` column by column. -/
theorem rho_golden_cells :
    (∀ D ∈ rho_n2_ell5, (Matrix.of fun (t j : Fin 3) => ((D.entry t j : ℕ) : ZMod 5)) =
        rhoMat 2 (D.mat (R := ZMod 5))) ∧
    (∀ D ∈ rho_n10_ell691, (Matrix.of fun (t j : Fin 11) => ((D.entry t j : ℕ) : ZMod 691)) =
        rhoMat 10 (D.mat (R := ZMod 691))) ∧
    (∀ D ∈ rho_n16_ell13, (Matrix.of fun (t j : Fin 17) => ((D.entry t j : ℕ) : ZMod 13)) =
        rhoMat 16 (D.mat (R := ZMod 13))) :=
  ⟨fun D hD => (rhoCheck_sound _ _ _ rho_n2_ell5_ok D hD).1,
   fun D hD => (rhoCheck_sound _ _ _ rho_n10_ell691_ok D hD).1,
   fun D hD => (rhoCheck_sound _ _ _ rho_n16_ell13_ok D hD).1⟩

/-- Negative control: one entry of the first `(2, 5)` matrix moved by one is rejected. -/
theorem rho_tampered_rejected :
    rhoCheck 2 5 (rho_n2_ell5.modifyHead fun D =>
      { D with rows := D.rows.modifyHead fun r => r.modifyHead fun x => (x + 1) % 5 }) = false := by
  decide +kernel

end GL2.Exec.Data
