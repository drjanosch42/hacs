/-- Negative control at `n = 32`, `ℓ = 5`: the first entry of the first matrix moved by one is rejected. -/
theorem rho_grid_tampered_rejected :
    rhoCheck 32 5 (rho_n32_ell5.modifyHead fun D =>
      { D with rows := D.rows.modifyHead fun r => r.modifyHead fun x => (x + 1) % 5 }) = false := by
  rw [← rhoCheckFast_eq]; decide +kernel

