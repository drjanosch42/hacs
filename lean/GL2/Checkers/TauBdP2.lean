import GL2.Checkers.PairData.P2R1

/-!
# L18-3a: the `τ_∂` checker on real C++ output (kernel-checked)

[GT] `chk:taubd-p2`.  Every theorem below is `decide +kernel` on the data `GL2/Checkers/PairData/P2R1.lean`,
generated by `lean/tools/taubd_eta_to_lean.py` from the `HECKE_DUMP_TAU_PAIR=2:1` dump of
`HeckeTauDumpValidation` (no `native_decide`, no axiom beyond the standard three).

* `tauBdP2_spec`: the dumped `p = 2`, `ν = 1` `τ_∂`-table satisfies `obl:taubdry` (i)–(iv) (`TauBdSpec`).
* `tauBdP2_fnv`, `tauBdP2_fnv_golden`: its Lean FNV-1a-64 (walked as `HeckeBoundaryTauTable::table_fnv64`)
  equals the C++'s, and its `HashScalar64` is the golden object `tau_bd_table_fnv64_p2_r1`.
* `tauBdP2_tampered_rejected`, `tauBdP2_tampered_off_golden`: the negative control (the first term of the
  first non-empty edge slot negated) is rejected and leaves the golden hash.
-/

namespace GL2.TauChk.Data
open GL2.TauChk

/-- Negate the coefficient of the first term of the first slot of degree `q` that has a term. -/
def negFirstOfDeg (q : ℕ) : List Slot → List Slot
  | [] => []
  | s :: ss =>
    match s.terms with
    | t :: ts => if s.q = q then { s with terms := { t with coeff := -t.coeff } :: ts } :: ss
                 else s :: negFirstOfDeg q ss
    | [] => s :: negFirstOfDeg q ss

theorem tauBdP2_check : taubdCheck tauBdP2R1 = true := by decide +kernel

/-- **Clauses (i)–(iv) of `obl:taubdry` hold on the real `p = 2` `τ_∂`-table**: structure, (T3∂), the forced
component map, (T2∂), (T1∂) bookkeeping over every boundary transporter, coefficients `±1`, regime `Z`. -/
theorem tauBdP2_spec : TauBdSpec tauBdP2R1 := taubdCheck_sound _ tauBdP2_check

theorem tauBdP2_fnv : bdTableFnv tauBdP2R1 = tauBdP2R1.fnv := by decide +kernel

/-- The checked table is the golden one: `HashScalar64(fnv) = tau_bd_table_fnv64_p2_r1 = 0x47cbe6f1c81c7495`. -/
theorem tauBdP2_fnv_golden : hashScalar64 (bdTableFnv tauBdP2R1) = goldenTauBdP2R1 := by decide +kernel

/-- Negative control: the first term of the first non-empty edge slot negated. -/
def tauBdP2Tampered : TauBdData := { tauBdP2R1 with slots := negFirstOfDeg 1 tauBdP2R1.slots }

theorem tauBdP2_tampered_rejected : taubdCheck tauBdP2Tampered = false := by decide +kernel

theorem tauBdP2_tampered_off_golden : hashScalar64 (bdTableFnv tauBdP2Tampered) ≠ goldenTauBdP2R1 := by
  decide +kernel

end GL2.TauChk.Data
