import GL2.HeckeZ.Check.K10
import GL2.HeckeZ.Cells.MazurDataA
import GL2.HeckeZ.Cells.MazurDataB
import GL2.HeckeZ.Cells.MazurDataC
import GL2.HeckeZ.Cells.MazurDataD
import GL2.HeckeZ.Cells.MazurDataE
import GL2.HeckeZ.Cells.MazurDataF
import GL2.HeckeZ.Cells.MazurDataG
import GL2.HeckeZ.Cells.MerelDataA
import GL2.HeckeZ.Cells.MerelDataB
import GL2.HeckeZ.Cells.MerelDataC

/-!
# L-K10: the 180 Mazur cells of H3, certified (M-HZ4a, partly)

The cells are `slot25/H3_report.md`'s list (`MazurEisCellList()`: C4's 47 pairs united with [C, LN6]'s 168), with the `q`
accepted by H3's finder (the first good `q` passing the valuation check). The data modules `MazurData{A..G}` are generated by
`lean/tools/hz_mazur_to_lean.py` (manifest `docs/implementation/slot25/lk10-data/manifest_lk10.tsv`).

* `mazurCells_spec`: every cell satisfies `K10pSpec` (guards, Mazur-goodness of `q`, `v = v_ℓ(n)`, the Hensel factorisation of
  `c_q` at `1 + q` mod `ℓ^K`, and the valuation check for every lift).
* `mazurCells_cert`: on every cell, for Mazur's ring `T` (`hMazurEis`) and under the block identification `hblock`, the Hensel factor
  is the characteristic polynomial of `T_q` on `T`, `rank T = e`, `T = ℤ_ℓ[η_q]`, `𝔍T = (η_q)` (`mazur_val_cert`).
* `merelCells_e_eq` (audit MINOR-4): the K10 data `MerelData{A,B,C}` carry, cell by cell and in order, the `N`, `ℓ` and the rank
  `e = flo.length` of the K10′ certificates `allCells`; so K10's `e` is the certified `deg F`, by a kernel check, not by the
  generator's construction.
-/

namespace GL2.HeckeZ.Cells.Mazur

open Polynomial GL2.HeckeZ.Exec.K10 GL2.HeckeZ.K10 GL2.HeckeZ.Cells.MazurData GL2.Literature

/-- The 180 Mazur cells. -/
def allCells : List K10pCert := cellsA ++ cellsB ++ cellsC ++ cellsD ++ cellsE ++ cellsF ++ cellsG

theorem allCells_length : allCells.length = 180 := by decide +kernel

theorem allCells_check : allCells.all k10pCheck = true := by
  simp only [allCells, List.all_append, cellsA_check, cellsB_check, cellsC_check, cellsD_check, cellsE_check, cellsF_check,
    cellsG_check, Bool.and_self]

/-- **K10's `e` is K10′'s `deg F`** (audit MINOR-4): the Merel data agree with `allCells` in `N`, `ℓ` and `e = flo.length`. -/
theorem merelCells_e_eq :
    (merelCellsA ++ merelCellsB ++ merelCellsC).map (fun m => (m.N, m.ell, m.e)) =
      allCells.map (fun c => (c.N, c.ell, c.e)) := by
  decide +kernel

/-- **K10′ on the 180 cells.** -/
theorem mazurCells_spec : ∀ c ∈ allCells, K10pSpec c :=
  fun c hc => k10p_sound c (List.all_eq_true.mp allCells_check c hc)

/-- **The 180 cells, certified mod `hMazurEis` and the block identification.** -/
theorem mazurCells_cert (c : K10pCert) (hc : c ∈ allCells) [Fact c.ell.Prime] {T : Type*} [CommRing T]
    [Algebra ℤ_[c.ell] T] [Module.Free ℤ_[c.ell] T] [Module.Finite ℤ_[c.ell] T] {Tl : ℕ → T} {w : T}
    (hMazurEis : MazurEisLocal c.N c.ell T Tl w) (F' G : ℤ_[c.ell][X]) (d : ℕ)
    (hlift : F'.map (PadicInt.toZModPow c.K) = c.Fp.map (Int.castRingHom (ZMod (c.ell ^ c.K))))
    (hblock : F' = (LinearMap.mulLeft ℤ_[c.ell] (Tl c.q)).charpoly * G) (hGm : G.Monic)
    (hGred : G.map (PadicInt.toZModPow 1) = (X - C ((1 + c.q : ℕ) : ZMod (c.ell ^ 1))) ^ d) :
    G = 1 ∧ F' = (LinearMap.mulLeft ℤ_[c.ell] (Tl c.q)).charpoly ∧ Module.finrank ℤ_[c.ell] T = c.e ∧
      (c.ell : ℤ_[c.ell]) ^ c.v ∣ (LinearMap.mulLeft ℤ_[c.ell] (Tl c.q)).charpoly.eval ((1 + c.q : ℕ) : ℤ_[c.ell]) ∧
      ¬ (c.ell : ℤ_[c.ell]) ^ (c.v + 1) ∣
        (LinearMap.mulLeft ℤ_[c.ell] (Tl c.q)).charpoly.eval ((1 + c.q : ℕ) : ℤ_[c.ell]) ∧
      Algebra.adjoin ℤ_[c.ell] {mazurEta Tl c.q} = ⊤ ∧ eisensteinIdeal c.N Tl w = Ideal.span {mazurEta Tl c.q} :=
  mazur_val_cert c (List.all_eq_true.mp allCells_check c hc) hMazurEis F' G d hlift hblock hGm hGred

end GL2.HeckeZ.Cells.Mazur
