import GL2.Literature.SturmCuspPrime
import GL2.HeckeZ.SturmN

/-!
# M-HZ5 toy cells: the full algebra at level `N > 1` (L-HZ4, slot 26)

`07-lean-plan.md` §10 M-HZ5 ("T4's 127; T5 non-reduced"); 01 §9 T3, T4, T5; data `GL2.HeckeZ.Cells.FullNData` (generated by
`lean/tools/hzup_to_lean.py` from the `*.Up<p>.mat` dumps and `DescentRecord.module_Z()`, same `basis_fnv`).

**Hypotheses, all in the theorems' types:**
* `hF` — `hES_N` (`GL2.Literature.FullRankLevelN`, [GT] `lit:hz-es-full`, derived): `rank_ℤ 𝕋^fr = d = dim M_k(Γ_0(N))`;
* `hAn` — `hES_N_an` (`GL2.Literature.AnemicRankLevelN`, [GT] `lit:hz-es-anemic`): the anemic rank;
* `hU…`, `hT…` — **TB-int** (07 §1): the dumped integer matrices are the matrices of `U_p`, `T_p` on `L` in one `ℤ`-basis `b`.

**T4 `(2, 6)`, weight 8** (`T4_full`): three ring maps `λ₁, λ₁₂₈, μ` with `U₂ ↦ 1, 128, −8`, jointly injective;
`λ₁ ≡ λ₁₂₈ mod 127` on all of `𝕋` with the exact fibre product: **the congruence module of `(E¹, E⁷)` is `ℤ/127`** (07 §10, the
acceptance "T4's 127"); `(1, 0)` is in the image of `(λ₁, μ)` (`C(E¹, f) = 0`); `17 ∣ λ₁₂₈ − μ` everywhere and `136 ∈` the pair
ideal (`17 ∣ C(E⁷, f) ∣ 2³·17`).

**(5, 4), weight 6** (`F54_full`): the same shape, `U₅ ↦ 1, 3125, 25`: `C(E¹, E^{5⁵}) = ℤ/3124` and `C(E^{5⁵}, f) = ℤ/31` exactly.

**T5 `(8, 10)`, weight 12** (`T5_nonreduced`): `𝕋` is **not reduced** (`d = 13`, `d^an = 6`, `rank U₂² = 6`): the tag
`non_reduced_certified` of [C] as a theorem.

**T3 full `(11, 0)`** (`T3_full`): `U₁₁ = 1` on `L`, so `𝕋^fr = 𝕋^{an,fr}`.
-/

namespace GL2.HeckeZ.Cells.FullN

open GL2.Literature GL2.HeckeZ GL2.HeckeZ.Bridge GL2.HeckeZ.Three GL2.HeckeZ.Check.TBInt GL2.HeckeZ.Exec.TBInt
  GL2.HeckeZ.Cells.FullNData

set_option linter.unusedSectionVars false

variable {L : Type*} [AddCommGroup L] [Module.Free ℤ L] [Module.Finite ℤ L]
variable {X U : ℕ → Module.End ℤ L}

/-- Primes above a prime power: `p ∣ p₀ ^ r`, `p` prime ⇒ `p = p₀`, so `U p = 0` otherwise. -/
lemma U_zero_of_ne {N k d : ℕ} (hF : FullRankLevelN X U N k d) (p₀ : ℕ) (hp₀ : p₀.Prime) (r : ℕ) (hN : N = p₀ ^ r) :
    ∀ p, p ≠ p₀ → U p = 0 := by
  intro p hp
  refine hF.badU p ?_
  rintro ⟨hpp, hdvd⟩
  rw [hN] at hdvd
  exact hp ((Nat.prime_dvd_prime_iff_eq hpp hp₀).mp (hpp.dvd_of_dvd_pow hdvd))

/-- Reading a matrix entry of `P = (U − a)(U − c)`: the entry of the TB-int matrix `lmat` is the `b`-coordinate of `P (b j)`. -/
lemma entry_P {n : ℕ} (b : Module.Basis (Fin n) ℤ L) {u : Module.End ℤ L} {F : IMat}
    (hmat : LinearMap.toMatrix b b u = lmat n n F) (a c : ℤ) (i j : Fin n) :
    b.repr (((u - (a : Module.End ℤ L)) * (u - (c : Module.End ℤ L))) (b j)) i
      = ient (imul n n n (ishift n F a) (ishift n F c)) i j := by
  have h1 := toMatrix_mul' b (toMatrix_shift b hmat a) (toMatrix_shift b hmat c)
  have h2 := congrFun (congrFun h1 i) j
  rw [LinearMap.toMatrix_apply] at h2
  simpa [lmat] using h2

/-- `f(U) = 0` for the three-system shape, from the list check. -/
lemma f_zero {n : ℕ} (b : Module.Basis (Fin n) ℤ L) {u : Module.End ℤ L} {F : IMat}
    (hmat : LinearMap.toMatrix b b u = lmat n n F) (a b' c : ℤ)
    (h : ieq n n (imul n n n (imul n n n (ishift n F a) (ishift n F b')) (ishift n F c)) [] = true) :
    (u - (a : Module.End ℤ L)) * (u - (b' : Module.End ℤ L)) * (u - (c : Module.End ℤ L)) = 0 := by
  apply eq_zero_of_check b (F := imul n n n (imul n n n (ishift n F a) (ishift n F b')) (ishift n F c)) _ h
  exact toMatrix_mul' b (toMatrix_mul' b (toMatrix_shift b hmat a) (toMatrix_shift b hmat b')) (toMatrix_shift b hmat c)

/-- **T4 `(N, n) = (2, 6)`, weight 8, the full algebra** (M-HZ5). `hF`: `hES_N`, `d = 3`; `hAn`: `hES_N_an`, `d^an = 2`;
`hU`, `hT`: TB-int (`U_2`, `T_3` on one `ℤ`-basis). -/
theorem T4_full (b : Module.Basis (Fin 4) ℤ L) (hF : FullRankLevelN X U 2 8 3) (hAn : AnemicRankLevelN X 2 8 2)
    (hU : LinearMap.toMatrix b b (U 2) = lmat 4 4 c2_6_U) (hT : LinearMap.toMatrix b b (X 3) = lmat 4 4 c2_6_T) :
    ∃ S : ThreeSys (Tfull X U) (U 2) 1 128 (-8),
      (∀ t : Tfull X U, (127 : ℤ) ∣ S.la t - S.lb t) ∧
      (∀ x y, (∃ t : Tfull X U, S.la t = x ∧ S.lb t = y) ↔ (127 : ℤ) ∣ x - y) ∧
      (∃ t : Tfull X U, S.la t = 1 ∧ S.lc t = 0) ∧
      (∀ t : Tfull X U, (17 : ℤ) ∣ S.lb t - S.lc t) ∧
      ((136 : ℤ) ∈ pairIdeal S.lb S.lc) := by
  have hX3 : X 3 ∈ Bridge.Tfr X := Algebra.subset_adjoin ⟨3, rfl⟩
  have hR2 : Module.finrank ℤ (Bridge.Tfr X) ≤ 2 := hAn.rank.le
  have hp0 := U_zero_of_ne hF 2 Nat.prime_two 1 (by norm_num)
  obtain ⟨S, hXeq, hlow, hfib⟩ := full_three hF le_rfl hR2 2 hp0 3 (a := 1) (b := 128) (c := -8) (e := 2188) (g := 12)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (va := vecL b c2_6_va) (vb := vecL b c2_6_vb) (vc := vecL b c2_6_vc)
    (vecL_ne_zero b c2_6_nzva) (vecL_ne_zero b c2_6_nzvb) (vecL_ne_zero b c2_6_nzvc)
    (eigen_of_check b hU c2_6_Uva) (eigen_of_check b hU c2_6_Uvb) (eigen_of_check b hU c2_6_Uvc)
    (eigen_of_check b hT c2_6_Tva) (eigen_of_check b hT c2_6_Tvb) (eigen_of_check b hT c2_6_Tvc)
  have hUm : U 2 ∈ Tfull X U := Algebra.subset_adjoin (Or.inr ⟨2, rfl⟩)
  have hXm : X 3 ∈ Tfull X U := Algebra.subset_adjoin (Or.inl ⟨3, rfl⟩)
  have h127 : (∀ t : Tfull X U, (127 : ℤ) ∣ S.la t - S.lb t) := fun t => by simpa using hlow t
  have hfib' : ∀ x y, (∃ t : Tfull X U, S.la t = x ∧ S.lb t = y) ↔ (127 : ℤ) ∣ x - y := fun x y => by simpa using hfib x y
  -- T₃ eigenvalues on the lines
  have lT3a : S.la ⟨X 3, hXm⟩ = 2188 := by
    have e1 := S.acta ⟨X 3, hXm⟩ (vecL b c2_6_va) (eigen_of_check b hU c2_6_Uva)
    have e2 := eigen_of_check b hT c2_6_Tva
    have : (S.la ⟨X 3, hXm⟩ - 2188) • (vecL b c2_6_va) = 0 := by rw [sub_smul, ← e1, e2, sub_self]
    exact sub_eq_zero.mp ((smul_eq_zero.mp this).resolve_right (vecL_ne_zero b c2_6_nzva))
  have lT3c : S.lc ⟨X 3, hXm⟩ = 12 := by
    have e1 := S.actc ⟨X 3, hXm⟩ (vecL b c2_6_vc) (eigen_of_check b hU c2_6_Uvc)
    have e2 := eigen_of_check b hT c2_6_Tvc
    have : (S.lc ⟨X 3, hXm⟩ - 12) • (vecL b c2_6_vc) = 0 := by rw [sub_smul, ← e1, e2, sub_self]
    exact sub_eq_zero.mp ((smul_eq_zero.mp this).resolve_right (vecL_ne_zero b c2_6_nzvc))
  have lUa := S.hUa hUm
  have lUc := S.hUc hUm
  have lUb := S.hUb hUm
  -- `C(E¹, f) = 0`: `9, 2176 ∈ pairIdeal` and `gcd = 1`
  have h9 : (9 : ℤ) ∈ pairIdeal S.la S.lc := by
    have := sub_mem_pairIdeal S.la S.lc ⟨U 2, hUm⟩
    rwa [lUa, lUc, show (1 : ℤ) - -8 = 9 by norm_num] at this
  have h2176 : (2176 : ℤ) ∈ pairIdeal S.la S.lc := by
    have := sub_mem_pairIdeal S.la S.lc ⟨X 3, hXm⟩
    rwa [lT3a, lT3c, show (2188 : ℤ) - 12 = 2176 by norm_num] at this
  have hone : (1 : ℤ) ∈ pairIdeal S.la S.lc := by
    have h := Ideal.add_mem _ (Ideal.mul_mem_left _ (-967 : ℤ) h9) (Ideal.mul_mem_left _ (4 : ℤ) h2176)
    have e : (-967 : ℤ) * 9 + 4 * 2176 = 1 := by norm_num
    rwa [e] at h
  obtain ⟨t1, h1a, h1c⟩ := hone
  -- `17 ∣ λ₁₂₈ − μ`: the read
  have hf0 := f_zero b hU 1 128 (-8) c2_6_f
  have h17 : ∀ t : Tfull X U, (17 : ℤ) ∣ S.lb t - S.lc t := fun t => by
    have hs : (((17 : ℕ) : ℤ)) ^ 0 ∣ b.repr (((U 2 - ((1 : ℤ) : Module.End ℤ L)) * (U 2 - ((-8 : ℤ) : Module.End ℤ L))) (b c2_6_j)) c2_6_i := by rw [pow_zero]; exact one_dvd _
    have hent := (entry_P b hU 1 (-8) c2_6_i c2_6_j).trans c2_6_Pent
    have hs1 : ¬ (((17 : ℕ) : ℤ)) ^ (0 + 1) ∣ b.repr (((U 2 - ((1 : ℤ) : Module.End ℤ L)) * (U 2 - ((-8 : ℤ) : Module.End ℤ L))) (b c2_6_j)) c2_6_i := by
      rw [hent]; norm_num
    have := read_b_c hUm S hf0 t b 17 (by norm_num) (e := 1) (s := 0) (by norm_num) (b c2_6_j) c2_6_i hs hs1
    simpa using this
  have h136 : (136 : ℤ) ∈ pairIdeal S.lb S.lc := by
    have := sub_mem_pairIdeal S.lb S.lc ⟨U 2, hUm⟩
    rwa [lUb, lUc, show (128 : ℤ) - -8 = 136 by norm_num] at this
  exact ⟨S, h127, hfib', ⟨t1, h1a, h1c⟩, h17, h136⟩

/-- **`(5, 4)`, weight 6, the full algebra.** `hF`: `d = 3`; `hAn`: `d^an = 2`; TB-int `U_5`, `T_2`. -/
theorem F54_full (b : Module.Basis (Fin 4) ℤ L) (hF : FullRankLevelN X U 5 6 3) (hAn : AnemicRankLevelN X 5 6 2)
    (hU : LinearMap.toMatrix b b (U 5) = lmat 4 4 c5_4_U) (hT : LinearMap.toMatrix b b (X 2) = lmat 4 4 c5_4_T) :
    ∃ S : ThreeSys (Tfull X U) (U 5) 1 3125 25,
      (∀ t : Tfull X U, (3124 : ℤ) ∣ S.la t - S.lb t) ∧
      (∀ x y, (∃ t : Tfull X U, S.la t = x ∧ S.lb t = y) ↔ (3124 : ℤ) ∣ x - y) ∧
      (∃ t : Tfull X U, S.la t = 1 ∧ S.lc t = 0) ∧
      (∀ x y, (∃ t : Tfull X U, S.lb t = x ∧ S.lc t = y) ↔ (31 : ℤ) ∣ x - y) := by
  have hR2 : Module.finrank ℤ (Bridge.Tfr X) ≤ 2 := hAn.rank.le
  have hp0 := U_zero_of_ne hF 5 (by norm_num) 1 (by norm_num)
  obtain ⟨S, hXeq, hlow, hfib⟩ := full_three hF le_rfl hR2 5 hp0 2 (a := 1) (b := 3125) (c := 25) (e := 33) (g := 2)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (va := vecL b c5_4_va) (vb := vecL b c5_4_vb) (vc := vecL b c5_4_vc)
    (vecL_ne_zero b c5_4_nzva) (vecL_ne_zero b c5_4_nzvb) (vecL_ne_zero b c5_4_nzvc)
    (eigen_of_check b hU c5_4_Uva) (eigen_of_check b hU c5_4_Uvb) (eigen_of_check b hU c5_4_Uvc)
    (eigen_of_check b hT c5_4_Tva) (eigen_of_check b hT c5_4_Tvb) (eigen_of_check b hT c5_4_Tvc)
  have hUm : U 5 ∈ Tfull X U := Algebra.subset_adjoin (Or.inr ⟨5, rfl⟩)
  have hXm : X 2 ∈ Tfull X U := Algebra.subset_adjoin (Or.inl ⟨2, rfl⟩)
  have h1 : (∀ t : Tfull X U, (3124 : ℤ) ∣ S.la t - S.lb t) := fun t => by simpa using hlow t
  have hfib' : ∀ x y, (∃ t : Tfull X U, S.la t = x ∧ S.lb t = y) ↔ (3124 : ℤ) ∣ x - y := fun x y => by simpa using hfib x y
  have lT2a : S.la ⟨X 2, hXm⟩ = 33 := by
    have e1 := S.acta ⟨X 2, hXm⟩ (vecL b c5_4_va) (eigen_of_check b hU c5_4_Uva)
    have e2 := eigen_of_check b hT c5_4_Tva
    have : (S.la ⟨X 2, hXm⟩ - 33) • (vecL b c5_4_va) = 0 := by rw [sub_smul, ← e1, e2, sub_self]
    exact sub_eq_zero.mp ((smul_eq_zero.mp this).resolve_right (vecL_ne_zero b c5_4_nzva))
  have lT2b : S.lb ⟨X 2, hXm⟩ = 33 := by
    have e1 := S.actb ⟨X 2, hXm⟩ (vecL b c5_4_vb) (eigen_of_check b hU c5_4_Uvb)
    have e2 := eigen_of_check b hT c5_4_Tvb
    have : (S.lb ⟨X 2, hXm⟩ - 33) • (vecL b c5_4_vb) = 0 := by rw [sub_smul, ← e1, e2, sub_self]
    exact sub_eq_zero.mp ((smul_eq_zero.mp this).resolve_right (vecL_ne_zero b c5_4_nzvb))
  have lT2c : S.lc ⟨X 2, hXm⟩ = 2 := by
    have e1 := S.actc ⟨X 2, hXm⟩ (vecL b c5_4_vc) (eigen_of_check b hU c5_4_Uvc)
    have e2 := eigen_of_check b hT c5_4_Tvc
    have : (S.lc ⟨X 2, hXm⟩ - 2) • (vecL b c5_4_vc) = 0 := by rw [sub_smul, ← e1, e2, sub_self]
    exact sub_eq_zero.mp ((smul_eq_zero.mp this).resolve_right (vecL_ne_zero b c5_4_nzvc))
  have lUa := S.hUa hUm
  have lUb := S.hUb hUm
  have lUc := S.hUc hUm
  -- `C(E¹, f) = 0`: `24, 31 ∈ ideal`
  have h24 : (-24 : ℤ) ∈ pairIdeal S.la S.lc := by
    have := sub_mem_pairIdeal S.la S.lc ⟨U 5, hUm⟩
    rwa [lUa, lUc, show (1 : ℤ) - 25 = -24 by norm_num] at this
  have h31 : (31 : ℤ) ∈ pairIdeal S.la S.lc := by
    have := sub_mem_pairIdeal S.la S.lc ⟨X 2, hXm⟩
    rwa [lT2a, lT2c, show (33 : ℤ) - 2 = 31 by norm_num] at this
  have hone : (1 : ℤ) ∈ pairIdeal S.la S.lc := by
    have h := Ideal.add_mem _ (Ideal.mul_mem_left _ (9 : ℤ) h24) (Ideal.mul_mem_left _ (7 : ℤ) h31)
    have e : (9 : ℤ) * (-24) + 7 * 31 = 1 := by norm_num
    rwa [e] at h
  obtain ⟨t1, h1a, h1c⟩ := hone
  -- `31 ∣ λ_{3125} − μ`: the read, and `31 ∈ ideal` (T₂ difference `33 − 2`): the exact fibre product
  have hf0 := f_zero b hU 1 3125 25 c5_4_f
  have h31r : ∀ t : Tfull X U, (31 : ℤ) ∣ S.lb t - S.lc t := fun t => by
    have hs : (((31 : ℕ) : ℤ)) ^ 0 ∣ b.repr (((U 5 - ((1 : ℤ) : Module.End ℤ L)) * (U 5 - ((25 : ℤ) : Module.End ℤ L))) (b c5_4_j)) c5_4_i := by rw [pow_zero]; exact one_dvd _
    have hent := (entry_P b hU 1 25 c5_4_i c5_4_j).trans c5_4_Pent
    have hs1 : ¬ (((31 : ℕ) : ℤ)) ^ (0 + 1) ∣ b.repr (((U 5 - ((1 : ℤ) : Module.End ℤ L)) * (U 5 - ((25 : ℤ) : Module.End ℤ L))) (b c5_4_j)) c5_4_i := by
      rw [hent]; norm_num
    have := read_b_c hUm S hf0 t b 31 (by norm_num) (e := 1) (s := 0) (by norm_num) (b c5_4_j) c5_4_i hs hs1
    simpa using this
  have hup : (31 : ℤ) ∈ pairIdeal S.lb S.lc := by
    have := sub_mem_pairIdeal S.lb S.lc ⟨X 2, hXm⟩
    rwa [lT2b, lT2c, show (33 : ℤ) - 2 = 31 by norm_num] at this
  exact ⟨S, h1, hfib', ⟨t1, h1a, h1c⟩, fun x y => fibre_iff S.lb S.lc 31 h31r hup x y⟩

/-- **T5 `(N, n) = (8, 10)`, weight 12: the full algebra is not reduced** (`non_reduced_certified`, [C]). `hF`: `d = 13`;
`hAn`: `d^an = 6`; TB-int `U_2`. -/
theorem T5_nonreduced (b : Module.Basis (Fin 22) ℤ L) (hF : FullRankLevelN X U 8 12 13) (hAn : AnemicRankLevelN X 8 12 6)
    (hU : LinearMap.toMatrix b b (U 2) = lmat 22 22 c8_10_U) : ∃ t ∈ Tfull X U, t ≠ 0 ∧ IsNilpotent t := by
  have hp0 := U_zero_of_ne hF 2 Nat.prime_two 3 (by norm_num)
  have hUm : U 2 ∈ Tfull X U := Algebra.subset_adjoin (Or.inr ⟨2, rfl⟩)
  have hw : Module.finrank ℤ (LinearMap.range ((U 2) ^ 2)) ≤ 6 := rank_le_of_factor b hU c8_10_factor
  apply Count.not_isReduced_of_count (Tfull X U) (Bridge.Tfr X) (tfull_comm hF) Tfr_le_Tfull (U 2) hUm
    (tfull_gen hF 2 hp0) 2 (by norm_num)
  rw [hF.rank, hAn.rank]
  omega

/-- **T3 full `(11, 0)`, weight 2**: `U_11 = 1` on `L`, so the full algebra is the anemic one. -/
theorem T3_full (b : Module.Basis (Fin 3) ℤ L) (hF : FullRankLevelN X U 11 2 2)
    (hU : LinearMap.toMatrix b b (U 11) = lmat 3 3 c11_0_U) : Tfull X U = Bridge.Tfr X := by
  have hU1 : U 11 = 1 := by
    apply (LinearMap.toMatrix b b).injective
    rw [hU, lmat_eq_of_ieq c11_0_U_eq, LinearMap.toMatrix_one]
    ext i j
    fin_cases i <;> fin_cases j <;> rfl
  have hp0 := U_zero_of_ne hF 11 (by norm_num) 1 (by norm_num)
  refine le_antisymm (Algebra.adjoin_le ?_) Tfr_le_Tfull
  rintro _ (⟨i, rfl⟩ | ⟨j, rfl⟩)
  · exact Algebra.subset_adjoin ⟨i, rfl⟩
  · by_cases hj : j = 11
    · subst hj; rw [hU1]; exact Subalgebra.one_mem _
    · rw [hp0 j hj]; exact Subalgebra.zero_mem _


/-! ### LC-11 at prime level, weight 2: `(23, 0)` and `(11, 0)` -/

open GL2.HeckeZ.Sturm GL2.HeckeZ.Cert GL2.HeckeZ.Check GL2.HeckeZ.SturmN Polynomial in
/-- `aeval` of `c = x² + x − 1` as an operator. -/
lemma aeval_c23 (f : Module.End ℤ L) : aeval f (Polynomial.X ^ 2 + Polynomial.X - 1 : Polynomial ℤ) = f * f + (f - 1) := by
  simp [pow_two, sub_eq_add_neg, add_assoc]

open GL2.HeckeZ.Sturm GL2.HeckeZ.Cert GL2.HeckeZ.Check GL2.HeckeZ.SturmN Polynomial in
/-- **`(N, n) = (23, 0)`, weight 2: 01 Prop. 5.6 (LC-11) at prime level.** `𝕋^fr = ℤ[T_2, T_3]`. `hS`: `hSturm` at level 23, `B = 4`;
`hχ`: TB-χ of `T_2`; TB-int `T_2`. `g = 11 = c(3)`, `c = x² + x − 1`, read at `ℓ = 11` from `c(T_2)` on a `ℤ`-basis. -/
theorem C23_gen (b : Module.Basis (Fin 5) ℤ L) (hF : FullRankLevelN X U 23 2 3) (hS : SturmCuspPrimeLevel X U 23)
    (hT2 : LinearMap.toMatrix b b (X 2) = lmat 5 5 c23_0_T2)
    (hχ : (X 2).charpoly = (Polynomial.X - C 3) * (Polynomial.X ^ 2 + Polynomial.X - 1) ^ 2) :
    Tfull X U = Tp X [2, 3] := by
  have hXt2 : XtPrime X U 23 2 2 = X 2 := by simp [XtPrime]
  set cc : Polynomial ℤ := Polynomial.X ^ 2 + Polynomial.X - 1 with hcc
  have hC : LinearMap.toMatrix b b ((X 2) * (X 2) + ((X 2) - 1)) = lmat 5 5 c23_0_C := by
    have h1 := toMatrix_mul' b hT2 hT2
    have h2 := toMatrix_shift b hT2 1
    simp only [c23_0_C, lmat_iadd, map_add, h1]
    have h2' : (LinearMap.toMatrix b b) (X 2 - 1) = lmat 5 5 (ishift 5 c23_0_T2 1) := by
