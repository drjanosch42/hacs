import GL2.MP.RZDump
import GL2.Model.Model7

/-!
# MP-L1, rows L0 / L0b (slot 22): the two triangulations in use, `M₇` and `R_ℤ`, and Moerdijk–Pronk's table

[GT] `gt_part_MP.tex`, rows `def:mp-model7`, `thm:mp-model7-rules`, `thm:mp-model7-sc`, `def:mp-rz`, `thm:mp-rz-rules`,
`thm:mp-rz-dump`, backing [C] `def:mpRZ`, `tab:mprules`, `rmk:mprulesread` (1)–(4) and [C] `thm:mpcomparison` (5)'s
(IO) clause.

* `model7MP` is computed from **the same dump `tauP2` that defines `GL2.Model.model7`** (`TauData.toMP`: vertex orbits =
  the stored dimension-0 representatives, stabilisers = the stored `S(o, o)`, points `v = t · ι(rep v)` with `t ∈ S(v, rep v)`,
  maximal simplices = the stored triangles).  `tauP2_sc` is (SC) for the dump in the strong form: in dimensions `1, 2`
  the stored transporter sets `S(σ, σ')` are **exactly** the `γ` carrying the vertex set of `σ'` onto that of `σ`.
* `rzMP` is built from the C++ dump of `OrbifoldMPRulesValidation` (`GL2.MP.RZDump`, generated by
  `lean/tools/mp_dump_to_lean.py`, dump FNV in the header): stabilisers = the powers of the dumped generator up to the
  dumped order, points and maximal simplices as dumped.  `rz_arrows_dump` checks the Lean arrows `Ar(σ, σ')`, recomputed from
  orbits, points and maximal simplices, against the C++ arrows table; `rz_dump_counts` checks `|S_0|`, `|S_1|`; `rz_dump_rules`
  checks the C++ predicate rows of `M₇` and `R_ℤ` against the Lean predicates.
* `model7_rules`, `rz_rules`: [C] `tab:mprules` for the two rows: `M₇` is **not** adapted (MP's rule, subgroup form) but
  its Sylow data `𝔗^{(2)}, 𝔗^{(3)}` are; `R_ℤ` is adapted; neither is good (strong form; fails at `v₁, v₂, ζ², i` resp.
  `v₁, v₂, m`); no collar; quotients `(5, 9, 5, 1)` and `(6, 12, 7, 1)`; (IO) and (SC) hold; the orders-only form agrees.
-/

namespace GL2.MP

open GL2.TauChk GL2.TauChk.Data

/-! ### `M₇` from the `p = 2` dump -/

namespace TauDataMP

variable (D : TauData)

/-- The dimension-`0` orbit representatives, in index order. -/
def reps0 : List ℕ := (D.simplices.filter fun x => x.1 = 0 ∧ D.rep 0 x.2.1 = x.2.1).map (·.2.1)

/-- The orbit index of vertex `v`. -/
def orbIdx (v : ℕ) : ℕ := (reps0 D).idxOf (D.rep 0 v)

/-- **The MP descriptor of a dump** (`bd`: the boundary flags of the vertices). -/
def toMP (bd : List Bool) : MPDatum where
  stab := (reps0 D).map fun r => (D.trSet 0 r r).map (·.g)
  pts := (D.simplices.filter fun x => x.1 = 0).map fun x =>
    (orbIdx D x.2.1, ((D.trSet 0 x.2.1 (D.rep 0 x.2.1)).head?.map (·.g)).getD M22.I)
  bd := bd
  top := (D.simplices.filter fun x => x.1 = 2).map (·.2.2)

/-- The vertex-set candidates for `γ ι(σ') = ι(σ)`: some vertex of `σ'` goes to some vertex of `σ`. -/
def cands (M : MPDatum) (l' l : List ℕ) : List M22 :=
  l.flatMap fun p => l'.flatMap fun w => if M.orb p = M.orb w then M.coset (M.gp p) (M.orb p) (M.gp w) else []

/-- `γ` carries the vertex list `l'` onto `l`. -/
def sameVerts (M : MPDatum) (γ : M22) (l' l : List ℕ) : Bool :=
  l'.all (fun w => l.any fun p => M.maps γ w p) && l.all fun p => l'.any fun w => M.maps γ w p

/-- **(SC), strong form, on a dump**: in dimensions `1, 2` the stored transporters `S(σ, σ')` are exactly the vertex-set
transporters. -/
def scB (M : MPDatum) : Bool :=
  [1, 2].all fun q => (D.simplices.filter fun x => x.1 = q).all fun x => (D.simplices.filter fun y => y.1 = q).all fun y =>
    (cands M y.2.2 x.2.2).all (fun γ => !sameVerts M γ y.2.2 x.2.2 || (D.trSet q x.2.1 y.2.1).any (·.g == γ)) &&
      (D.trSet q x.2.1 y.2.1).all fun t => sameVerts M t.g y.2.2 x.2.2

end TauDataMP

/-- The boundary vertices `v₀, …, v₃` of [C] `def:model7`. -/
def model7Bd : List Bool := [true, true, true, true, false, false, false]

/-- **`M₇` as an MP descriptor**, computed from the dump `tauP2` that defines `GL2.Model.model7`. -/
def model7MP : MPDatum := TauDataMP.toMP tauP2 model7Bd

/-- The orbit representatives among the points (`g_p = 1`). -/
def MPDatum.repPts (M : MPDatum) : List ℕ := (List.range M.pts.length).filter fun p => M.gp p == M22.I

/-- The vertices (orbit representatives) at which the strong good form fails. -/
def MPDatum.goodFails (M : MPDatum) : List ℕ := M.repPts.filter fun p => !M.goodAtB p

/-- The vertices (orbit representatives) at which the finite-group criterion fails. -/
def MPDatum.goodFinFails (M : MPDatum) : List ℕ := M.repPts.filter fun p => !M.goodFinAtB p

/-- The vertices (orbit representatives) at which [C] `def:mprules` (3)'s literal form `T(v) ⊆ Γ_v` fails. -/
def MPDatum.goodVtxFails (M : MPDatum) : List ℕ := M.repPts.filter fun p => !M.goodVtxAtB p

theorem model7_shape :
    model7MP.stab.length = 5 ∧ model7MP.pts.length = 7 ∧ model7MP.top = [[0, 1, 4], [1, 2, 6], [1, 4, 6], [2, 3, 5], [2, 5, 6]] ∧
      model7MP.stab.map List.length = [2, 2, 2, 6, 4] := by decide +kernel

/-- **(SC) for the dump of `M₇`, strong form**: transporters in dimensions `1, 2` are exactly the vertex-set ones. -/
theorem tauP2_sc : TauDataMP.scB tauP2 model7MP = true := by decide +kernel

/-- **[C] `tab:mprules`, row `M₇`** (and (IO), (SC), well-formedness). -/
theorem model7_rules :
    model7MP.wfB = true ∧ model7MP.ioB = true ∧ model7MP.scTopB = true ∧
    model7MP.adaptedB none = false ∧ model7MP.adaptedB (some 2) = true ∧ model7MP.adaptedB (some 3) = true ∧
    model7MP.adaptedOrderB none = false ∧ model7MP.adaptedOrderB (some 2) = true ∧ model7MP.adaptedOrderB (some 3) = true ∧
    model7MP.goodStrongB = false ∧ model7MP.goodFails = [1, 2, 4, 6] ∧ model7MP.goodFinB = false ∧
    model7MP.goodFinFails = [1, 2, 4, 6] ∧ model7MP.collarB = false ∧
    (model7MP.quotV, model7MP.quotE, model7MP.quotF, model7MP.quotChi) = (5, 9, 5, 1) ∧ model7MP.card1 = 132 := by
  decide +kernel

/-! ### `R_ℤ` from the C++ dump -/

/-- **`R_ℤ` as an MP descriptor**, from the C++ dump: `Γ_o = ⟨gen⟩` (the powers up to the order). -/
def rzMP : MPDatum where
  stab := RZDump.orbits.map fun o => (List.range o.2.2).map fun i => M22.pow o.2.1 i
  pts := RZDump.points.map fun p => (p.1, p.2.1)
  bd := RZDump.points.map fun p => p.2.2
  top := RZDump.top

theorem rz_shape :
    rzMP.stab.length = 6 ∧ rzMP.pts.length = 9 ∧ rzMP.top.length = 7 ∧ rzMP.stab.map List.length = [2, 2, 2, 6, 4, 2] := by
  decide +kernel

/-- **[C] `tab:mprules`, row `R_ℤ`** (and (IO), (SC), well-formedness). -/
theorem rz_rules :
    rzMP.wfB = true ∧ rzMP.ioB = true ∧ rzMP.scTopB = true ∧
    rzMP.adaptedB none = true ∧ rzMP.adaptedB (some 2) = true ∧ rzMP.adaptedB (some 3) = true ∧
    rzMP.adaptedOrderB none = true ∧ rzMP.goodStrongB = false ∧ rzMP.goodFails = [1, 2, 7] ∧ rzMP.goodFinB = false ∧
    rzMP.goodFinFails = [1, 2, 7] ∧ rzMP.collarB = false ∧
    (rzMP.quotV, rzMP.quotE, rzMP.quotF, rzMP.quotChi) = (6, 12, 7, 1) ∧ rzMP.card1 = 172 := by
  decide +kernel

/-- **[C] `def:mprules` (3)'s literal strong form `T(v) ⊆ Γ_v` is stronger than the table's**: on `M₇` it fails at
every vertex orbit, on `R_ℤ` at `v₀, v₁, v₂, m` (holding only at `ζ², i`); the table's "fails at" column is the form
"`T(v)` in the stabiliser of one point of `St(v)`" (`goodFails`) and the finite-group criterion (`goodFinFails`). -/
theorem goodVtx_discrepancy :
    model7MP.goodVtxFails = [0, 1, 2, 4, 6] ∧ rzMP.goodVtxFails = [0, 1, 2, 7] ∧ rzMP.repPts = [0, 1, 2, 4, 6, 7] := by
  decide +kernel

/-- **The C++ arrows are the Lean arrows**: for every pair of maximal simplices, the dumped `Ar(σ, σ')` and the one
recomputed in Lean from the dumped orbits, points and maximal simplices are the same set. -/
theorem rz_arrows_dump :
    ((List.range 7).all fun σ => (List.range 7).all fun σ' =>
      let d := (RZDump.arrows.filter fun r => r.1 = σ ∧ r.2.1 = σ').map (·.2.2)
      d.Nodup && d.length == (rzMP.arr σ σ').length && d.all (· ∈ rzMP.arr σ σ')) = true ∧
    RZDump.arrows.length = 172 := by
  decide +kernel

/-- **The C++ counts**: `|S_0| = 7`, `|S_1| = 172` (all strings) as recomputed; the dumped non-degenerate `|S_1| = 165`
is `172 − 7` (the degenerate strings `(σ ←1— σ)`). -/
theorem rz_dump_counts :
    RZDump.sk = [(0, 7, 7), (1, 172, 165), (2, 3264, 2927)] ∧ rzMP.top.length = 7 ∧ rzMP.card1 = 172 ∧ 172 - 7 = 165 := by
  decide +kernel

/-- The isotropy selector of a predicate row: `ℓ = 0` is the full isotropy. -/
def selOf (ℓ : ℕ) : Option ℕ := if ℓ = 0 then none else some ℓ

/-- A predicate row as the C++ dump prints it. -/
def MPDatum.row (M : MPDatum) (tri ℓ : ℕ) : PredRow :=
  ⟨tri, ℓ, M.adaptedB (selOf ℓ), M.adaptedOrderB (selOf ℓ), M.goodFinB, M.collarB, M.quotV, M.quotE, M.quotF,
    M.quotChi⟩

/-- **The C++ predicate rows of `M₇` and `R_ℤ`** (`ℓ = 3, 2, 0`) are the Lean predicates: adapted (subgroup form),
orders-only, good (the finite-group criterion, as the C++ `good` column), collar, `V, E, F, χ`. -/
theorem rz_dump_rules :
    RZDump.predicates.filter (fun r => r.tri = 0) = [3, 2, 0].map (model7MP.row 0) ∧
    RZDump.predicates.filter (fun r => r.tri = 1) = [3, 2, 0].map (rzMP.row 1) := by
  decide +kernel

end GL2.MP
