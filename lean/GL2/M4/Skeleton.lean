import GL2.Model.RmkOrbifold
import Mathlib.RepresentationTheory.Homological.GroupCohomology.Shapiro

/-!
# The M4 skeleton (slot 19, L19-5): G5 the Hecke ring, G9 headers

Milestone M4 ([LP] §4.2, slot 20): G5 (the Hecke ring and its relations, or **H** plus the `p^n I` difference proved),
G9 (level `N` and the nebentypus by Shapiro). This file holds **statement skeletons only**:

* every `…_stmt` is a `def … : Prop`, the *statement* of an M4 row, with no proof attempted;
* each is linked from a `planned` row of [GT] `gt_part_M4.tex` (no `\leanok`), so the census counts it `planned`;
* nothing here uses `sorry`: the census stays `stated = 0`, `sorries = 0` (L19-0 §5.4, [S19] "L19-5 merges after F3, or its
  rows are `planned`").

Slot 20 proves a row by adding `theorem foo : foo_stmt` (or the unfolded statement), linking `foo` from the row and setting
`\leanok` on the statement and on the proof; the `_stmt` definition stays as the frozen statement the theorem must match.

The setting is that of `heckeTildeR` (`GL2.Model.WellDefTau`): `G = GL(2, ℚ)`, `Γ = SL(2, ℤ)` (as `ΓQ`), `Δ = ΔQ` (integral
matrices), the 7-vertex model, `τ` over `R` (`TauR`), any coefficient module `ρ : ΔQ →* End_R(V)`. `HM ρ n` is
`H^n(Hom_Γ(C_•(X_bulk), V))`, which is `H^n_eq(K, Rel; L)` by `Ψ` and `H^n(SL(2, ℤ); V)` by `rmkOrbifold` when `6 ∈ R^×`.
-/

noncomputable section

namespace GL2.M4

open scoped MatrixGroups
open GL2.Model GL2.Model.XBulk GL2.Cone GL2.Cosets CategoryTheory

section Hecke

variable {R : Type} [CommRing R] {V : Type} [AddCommGroup V] [Module R V] (ρ : ΔQ →* Module.End R V)

/-- `H^n` of the equivariant cochains of the model, coefficients `ρ` restricted to `Γ = SL(2, ℤ)`. -/
abbrev HM (n : ℕ) := (EqC model7 (hΓΔ := ΓQ_le_ΔQ) ρ eQ).H (n : ℤ)

/-- The operator `T_{Γ g Γ}` of a coset datum `cd` and a `g`-twisted chain datum `τ` over `R`, on `H^n`. -/
def Tdc {g : GLQ} (cd : CosetData ΓQ ΔQ g) (τ : TauR R g eQ) (n : ℕ) : Module.End R (HM ρ n) :=
  HmapOf (heckeTildeR (hΓΔ := ΓQ_le_ΔQ) ρ eQ cd τ) (heckeTildeR_isChainMap (hΓΔ := ΓQ_le_ΔQ) ρ cd τ) n

/-- **The Hecke algebra on `H^n`**: the `R`-subalgebra of `End_R(H^n)` generated by every `T_{Γ g Γ}`, `g ∈ Δ`. -/
def heckeAlg (n : ℕ) : Subalgebra R (Module.End R (HM ρ n)) :=
  Algebra.adjoin R {T | ∃ (g : GLQ) (cd : CosetData ΓQ ΔQ g) (τ : TauR R g eQ), T = Tdc ρ cd τ n}

/-- `z = N · I` as a matrix. -/
def IsScalarQ (z : GLQ) (N : ℤ) : Prop := (z : Matrix (Fin 2) (Fin 2) ℚ) = κ (N • (1 : Mat2 ℤ))

/-- The primitive operator `T_{Δ^prim_{p^μ}}` for a family of `τ`s (`cdP`), with `T_{Δ^prim_1} = 1`. -/
def Tprim (p : ℕ) (hp : p.Prime) (τ : ∀ μ : ℕ, TauR R (gP p μ hp) eQ) (n μ : ℕ) : Module.End R (HM ρ n) :=
  if h : 1 ≤ μ then Tdc ρ (cdP p μ hp h) (τ μ) n else 1

/-- The full operator by [C] `eq:fullassembly`, `T(p, p)` acting by the scalar `c`:
`T_{p^ν} = ∑_{0 ≤ 2j ≤ ν} c^j T_{Δ^prim_{p^{ν - 2j}}}`. -/
def Tfull (p : ℕ) (hp : p.Prime) (τ : ∀ μ : ℕ, TauR R (gP p μ hp) eQ) (c : R) (n ν : ℕ) : Module.End R (HM ρ n) :=
  ∑ j ∈ Finset.range (ν / 2 + 1), c ^ j • Tprim ρ p hp τ n (ν - 2 * j)

/-! ### Existence of the data (M4-a) -/

/-- [C] `lem:tauexists`(2), existence over `R` (`6 ∈ R^×`), in the form `heckeTildeR` reads: a `TauR` exists for every
`g ∈ GL(2, ℚ)`. Route: `model7_tauexists_2` on `fIncl g eQ`, `fConj g eQ`. -/
def tauR_nonempty_stmt : Prop :=
  ∀ (R : Type) [CommRing R], IsUnit (6 : R) → ∀ g : GLQ, Nonempty (TauR R g eQ)

/-- [C] `def:hecke`'s coset data (`prop:cosets`, `def:cosetrepsN`): every `g ∈ Δ` has a coset datum for `Γ g Γ`
(`Γ'' = Γ ∩ g Γ g⁻¹` has finite index in `Γ`, and `s_j⁻¹ g ∈ Δ`). -/
def cosetData_nonempty_stmt : Prop :=
  ∀ g : GLQ, g ∈ ΔQ → Nonempty (CosetData ΓQ ΔQ g)

/-! ### G5: the Hecke ring and its relations (M4-b … M4-e) -/

/-- [C] `prop:diamond`: a scalar `g = N·I` acts on `H^n` by the scalar `c` by which `ρ(g)` acts, whatever the coset datum
and `τ` (restatement: [C] has no hypothesis on `ℓ` for `τ = id`; for an arbitrary `τ` the route is (b), hence `6 ∈ R^×`). -/
def diamond_stmt : Prop :=
  ∀ (g : GLQ) (hg : g ∈ ΔQ) (N : ℤ) (c : R), IsScalarQ g N → ρ ⟨g, hg⟩ = c • 1 → IsUnit (6 : R) →
    ∀ (cd : CosetData ΓQ ΔQ g) (τ : TauR R g eQ) (n : ℕ), Tdc ρ cd τ n = c • 1

/-- [C] `prop:fullassembly`, the summand: for `g = p^j · diag(1, p^μ)` the operator of `Γ g Γ` is `c^j T_{Δ^prim_{p^μ}}`,
`c` the scalar of `ρ(p I)`. -/
def fullassembly_stmt : Prop :=
  ∀ (p : ℕ) (hp : p.Prime) (z : GLQ) (hz : z ∈ ΔQ) (c : R), IsScalarQ z p → ρ ⟨z, hz⟩ = c • 1 → IsUnit (6 : R) →
    ∀ (j μ : ℕ) (hμ : 1 ≤ μ) (g : GLQ), (g : Matrix (Fin 2) (Fin 2) ℚ) = κ (((p : ℤ) ^ j) • gMat ((p : ℤ) ^ μ)) →
    ∀ (cd : CosetData ΓQ ΔQ g) (τ : TauR R g eQ) (τ' : TauR R (gP p μ hp) eQ) (n : ℕ),
      Tdc ρ cd τ n = c ^ j • Tdc ρ (cdP p μ hp hμ) τ' n

/-- **The `p^n I` difference** ([C] `thm:relations` caveat, `obl:algebra`(iii)): `T_p² = T_{Δ^prim_{p²}} + (p + 1) c`,
i.e. with `c = p^n`: `T_{Δ^prim_{p²}} = T_p² − p^{n+1} − p^n`, and the full `T_{p²} = T_{Δ^prim_{p²}} + c = T_p² − p c`. -/
def Tp_sq_stmt : Prop :=
  ∀ (p : ℕ) (hp : p.Prime) (z : GLQ) (hz : z ∈ ΔQ) (c : R), IsScalarQ z p → ρ ⟨z, hz⟩ = c • 1 → IsUnit (6 : R) →
    ∀ (τ₁ : TauR R (gP p 1 hp) eQ) (τ₂ : TauR R (gP p 2 hp) eQ) (n : ℕ),
      Tdc ρ (cdP p 1 hp le_rfl) τ₁ n * Tdc ρ (cdP p 1 hp le_rfl) τ₁ n =
        Tdc ρ (cdP p 2 hp (by norm_num)) τ₂ n + ((p : R) + 1) • c • (1 : Module.End R (HM ρ n))

/-- [C] `thm:relations`(1), the recursion for the **full** operators:
`T_{p^{ν+2}} = T_p T_{p^{ν+1}} − p c T_{p^ν}` (`c = p^n`: the coefficient `p^{n+1}`). -/
def relations_stmt : Prop :=
  ∀ (p : ℕ) (hp : p.Prime) (z : GLQ) (hz : z ∈ ΔQ) (c : R), IsScalarQ z p → ρ ⟨z, hz⟩ = c • 1 → IsUnit (6 : R) →
    ∀ (τ : ∀ μ : ℕ, TauR R (gP p μ hp) eQ) (n ν : ℕ),
      Tfull ρ p hp τ c n (ν + 2) =
        Tprim ρ p hp τ n 1 * Tfull ρ p hp τ c n (ν + 1) - ((p : R) * c) • Tfull ρ p hp τ c n ν

/-- [C] `thm:relations`(2), primitive form: `T_{Γ diag(1,M) Γ} T_{Γ diag(1,N) Γ} = T_{Γ diag(1,MN) Γ}` for coprime
`M, N > 0`, any coset data and `τ`s. -/
def coprime_stmt : Prop :=
  IsUnit (6 : R) → ∀ (M N : ℤ) (hM : M ≠ 0) (hN : N ≠ 0), 0 < M → 0 < N → IsCoprime M N →
    ∀ (cd₁ : CosetData ΓQ ΔQ (gQ M hM)) (τ₁ : TauR R (gQ M hM) eQ)
      (cd₂ : CosetData ΓQ ΔQ (gQ N hN)) (τ₂ : TauR R (gQ N hN) eQ)
      (cd₃ : CosetData ΓQ ΔQ (gQ (M * N) (mul_ne_zero hM hN))) (τ₃ : TauR R (gQ (M * N) (mul_ne_zero hM hN)) eQ)
      (n : ℕ), Tdc ρ cd₁ τ₁ n * Tdc ρ cd₂ τ₂ n = Tdc ρ cd₃ τ₃ n

/-- [C] `thm:relations`(1) first clause and `obl:algebra`(i), for every pair of double cosets: the operators commute. -/
def Tdc_commute_stmt : Prop :=
  IsUnit (6 : R) → ∀ (g g' : GLQ) (cd : CosetData ΓQ ΔQ g) (τ : TauR R g eQ) (cd' : CosetData ΓQ ΔQ g')
    (τ' : TauR R g' eQ) (n : ℕ), Commute (Tdc ρ cd τ n) (Tdc ρ cd' τ' n)

/-- [C] `obl:algebra`, the algebra form: `heckeAlg` is commutative (from `Tdc_commute_stmt` by `Algebra.adjoin`). -/
def heckeAlg_comm_stmt : Prop :=
  IsUnit (6 : R) → ∀ (n : ℕ), ∀ a ∈ heckeAlg ρ n, ∀ b ∈ heckeAlg ρ n, a * b = b * a

end Hecke

/-! ### G9 headers: level `N` by Shapiro (M4-g) -/

/-- [C] `def:levelellmodel` / `prop:lhcompliant`(4) on the model, in mathlib's form: for `6 ∈ k^×`, the model's
cohomology with the coinduced coefficients `Coind_{Γ₀(N)}^{Γ} A` is `H^n(Γ₀(N); A)`
(`rmkOrbifold` at `model7`, then `groupCohomology.coindIso`). The identification of `Coind` with [C]'s explicit induced
fibre `Ind_{Γ₀(N)}^{Γ} V_R` (`eq:MH`, the monomial blocks `ρ_n(h_j(γ))`) is the separate row `def:levelellmodel`. -/
def levelN_shapiro_stmt : Prop :=
  ∀ (k : Type) [CommRing k], IsUnit (6 : k) → ∀ (N : ℕ) (A : Rep k (CongruenceSubgroup.Gamma0 N)) (n : ℕ),
    Nonempty ((relCxA model7 (Rep.coind (CongruenceSubgroup.Gamma0 N).subtype A)).H (n : ℤ) ≃ₗ[k]
      groupCohomology A n)

end GL2.M4

end
