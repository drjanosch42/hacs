/-! ### `lem:freepart` -/

variable [Module.Finite ℤ_[p] L]

/-! #### Auxiliary lemmas (L17-1) -/

/-- A finite `ℤ_p`-module killed by `p^k` has finite length. -/
theorem length_ne_top_of_killed {M : Type*} [AddCommGroup M] [Module ℤ_[p] M] [Module.Finite ℤ_[p] M] (k : ℕ)
    (h : ∀ x : M, ((p : ℤ_[p]) ^ k) • x = 0) : Module.length ℤ_[p] M ≠ ⊤ := by
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' ℤ_[p] M
  have hle : (pI p ^ k) • (⊤ : Submodule ℤ_[p] (Fin n → ℤ_[p])) ≤ LinearMap.ker f := by
    intro y hy
    obtain ⟨z, rfl⟩ := (mem_pI_pow_smul_top k y).mp hy
    rw [LinearMap.mem_ker, map_smul, h]
  have hsurj : Function.Surjective (((pI p ^ k) • (⊤ : Submodule ℤ_[p] (Fin n → ℤ_[p]))).liftQ f hle) := by
    intro m
    obtain ⟨y, rfl⟩ := hf m
    exact ⟨Submodule.Quotient.mk y, rfl⟩
  have hlen := Module.length_le_of_surjective _ hsurj
  rw [length_free_quot] at hlen
  exact ne_top_of_le_ne_top (ENat.natCast_ne_top _) hlen

/-- `𝕃_tors` is killed by a power of `ℓ` (it is finitely generated and torsion). -/
theorem torsion_killed : ∃ k : ℕ, ∀ x ∈ Submodule.torsion ℤ_[p] L, ((p : ℤ_[p]) ^ k) • x = 0 := by
  obtain ⟨S, hS⟩ := IsNoetherian.noetherian (Submodule.torsion ℤ_[p] L)
  have hk : ∀ s ∈ S, ∃ k : ℕ, ((p : ℤ_[p]) ^ k) • s = 0 := fun s hs => by
    have hs' : s ∈ Submodule.torsion ℤ_[p] L := hS ▸ Submodule.subset_span hs
    obtain ⟨⟨a, ha⟩, has⟩ := (Submodule.mem_torsion_iff s).mp hs'
    have has' : a • s = 0 := has
    have ha0 : a ≠ 0 := nonZeroDivisors.ne_zero ha
    have hspec := PadicInt.unitCoeff_spec ha0
    have e : (↑(PadicInt.unitCoeff ha0)⁻¹ : ℤ_[p]) * a = (p : ℤ_[p]) ^ a.valuation := by
      have h' : (↑(PadicInt.unitCoeff ha0)⁻¹ : ℤ_[p]) *
          (↑(PadicInt.unitCoeff ha0) * (p : ℤ_[p]) ^ a.valuation) = (p : ℤ_[p]) ^ a.valuation := by
        rw [← mul_assoc, Units.inv_mul, one_mul]
      rwa [← hspec] at h'
    exact ⟨a.valuation, by rw [← e, mul_smul, has', smul_zero]⟩
  choose! k hk using hk
  refine ⟨S.sup k, fun x hx => ?_⟩
  rw [← hS] at hx
  have hle : Submodule.span ℤ_[p] (S : Set L) ≤ Submodule.torsionBy ℤ_[p] L ((p : ℤ_[p]) ^ S.sup k) := by
    rw [Submodule.span_le]
    intro s hs
    rw [SetLike.mem_coe, Submodule.mem_torsionBy_iff]
    obtain ⟨j, hj⟩ := Nat.exists_eq_add_of_le (Finset.le_sup hs : k s ≤ S.sup k)
    rw [hj, pow_add, mul_comm, mul_smul, hk s hs, smul_zero]
  exact (Submodule.mem_torsionBy_iff _ _).mp (hle hx)

theorem mem_torsion_of_pow_smul {x : L} (k : ℕ) (h : ((p : ℤ_[p]) ^ k) • x = 0) :
    x ∈ Submodule.torsion ℤ_[p] L :=
  (Submodule.mem_torsion_iff x).mpr ⟨⟨_, mem_nonZeroDivisors_of_ne_zero (pZp_pow_ne_zero k)⟩, h⟩

/-- The map `𝕃'/ℓ^{K-t} ≅ ℓ^t N`, `[x] ↦ ℓ^t x`, of `lem:freepart`(1), equivariant for every endomorphism. -/
theorem freepart_exists (t K : ℕ) (htK : t ≤ K)
    (ht : ∀ x ∈ Submodule.torsion ℤ_[p] L, ((p : ℤ_[p]) ^ t) • x = 0) :
    ∃ φ : (Lfree (p := p) L ⧸ (pI p ^ (K - t)) • (⊤ : Submodule ℤ_[p] (Lfree (p := p) L))) ≃ₗ[ℤ_[p]]
        ↥((pI p ^ t) • (⊤ : Submodule ℤ_[p] (L ⧸ (pI p ^ K) • (⊤ : Submodule ℤ_[p] L)))),
      ∀ (f : Module.End ℤ_[p] L) x,
        ((φ (endQ (pI p ^ (K - t)) (onFree f) x) : _) : L ⧸ (pI p ^ K) • (⊤ : Submodule ℤ_[p] L)) =
          endQ (pI p ^ K) f (φ x) := by
  let N := (pI p ^ K) • (⊤ : Submodule ℤ_[p] L)
  let g0 : L →ₗ[ℤ_[p]] L ⧸ N := N.mkQ ∘ₗ (((p : ℤ_[p]) ^ t) • LinearMap.id)
  have hg0 : ∀ v, g0 v ∈ (pI p ^ t) • (⊤ : Submodule ℤ_[p] (L ⧸ N)) := fun v =>
    (mem_pI_pow_smul_top t _).mpr ⟨N.mkQ v, by simp [g0]⟩
  let g1 := g0.codRestrict _ hg0
  have h1 : Submodule.torsion ℤ_[p] L ≤ LinearMap.ker g1 := fun x hx => by
    rw [LinearMap.mem_ker]
    apply Subtype.ext
    show N.mkQ (((p : ℤ_[p]) ^ t) • x) = 0
    rw [ht x hx, map_zero]
  let g2 := (Submodule.torsion ℤ_[p] L).liftQ g1 h1
  have h2 : (pI p ^ (K - t)) • (⊤ : Submodule ℤ_[p] (Lfree (p := p) L)) ≤ LinearMap.ker g2 := by
    intro x hx
    obtain ⟨y, rfl⟩ := (mem_pI_pow_smul_top _ x).mp hx
    induction y using Submodule.Quotient.induction_on with
    | H v =>
      rw [LinearMap.mem_ker, ← Submodule.Quotient.mk_smul]
      apply Subtype.ext
      show N.mkQ (((p : ℤ_[p]) ^ t) • ((p : ℤ_[p]) ^ (K - t)) • v) = 0
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, mem_pI_pow_smul_top]
      exact ⟨v, by rw [← mul_smul, ← pow_add, Nat.add_sub_cancel' htK]⟩
  let g3 := ((pI p ^ (K - t)) • (⊤ : Submodule ℤ_[p] (Lfree (p := p) L))).liftQ g2 h2
  have hcomp : ∀ v : L, ((g3 (Submodule.Quotient.mk (Submodule.Quotient.mk v)) : _) : L ⧸ N) =
      Submodule.Quotient.mk (((p : ℤ_[p]) ^ t) • v) := fun v => rfl
  have hinj : Function.Injective g3 := by
    rw [← LinearMap.ker_eq_bot, eq_bot_iff]
    intro x hx
    induction x using Submodule.Quotient.induction_on with
    | H y =>
    induction y using Submodule.Quotient.induction_on with
    | H v =>
      rw [LinearMap.mem_ker] at hx
      have hx' := congrArg Subtype.val hx
      rw [hcomp, ZeroMemClass.coe_zero, Submodule.Quotient.mk_eq_zero, mem_pI_pow_smul_top] at hx'
      obtain ⟨w, hw⟩ := hx'
      rw [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero, mem_pI_pow_smul_top]
      refine ⟨Submodule.Quotient.mk w, ?_⟩
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.eq]
      apply mem_torsion_of_pow_smul t
      rw [smul_sub, hw, ← mul_smul, ← pow_add, Nat.add_sub_cancel' htK, sub_self]
  have hsurj : Function.Surjective g3 := by
    rintro ⟨y, hy⟩
    obtain ⟨z, rfl⟩ := (mem_pI_pow_smul_top t y).mp hy
    induction z using Submodule.Quotient.induction_on with
    | H v =>
      refine ⟨Submodule.Quotient.mk (Submodule.Quotient.mk v), Subtype.ext ?_⟩
      rw [hcomp, Submodule.Quotient.mk_smul]
  refine ⟨LinearEquiv.ofBijective g3 ⟨hinj, hsurj⟩, fun f x => ?_⟩
  induction x using Submodule.Quotient.induction_on with
  | H y =>
  induction y using Submodule.Quotient.induction_on with
  | H v =>
    show ((g3 (Submodule.Quotient.mk (Submodule.Quotient.mk (f v))) : _) : L ⧸ N) =
      endQ (pI p ^ K) f (g3 (Submodule.Quotient.mk (Submodule.Quotient.mk v)))
    rw [hcomp, hcomp]
    show _ = Submodule.Quotient.mk (f (((p : ℤ_[p]) ^ t) • v))
    rw [map_smul]

/-- **`lem:freepart`(1)**: if `ℓ^t 𝕃_tors = 0` and `K > t`, multiplication by `ℓ^t` induces a Hecke-equivariant
isomorphism `𝕃'/ℓ^{K-t} ≅ ℓ^t N`, `N = 𝕃/ℓ^K`. -/
theorem freepart_iso (t K : ℕ) (htK : t < K) (ht : ∀ x ∈ Submodule.torsion ℤ_[p] L, ((p : ℤ_[p]) ^ t) • x = 0) :
    ∃ φ : (Lfree (p := p) L ⧸ (pI p ^ (K - t)) • (⊤ : Submodule ℤ_[p] (Lfree (p := p) L))) ≃ₗ[ℤ_[p]]
        ↥((pI p ^ t) • (⊤ : Submodule ℤ_[p] (L ⧸ (pI p ^ K) • (⊤ : Submodule ℤ_[p] L)))),
      ∀ i x, ((φ (endQ (pI p ^ (K - t)) (onFree (X i)) x) : _) : L ⧸ (pI p ^ K) • (⊤ : Submodule ℤ_[p] L)) =
        endQ (pI p ^ K) (X i) (φ x) := by
  obtain ⟨φ, hφ⟩ := freepart_exists t K htK.le ht
  exact ⟨φ, fun i x => hφ (X i) x⟩

/-- **`lem:freepart`(2)**: an `a ∈ T^coh` kills `ℓ^t N` iff `ℓ^t a = 0` in `End N`, iff its image in `End(𝕃'/ℓ^{K-t})` is
`0`: the image of `T^coh` in `End(ℓ^t N)` is `𝖠_K/𝖠_K[ℓ^t] ≅ ℓ^t 𝖠_K`, and it is `𝖠'_{K-t}`, to which `prop:saturation`
applies with `(𝕃', T^𝕃)` at level `K - t`. -/
theorem freepart_image (t K : ℕ) (htK : t < K)
    (ht : ∀ x ∈ Submodule.torsion ℤ_[p] L, ((p : ℤ_[p]) ^ t) • x = 0) (a : Module.End ℤ_[p] L) (ha : a ∈ Tcoh X) :
    ((∀ y ∈ (pI p ^ t) • (⊤ : Submodule ℤ_[p] (L ⧸ (pI p ^ K) • (⊤ : Submodule ℤ_[p] L))),
        endQ (pI p ^ K) a y = 0) ↔ ((p : ℤ_[p]) ^ t) • endQ (pI p ^ K) a = 0) ∧
    ((∀ y ∈ (pI p ^ t) • (⊤ : Submodule ℤ_[p] (L ⧸ (pI p ^ K) • (⊤ : Submodule ℤ_[p] L))),
        endQ (pI p ^ K) a y = 0) ↔ endQ (pI p ^ (K - t)) (onFree a) = 0) := by
  obtain ⟨φ, hφ⟩ := freepart_exists t K htK.le ht
  refine ⟨⟨fun h => LinearMap.ext fun z => ?_, fun h y hy => ?_⟩, ⟨fun h => LinearMap.ext fun x => ?_, fun h y hy => ?_⟩⟩
  · rw [LinearMap.smul_apply, ← map_smul, LinearMap.zero_apply]
    exact h _ ((mem_pI_pow_smul_top t _).mpr ⟨z, rfl⟩)
  · obtain ⟨z, rfl⟩ := (mem_pI_pow_smul_top t y).mp hy
    rw [map_smul, ← LinearMap.smul_apply, h, LinearMap.zero_apply]
  · apply φ.injective
    apply Subtype.ext
    rw [hφ a x, LinearMap.zero_apply, map_zero, ZeroMemClass.coe_zero]
    exact h _ (φ x).2
  · obtain ⟨x, hx⟩ := φ.surjective ⟨y, hy⟩
    have hy' : y = (φ x : _) := by rw [hx]
    rw [hy', ← hφ a x, h, LinearMap.zero_apply, map_zero, ZeroMemClass.coe_zero]

/-- `endQ (ℓ^K) a` maps `ℓ^t N` into itself (`N = 𝕃/ℓ^K`). -/
lemma endQ_maps_pow (t K : ℕ) (a : Module.End ℤ_[p] L) :
    ∀ y ∈ (pI p ^ t) • (⊤ : Submodule ℤ_[p] (L ⧸ (pI p ^ K) • (⊤ : Submodule ℤ_[p] L))),
      endQ (pI p ^ K) a y ∈ (pI p ^ t) • (⊤ : Submodule ℤ_[p] (L ⧸ (pI p ^ K) • (⊤ : Submodule ℤ_[p] L))) := by
  intro y hy
  obtain ⟨z, rfl⟩ := (mem_pI_pow_smul_top t y).mp hy
  exact (mem_pI_pow_smul_top t _).mpr ⟨endQ (pI p ^ K) a z, map_smul _ _ _⟩

/-- **`lem:freepart`(2), the module identification** (L18-4; F3 finding 11, L17-1 audit MINOR-3): conjugation by the
equivariant `𝕃'/ℓ^{K-t} ≅ ℓ^t N` of `freepart_iso` is an algebra isomorphism `End(ℓ^t N) ≅ End(𝕃'/ℓ^{K-t})` carrying the
restriction of every `a` to `ℓ^t N` to the action of `ā` on `𝕃'/ℓ^{K-t}`. So the image of `T^coh` in `End(ℓ^t N)`, which is
`𝖠_K/𝖠_K[ℓ^t]` (its kernel is `freepart_image`'s), is isomorphic to `𝖠'_{K-t}`, the image of `T^𝕃 = onFree(T^coh)`
(`cohforms_restrict`). -/
theorem freepart_image_equiv (t K : ℕ) (htK : t < K)
    (ht : ∀ x ∈ Submodule.torsion ℤ_[p] L, ((p : ℤ_[p]) ^ t) • x = 0) :
    ∃ e : Module.End ℤ_[p] ↥((pI p ^ t) • (⊤ : Submodule ℤ_[p] (L ⧸ (pI p ^ K) • (⊤ : Submodule ℤ_[p] L)))) ≃ₐ[ℤ_[p]]
        Module.End ℤ_[p] (Lfree (p := p) L ⧸ (pI p ^ (K - t)) • (⊤ : Submodule ℤ_[p] (Lfree (p := p) L))),
      ∀ a : Module.End ℤ_[p] L,
        e ((endQ (pI p ^ K) a).restrict (endQ_maps_pow t K a)) = endQ (pI p ^ (K - t)) (onFree a) := by
  obtain ⟨φ, hφ⟩ := freepart_exists t K htK.le ht
  refine ⟨φ.symm.conjAlgEquiv ℤ_[p], fun a => LinearMap.ext fun x => ?_⟩
  rw [LinearEquiv.conjAlgEquiv_apply, LinearMap.comp_apply, LinearMap.comp_apply, LinearEquiv.symm_symm,
    LinearEquiv.coe_coe, LinearEquiv.coe_coe, LinearEquiv.symm_apply_eq]
  apply Subtype.ext
  rw [LinearMap.restrict_apply, hφ a x]

/-- **`lem:freepart`(3)**: on a pure torsion block (`𝕃' = 0`) with `ℓ^t 𝕃_tors = 0` and `K ≥ t`: `N = 𝕃` and
`𝖠_K = T^coh` (the action on `𝕃/ℓ^K` is faithful). -/
theorem freepart_torsion (t K : ℕ) (htK : t ≤ K) (hpure : Submodule.torsion ℤ_[p] L = ⊤)
    (ht : ∀ x ∈ Submodule.torsion ℤ_[p] L, ((p : ℤ_[p]) ^ t) • x = 0) :
    (pI p ^ K) • (⊤ : Submodule ℤ_[p] L) = ⊥ ∧
      ∀ a ∈ Tcoh X, endQ (pI p ^ K) a = 0 → a = 0 := by
  have hbot : (pI p ^ K) • (⊤ : Submodule ℤ_[p] L) = ⊥ := by
    rw [eq_bot_iff]
    intro y hy
    obtain ⟨z, rfl⟩ := (mem_pI_pow_smul_top K y).mp hy
    have hz : ((p : ℤ_[p]) ^ t) • z = 0 := ht z (hpure ▸ Submodule.mem_top)
    rw [Submodule.mem_bot, ← Nat.sub_add_cancel htK, pow_add, mul_smul, hz, smul_zero]
  refine ⟨hbot, fun a _ ha => LinearMap.ext fun v => ?_⟩
  have h := LinearMap.congr_fun ha (Submodule.Quotient.mk v)
  change Submodule.Quotient.mk (a v) = 0 at h
  rw [Submodule.Quotient.mk_eq_zero, hbot, Submodule.mem_bot] at h
  exact h

/-! ### `cor:stablecert` -/

/-- **`cor:stablecert`(1)**: in the abstract form of `GL2.Sat` (`Basic`): `Te` is `e T^𝕃` acting faithfully on
`Le = e 𝕃'` of rank `f`, with `rank Te = ⌈f/2⌉` (`heckerankone`), and `T'` is `T'_{𝔪'}`, embedded in `Te` by `ι`.  If
`dim 𝖠'_K/ℓ = ⌈f/2⌉` at some `K`, then `rank T' = rank Te` and `T'/ℓ → 𝖠'_{K'}/ℓ` is an isomorphism at this and every
larger `K'`; such a `K` exists iff `rank T' = rank Te`, and then one exists with `K ≤ c^sat(T') + 1`. -/
theorem stablecert {Le : Type*} [AddCommGroup Le] [Module ℤ_[p] Le] [Module.Free ℤ_[p] Le] [Module.Finite ℤ_[p] Le]
    {Te : Type*} [CommRing Te] [Algebra ℤ_[p] Te] (act : Te →ₐ[ℤ_[p]] Module.End ℤ_[p] Le)
    (hact : Function.Injective act)
    (hrank : rk (p := p) (T := Te) = (Module.finrank ℤ_[p] Le + 1) / 2)
    {T' : Type*} [CommRing T'] [Algebra ℤ_[p] T'] (ι' : T' →ₐ[ℤ_[p]] Te) (hι : Function.Injective ι') :
    (∀ K, 1 ≤ K → Module.length ℤ_[p] (AK (act.comp ι') K ⧸ pI p • (⊤ : Submodule ℤ_[p] (AK (act.comp ι') K))) =
        ((Module.finrank ℤ_[p] Le + 1) / 2 : ℕ) →
      rk (p := p) (T := T') = rk (p := p) (T := Te) ∧
        ∀ K', K ≤ K' → Function.Injective (redMap (act.comp ι') K')) ∧
    ((∃ K, 1 ≤ K ∧ Module.length ℤ_[p] (AK (act.comp ι') K ⧸ pI p • (⊤ : Submodule ℤ_[p] (AK (act.comp ι') K))) =
        ((Module.finrank ℤ_[p] Le + 1) / 2 : ℕ)) ↔ rk (p := p) (T := T') = rk (p := p) (T := Te)) ∧
    (rk (p := p) (T := T') = rk (p := p) (T := Te) → ∃ K, 1 ≤ K ∧ K ≤ cSat (act.comp ι') + 1 ∧
      Module.length ℤ_[p] (AK (act.comp ι') K ⧸ pI p • (⊤ : Submodule ℤ_[p] (AK (act.comp ι') K))) =
        ((Module.finrank ℤ_[p] Le + 1) / 2 : ℕ)) := by
  have hinj : Function.Injective (act.comp ι') := hact.comp hι
  have := finite_T act hact
  have := free_T act hact
  have := finite_T (act.comp ι') hinj
  have := free_T (act.comp ι') hinj
  have hle : rk (p := p) (T := T') ≤ rk (p := p) (T := Te) :=
    LinearMap.finrank_le_finrank_of_injective (f := ι'.toLinearMap) hι
  have part1 : ∀ K, 1 ≤ K →
      Module.length ℤ_[p] (AK (act.comp ι') K ⧸ pI p • (⊤ : Submodule ℤ_[p] (AK (act.comp ι') K))) =
        ((Module.finrank ℤ_[p] Le + 1) / 2 : ℕ) →
      rk (p := p) (T := T') = rk (p := p) (T := Te) ∧
        ∀ K', K ≤ K' → Function.Injective (redMap (act.comp ι') K') := by
    intro K hK hlen
    have sr := stopping_rule (act.comp ι') hinj K hK
    have h1 := sr.1
    rw [hlen] at h1
    have hrk : rk (p := p) (T := T') = rk (p := p) (T := Te) :=
      le_antisymm hle (by rw [hrank]; exact_mod_cast h1)
    refine ⟨hrk, fun K' hKK' => ?_⟩
    have hker : kerK (act.comp ι') K ≤ pI p • (⊤ : Submodule ℤ_[p] T') :=
      (sr.2.out 0 2).mp (by rw [hlen, ← hrank, hrk])
    have hker' := (stopping_rule_mono (act.comp ι') hinj).1 K K' hKK' hker
    exact ((stopping_rule (act.comp ι') hinj K' (hK.trans hKK')).2.out 1 2).mpr hker'
  have hex : rk (p := p) (T := T') = rk (p := p) (T := Te) →
      Module.length ℤ_[p] (AK (act.comp ι') (cSat (act.comp ι') + 1) ⧸
        pI p • (⊤ : Submodule ℤ_[p] (AK (act.comp ι') (cSat (act.comp ι') + 1)))) =
        ((Module.finrank ℤ_[p] Le + 1) / 2 : ℕ) := fun hrk => by
    have hker := (stopping_rule_mono (act.comp ι') hinj).2 (cSat (act.comp ι') + 1) le_rfl
    have h0 := ((stopping_rule (act.comp ι') hinj (cSat (act.comp ι') + 1) (Nat.le_add_left 1 _)).2.out 0 2).mpr
      hker
    rw [h0, hrk, hrank]
  exact ⟨part1, ⟨fun ⟨K, hK, hlen⟩ => (part1 K hK hlen).1,
    fun hrk => ⟨_, Nat.le_add_left 1 _, hex hrk⟩⟩,
    fun hrk => ⟨_, Nat.le_add_left 1 _, le_rfl, hex hrk⟩⟩

/-- **`cor:stablecert`(2)**, the generation certificate (Nakayama): `T'_{𝔪'} = e T^𝕃` iff `T' + ℓ Te = Te`, i.e. iff
the images of the `T_p`, `p ∈ S`, generate `e T^𝕃 / ℓ`. -/
theorem stablecert_generation {Te : Type*} [CommRing Te] [Algebra ℤ_[p] Te] [Module.Finite ℤ_[p] Te]
    {T' : Type*} [CommRing T'] [Algebra ℤ_[p] T'] (ι' : T' →ₐ[ℤ_[p]] Te) :
    Function.Surjective ι' ↔
      LinearMap.range ι'.toLinearMap ⊔ pI p • (⊤ : Submodule ℤ_[p] Te) = ⊤ := by
  constructor
  · intro h
    rw [LinearMap.range_eq_top.mpr (show Function.Surjective ι'.toLinearMap from h), top_sup_eq]
  · intro h
    have hj : pI p ≤ Ideal.jacobson ⊥ := by
      rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top, PadicInt.maximalIdeal_eq_span_p]
    have hle := Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top hj (le_of_eq h.symm)
    exact LinearMap.range_eq_top.mp (eq_top_iff.mpr hle)

/-! ### `prop:cohforms` -/

/-- `onFree` as an algebra map `End(𝕃) → End(𝕃')`. -/
noncomputable def onFreeAlg : Module.End ℤ_[p] L →ₐ[ℤ_[p]] Module.End ℤ_[p] (Lfree (p := p) L) :=
  AlgHom.ofLinearMap
    { toFun := onFree
      map_add' := fun _ _ => Submodule.linearMap_qext _ (LinearMap.ext fun _ => rfl)
      map_smul' := fun _ _ => Submodule.linearMap_qext _ (LinearMap.ext fun _ => rfl) }
    (Submodule.linearMap_qext _ (LinearMap.ext fun _ => rfl))
    (fun _ _ => Submodule.linearMap_qext _ (LinearMap.ext fun _ => rfl))

/-- **`prop:cohforms`(1)**, the algebraic half: `0 → 𝕃_tors/ℓ → 𝕃/ℓ → 𝕃'/ℓ → 0` is exact, and
`length(𝕃_tors/ℓ) = length(𝕃[ℓ])`. (That `𝕃/ℓ = H¹(Γ; M_n)` Hecke-equivariantly is `cl:bockstein`, not stated here.) -/
theorem cohforms_ses :
    let i := mapQ (pI p • (⊤ : Submodule ℤ_[p] (Submodule.torsion ℤ_[p] L))) (pI p • (⊤ : Submodule ℤ_[p] L))
      (Submodule.torsion ℤ_[p] L).subtype
      (map_le_iff_le_comap.mp (by rw [map_smul'']; exact smul_mono_right _ le_top))
    let q := mapQ (pI p • (⊤ : Submodule ℤ_[p] L)) (pI p • (⊤ : Submodule ℤ_[p] (Lfree (p := p) L)))
      (Submodule.torsion ℤ_[p] L).mkQ
      (map_le_iff_le_comap.mp (by rw [map_smul'']; exact smul_mono_right _ le_top))
    Function.Injective i ∧ Function.Exact i q ∧ Function.Surjective q ∧
      Module.length ℤ_[p] ((Submodule.torsion ℤ_[p] L) ⧸
          pI p • (⊤ : Submodule ℤ_[p] (Submodule.torsion ℤ_[p] L))) =
        Module.length ℤ_[p] (Submodule.torsionBy ℤ_[p] L (p : ℤ_[p])) := by
  intro i q
  obtain ⟨k, hk⟩ := torsion_killed (p := p) (L := L)
  refine ⟨(injective_iff_map_eq_zero i).mpr fun x hx => ?_, fun y => ?_, fun z => ?_, ?_⟩
  · induction x using Submodule.Quotient.induction_on with
    | H x =>
    change Submodule.Quotient.mk (x : L) = 0 at hx
    rw [Submodule.Quotient.mk_eq_zero, mem_pI_smul_top] at hx
    obtain ⟨y, hy⟩ := hx
    have hyT : y ∈ Submodule.torsion ℤ_[p] L :=
      mem_torsion_of_pow_smul (k + 1) (by rw [pow_succ, mul_smul, ← hy, hk x.1 x.2])
    rw [Submodule.Quotient.mk_eq_zero, mem_pI_smul_top]
    exact ⟨⟨y, hyT⟩, Subtype.ext hy⟩
  · induction y using Submodule.Quotient.induction_on with
    | H v =>
    constructor
    · intro hv
      change Submodule.Quotient.mk (Submodule.Quotient.mk v : Lfree (p := p) L) = 0 at hv
      rw [Submodule.Quotient.mk_eq_zero, mem_pI_smul_top] at hv
      obtain ⟨z, hz⟩ := hv
      induction z using Submodule.Quotient.induction_on with
      | H w =>
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.eq] at hz
      refine ⟨Submodule.Quotient.mk ⟨_, hz⟩, ?_⟩
      change Submodule.Quotient.mk (v - (p : ℤ_[p]) • w) = Submodule.Quotient.mk v
      rw [Submodule.Quotient.eq, sub_sub_cancel_left]
      exact Submodule.neg_mem _ ((mem_pI_smul_top _).mpr ⟨w, rfl⟩)
    · rintro ⟨x', hx'⟩
      rw [← hx']
      induction x' using Submodule.Quotient.induction_on with
      | H x =>
      change Submodule.Quotient.mk (Submodule.Quotient.mk (x : L) : Lfree (p := p) L) = 0
      rw [(Submodule.Quotient.mk_eq_zero _).mpr x.2, Submodule.Quotient.mk_zero]
  · induction z using Submodule.Quotient.induction_on with
    | H y =>
    induction y using Submodule.Quotient.induction_on with
    | H v => exact ⟨Submodule.Quotient.mk v, rfl⟩
  · have hfin := length_ne_top_of_killed (p := p) (M := Submodule.torsion ℤ_[p] L) k
      (fun x => Subtype.ext (hk x.1 x.2))
    have e1 := pI_pow_smul_top (p := p) (M := Submodule.torsion ℤ_[p] L) 1
    rw [pow_one, pow_one] at e1
    rw [e1, ← length_torsionBy_eq _ hfin]
    let e : Submodule.torsionBy ℤ_[p] (Submodule.torsion ℤ_[p] L) (p : ℤ_[p]) →ₗ[ℤ_[p]]
        Submodule.torsionBy ℤ_[p] L (p : ℤ_[p]) :=
      ((Submodule.torsion ℤ_[p] L).subtype ∘ₗ
        (Submodule.torsionBy ℤ_[p] (Submodule.torsion ℤ_[p] L) (p : ℤ_[p])).subtype).codRestrict _
        (fun x => (Submodule.mem_torsionBy_iff _ _).mpr
          (congrArg Subtype.val ((Submodule.mem_torsionBy_iff _ _).mp x.2)))
    have hbij : Function.Bijective e := by
      refine ⟨fun a b h => ?_, fun y => ?_⟩
      · have h' := congrArg Subtype.val h
        exact Subtype.ext (Subtype.ext h')
      have hy : (p : ℤ_[p]) • (y : L) = 0 := (Submodule.mem_torsionBy_iff _ _).mp y.2
      have hyT : (y : L) ∈ Submodule.torsion ℤ_[p] L := mem_torsion_of_pow_smul 1 (by rw [pow_one]; exact hy)
      exact ⟨⟨⟨y, hyT⟩, (Submodule.mem_torsionBy_iff _ _).mpr (Subtype.ext hy)⟩, rfl⟩
    exact (LinearEquiv.ofBijective e hbij).length_eq

/-- **`prop:cohforms`(2)**: restriction `T^coh → T^𝕃` is onto, with kernel the operators mapping `𝕃` into `𝕃_tors`. -/
theorem cohforms_restrict :
    (TL X : Set (Module.End ℤ_[p] (Lfree (p := p) L))) = onFree '' (Tcoh X : Set (Module.End ℤ_[p] L)) ∧
      ∀ a : Module.End ℤ_[p] L, onFree a = 0 ↔ ∀ v, a v ∈ Submodule.torsion ℤ_[p] L := by
  refine ⟨?_, fun a => ⟨fun h v => ?_, fun h => ?_⟩⟩
  · have h : TL X = (Tcoh X).map (onFreeAlg (p := p) (L := L)) := by
      rw [TL, Tcoh, AlgHom.map_adjoin, ← Set.range_comp]
      rfl
    rw [h, Subalgebra.coe_map]
    rfl
  · have hv := LinearMap.congr_fun h (Submodule.Quotient.mk v)
    change Submodule.Quotient.mk (a v) = 0 at hv
    exact (Submodule.Quotient.mk_eq_zero _).mp hv
  · refine Submodule.linearMap_qext _ (LinearMap.ext fun v => ?_)
    change Submodule.Quotient.mk (a v) = 0
    exact (Submodule.Quotient.mk_eq_zero _).mpr (h v)

/-! ### Systems of eigenvalues (L18-4)

For a family `Y : ι → End N` and an `ℤ_ℓ`-algebra `E` that is a field, every element of the algebra generated by the `Y i`
acts on each joint eigenspace `jointEigen Y E χ ⊆ E ⊗ N` by a scalar; on a set `Sys` of systems with nonzero eigenspaces
spanning `E ⊗ N`, this gives an `ℤ_ℓ`-algebra map `adjoin(Y) → (Sys → E)`, injective when `a ↦ a ⊗ E` is. -/

section Systems

open GL2.Literature

variable {N : Type*} [AddCommGroup N] [Module ℤ_[p] N] {κ : Type*} (Y : κ → Module.End ℤ_[p] N)
  (E : Type*) [Field E] [Algebra ℤ_[p] E]

lemma mem_jointEigen_iff {χ : κ → E} {v : E ⊗[ℤ_[p]] N} :
    v ∈ jointEigen Y E χ ↔ ∀ i, (Y i).baseChange E v = χ i • v := by
  simp only [jointEigen, Submodule.mem_iInf, LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.smul_apply,
    LinearMap.id_apply, sub_eq_zero]

/-- Every element of `adjoin(Y)` acts by a scalar on each joint eigenspace. -/
lemma scalar_on_jointEigen (χ : κ → E) {a : Module.End ℤ_[p] N} (ha : a ∈ Algebra.adjoin ℤ_[p] (Set.range Y)) :
    ∃ c : E, ∀ v ∈ jointEigen Y E χ, a.baseChange E v = c • v := by
  induction ha using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact ⟨χ i, fun v hv => (mem_jointEigen_iff Y E).1 hv i⟩
  | algebraMap r =>
    refine ⟨algebraMap ℤ_[p] E r, fun v _ => ?_⟩
    rw [Module.algebraMap_end_eq_smul_id, LinearMap.baseChange_smul, LinearMap.baseChange_id,
      LinearMap.smul_apply, LinearMap.id_apply, algebraMap_smul]
  | add x y _ _ hx hy =>
    obtain ⟨c, hc⟩ := hx
    obtain ⟨d, hd⟩ := hy
    exact ⟨c + d, fun v hv => by rw [LinearMap.baseChange_add, LinearMap.add_apply, hc v hv, hd v hv, add_smul]⟩
  | mul x y _ _ hx hy =>
    obtain ⟨c, hc⟩ := hx
    obtain ⟨d, hd⟩ := hy
    refine ⟨c * d, fun v hv => ?_⟩
    rw [LinearMap.baseChange_mul, Module.End.mul_apply, hd v hv, LinearMap.map_smul,
      hc v hv, smul_smul, mul_comm]

variable {E} in
/-- The scalar by which `a ∈ adjoin(Y)` acts on a nonzero joint eigenspace. -/
noncomputable def eigval (χ : κ → E) (a : Algebra.adjoin ℤ_[p] (Set.range Y)) : E :=
  Classical.choose (scalar_on_jointEigen Y E χ a.2)

variable {E} in
lemma eigval_spec (χ : κ → E) (a : Algebra.adjoin ℤ_[p] (Set.range Y)) :
    ∀ v ∈ jointEigen Y E χ, (a : Module.End ℤ_[p] N).baseChange E v = eigval Y χ a • v :=
  Classical.choose_spec (scalar_on_jointEigen Y E χ a.2)

variable {E} in
lemma eigval_unique {χ : κ → E} (hχ : jointEigen Y E χ ≠ ⊥) (a : Algebra.adjoin ℤ_[p] (Set.range Y)) (c : E)
    (hc : ∀ v ∈ jointEigen Y E χ, (a : Module.End ℤ_[p] N).baseChange E v = c • v) : eigval Y χ a = c := by
  obtain ⟨v, hv, hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hχ
  have h := (eigval_spec Y χ a v hv).symm.trans (hc v hv)
  exact smul_left_injective E hv0 h

variable {E} in
/-- `adjoin(Y) → (Sys → E)`, `a ↦ (χ ↦ the scalar of a on jointEigen Y E χ)`. -/
noncomputable def sysHom (Sys : Set (κ → E)) (hSys : ∀ χ ∈ Sys, jointEigen Y E χ ≠ ⊥) :
    Algebra.adjoin ℤ_[p] (Set.range Y) →ₐ[ℤ_[p]] (Sys → E) where
  toFun a χ := eigval Y χ.1 a
  map_one' := funext fun χ => eigval_unique Y (hSys χ.1 χ.2) 1 1 fun v _ => by
    rw [OneMemClass.coe_one, LinearMap.baseChange_one, one_smul]; rfl
  map_mul' a b := funext fun χ => eigval_unique Y (hSys χ.1 χ.2) (a * b) _ fun v hv => by
    rw [MulMemClass.coe_mul, LinearMap.baseChange_mul, Module.End.mul_apply, eigval_spec Y χ.1 b v hv,
      LinearMap.map_smul, eigval_spec Y χ.1 a v hv, smul_smul, mul_comm, Pi.mul_apply]
  map_zero' := funext fun χ => eigval_unique Y (hSys χ.1 χ.2) 0 0 fun v _ => by
    rw [ZeroMemClass.coe_zero, LinearMap.baseChange_zero, zero_smul]; rfl
  map_add' a b := funext fun χ => eigval_unique Y (hSys χ.1 χ.2) (a + b) _ fun v hv => by
    rw [AddMemClass.coe_add, LinearMap.baseChange_add, LinearMap.add_apply, eigval_spec Y χ.1 a v hv,
      eigval_spec Y χ.1 b v hv, Pi.add_apply, add_smul]
  commutes' r := funext fun χ => eigval_unique Y (hSys χ.1 χ.2) (algebraMap ℤ_[p] _ r) _ fun v _ => by
    rw [Subalgebra.coe_algebraMap, Module.algebraMap_end_eq_smul_id, LinearMap.baseChange_smul,
      LinearMap.baseChange_id, LinearMap.smul_apply, LinearMap.id_apply, Pi.algebraMap_apply, algebraMap_smul]

lemma sysHom_gen (Sys : Set (κ → E)) (hSys : ∀ χ ∈ Sys, jointEigen Y E χ ≠ ⊥) (i : κ) :
    sysHom Y Sys hSys ⟨Y i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ = fun χ => χ.1 i :=
  funext fun χ => eigval_unique Y (hSys χ.1 χ.2) _ _ fun v hv => (mem_jointEigen_iff Y E).1 hv i

/-- `a ↦ a ⊗ E` is injective on `End N` when `N` is flat and `ℤ_ℓ → E` is injective. -/
lemma baseChange_eq_zero [Module.Flat ℤ_[p] N] (hE : Function.Injective (algebraMap ℤ_[p] E))
    {a : Module.End ℤ_[p] N} (h : a.baseChange E = 0) : a = 0 := by
  ext m
  have hinj := Module.Flat.rTensor_preserves_injective_linearMap (M := N) (Algebra.linearMap ℤ_[p] E) hE
  have h1 : (Algebra.linearMap ℤ_[p] E).rTensor N ((1 : ℤ_[p]) ⊗ₜ[ℤ_[p]] a m) = 0 := by
    rw [LinearMap.rTensor_tmul, Algebra.linearMap_apply, map_one, ← LinearMap.baseChange_tmul, h,
      LinearMap.zero_apply]
  have h2 : (1 : ℤ_[p]) ⊗ₜ[ℤ_[p]] a m = 0 := hinj (h1.trans (map_zero _).symm)
  have h3 := congrArg (TensorProduct.lid ℤ_[p] N) h2
  rwa [TensorProduct.lid_tmul, one_smul, map_zero] at h3

lemma sysHom_injective [Module.Flat ℤ_[p] N] (hE : Function.Injective (algebraMap ℤ_[p] E))
    (Sys : Set (κ → E)) (hSys : ∀ χ ∈ Sys, jointEigen Y E χ ≠ ⊥)
    (hspan : (⨆ χ ∈ Sys, jointEigen Y E χ) = ⊤) : Function.Injective (sysHom Y Sys hSys) := by
  rw [injective_iff_map_eq_zero]
  intro a ha
  have hker : (⨆ χ ∈ Sys, jointEigen Y E χ) ≤ LinearMap.ker ((a : Module.End ℤ_[p] N).baseChange E) := by
    refine iSup₂_le fun χ hχ v hv => ?_
    rw [LinearMap.mem_ker, eigval_spec Y χ a v hv]
    have := congrFun ha ⟨χ, hχ⟩
    change eigval Y χ a = 0 at this
    rw [this, zero_smul]
  rw [hspan, top_le_iff, LinearMap.ker_eq_top] at hker
  exact Subtype.ext (baseChange_eq_zero E hE hker)

lemma sysHom_range (Sys : Set (κ → E)) (hSys : ∀ χ ∈ Sys, jointEigen Y E χ ≠ ⊥) :
    (sysHom Y Sys hSys).range = Algebra.adjoin ℤ_[p] (Set.range fun i (χ : Sys) => χ.1 i) := by
  apply le_antisymm
  · have key : ∀ b : Algebra.adjoin ℤ_[p] (Set.range Y),
        sysHom Y Sys hSys b ∈ Algebra.adjoin ℤ_[p] (Set.range fun i (χ : Sys) => χ.1 i) := by
      rintro ⟨a, ha⟩
      induction ha using Algebra.adjoin_induction with
      | mem x hx =>
        obtain ⟨i, rfl⟩ := hx
        rw [sysHom_gen]; exact Algebra.subset_adjoin ⟨i, rfl⟩
      | algebraMap r =>
        have : (⟨algebraMap ℤ_[p] _ r, Subalgebra.algebraMap_mem _ r⟩ : Algebra.adjoin ℤ_[p] (Set.range Y)) =
            algebraMap ℤ_[p] _ r := rfl
        rw [this, AlgHom.commutes]; exact Subalgebra.algebraMap_mem _ r
      | add x y hx hy ihx ihy =>
        have : (⟨x + y, Subalgebra.add_mem _ hx hy⟩ : Algebra.adjoin ℤ_[p] (Set.range Y)) = ⟨x, hx⟩ + ⟨y, hy⟩ := rfl
        rw [this, map_add]; exact Subalgebra.add_mem _ ihx ihy
      | mul x y hx hy ihx ihy =>
        have : (⟨x * y, Subalgebra.mul_mem _ hx hy⟩ : Algebra.adjoin ℤ_[p] (Set.range Y)) = ⟨x, hx⟩ * ⟨y, hy⟩ := rfl
        rw [this, map_mul]; exact Subalgebra.mul_mem _ ihx ihy
    rintro _ ⟨b, rfl⟩
    exact key b
  · rw [Algebra.adjoin_le_iff]
    rintro _ ⟨i, rfl⟩
    exact ⟨_, sysHom_gen Y E Sys hSys i⟩

end Systems

/-- `ℤ_ℓ → E` is injective when `E ⊇ ℚ_ℓ`. -/
lemma algebraMap_injective_of_tower (E : Type*) [Field E] [Algebra ℤ_[p] E] [Algebra ℚ_[p] E]
    [IsScalarTower ℤ_[p] ℚ_[p] E] : Function.Injective (algebraMap ℤ_[p] E) := by
  rw [IsScalarTower.algebraMap_eq ℤ_[p] ℚ_[p] E, RingHom.coe_comp]
  exact (algebraMap ℚ_[p] E).injective.comp (fun a b h => PadicInt.ext h)

/-! ### `lem:heckerankone` (L18-4)

Base change of ranks, the joint eigenspaces' independence, and the rank count. -/

section HeckeRankOne

open GL2.Literature

section HeckeRankA



variable (E : Type*) [Field E] [Algebra ℤ_[p] E] [Algebra ℚ_[p] E] [IsScalarTower ℤ_[p] ℚ_[p] E]

lemma flat_of_tower : Module.Flat ℤ_[p] E := Module.Flat.trans ℤ_[p] ℚ_[p] E

/-- The rank of a submodule of a free finite `ℤ_ℓ`-module is the `E`-dimension of the `E`-span of its `1 ⊗ x`. -/
lemma finrank_span_tmul {P : Type*} [AddCommGroup P] [Module ℤ_[p] P] [Module.Free ℤ_[p] P] [Module.Finite ℤ_[p] P]
    (N : Submodule ℤ_[p] P) :
    Module.finrank E (Submodule.span E ((fun x => (1 : E) ⊗ₜ[ℤ_[p]] x) '' (N : Set P))) =
      Module.finrank ℤ_[p] N := by
  have := flat_of_tower (p := p) E
  have : Module.Free ℤ_[p] N := Module.free_of_finite_type_torsion_free'
  let f : E ⊗[ℤ_[p]] N →ₗ[E] E ⊗[ℤ_[p]] P := N.subtype.baseChange E
  have hinj : Function.Injective f := by
    have := Module.Flat.lTensor_preserves_injective_linearMap (M := E) N.subtype N.injective_subtype
    simpa [f, LinearMap.baseChange_eq_ltensor] using this
  have hrange : LinearMap.range f = Submodule.span E ((fun x => (1 : E) ⊗ₜ[ℤ_[p]] x) '' (N : Set P)) := by
    apply le_antisymm
    · rintro _ ⟨z, rfl⟩
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul x n =>
        have : f (x ⊗ₜ n) = x • ((1 : E) ⊗ₜ[ℤ_[p]] (n : P)) := by
          simp [f, TensorProduct.smul_tmul']
        rw [this]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨n, n.2, rfl⟩)
      | add a b ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb
    · rw [Submodule.span_le]
      rintro _ ⟨x, hx, rfl⟩
      exact ⟨(1 : E) ⊗ₜ ⟨x, hx⟩, by simp [f]⟩
  rw [← hrange, LinearMap.finrank_range_of_inj hinj, Module.finrank_baseChange]


end HeckeRankA

section HeckeRankB


variable (E : Type*) [Field E] [Algebra ℤ_[p] E]

variable {M : Type*} [AddCommGroup M] [Module ℤ_[p] M]

/-- `E ⊗ End(M) → End_E(E ⊗ M)`, `x ⊗ a ↦ x · (a ⊗ E)`. -/
def bcEnd : E ⊗[ℤ_[p]] Module.End ℤ_[p] M →ₗ[E] Module.End E (E ⊗[ℤ_[p]] M) :=
  (LinearMap.baseChangeHom ℤ_[p] E M M).liftBaseChange E

lemma bcEnd_tmul (x : E) (a : Module.End ℤ_[p] M) : bcEnd E (x ⊗ₜ a) = x • a.baseChange E := rfl

/-- `bcEnd` is injective for `M` free and finite. -/
lemma bcEnd_injective [Module.Free ℤ_[p] M] [Module.Finite ℤ_[p] M] : Function.Injective (bcEnd (p := p) E (M := M)) := by
  let res : Module.End E (E ⊗[ℤ_[p]] M) →ₗ[ℤ_[p]] (M →ₗ[ℤ_[p]] E ⊗[ℤ_[p]] M) :=
    { toFun := fun w => (w.restrictScalars ℤ_[p]).comp (TensorProduct.mk ℤ_[p] E M 1)
      map_add' := fun _ _ => rfl
      map_smul' := fun c w => by ext m; simp }
  have hcomp : ∀ z, res (bcEnd E z) = lTensorHomEquivHomLTensor ℤ_[p] M E M z := by
    intro z
    rw [← LinearEquiv.coe_toLinearMap, lTensorHomEquivHomLTensor_toLinearMap]
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul x a =>
      ext m
      show (x • a.baseChange E) ((1 : E) ⊗ₜ m) = x ⊗ₜ a m
      rw [LinearMap.smul_apply, LinearMap.baseChange_tmul, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    | add a b ha hb => rw [map_add, map_add, ha, hb, map_add]
  intro z z' h
  apply (lTensorHomEquivHomLTensor ℤ_[p] M E M).injective
  rw [← hcomp, ← hcomp, h]


end HeckeRankB

section HeckeRankC


variable (E : Type*) [Field E] [Algebra ℤ_[p] E]

lemma finrank_biSup_indep {V : Type*} [AddCommGroup V] [Module E V] [FiniteDimensional E V] {κ : Type*}
    [DecidableEq κ] (W : κ → Submodule E V) (hW : iSupIndep W) (T : Finset κ) :
    Module.finrank E ↥(⨆ χ ∈ T, W χ) = ∑ χ ∈ T, Module.finrank E (W χ) := by
  induction T using Finset.induction_on with
  | empty => simp
  | insert a T ha ih =>
    rw [Finset.sum_insert ha, ← ih, Finset.iSup_insert]
    have hd : Disjoint (W a) (⨆ χ ∈ T, W χ) := by
      simpa using hW.disjoint_biSup (y := (T : Set κ)) (by simpa using ha)
    have := Submodule.finrank_sup_add_finrank_inf_eq (W a) (⨆ χ ∈ T, W χ)
    rw [hd.eq_bot, finrank_bot, add_zero] at this
    exact this

variable {M : Type*} [AddCommGroup M] [Module ℤ_[p] M]

/-- The joint eigenspaces of a family whose joint eigenspaces for the systems in `S` span `E ⊗ M` are independent. -/
lemma jointEigen_indep {κ : Type*} (Y : κ → Module.End ℤ_[p] M) (S : Finset (κ → E))
    (htop : (⨆ χ ∈ S, jointEigen Y E χ) = ⊤) : iSupIndep fun χ => jointEigen Y E χ := by
  let F : κ → Module.End E (E ⊗[ℤ_[p]] M) := fun i => (Y i).baseChange E
  have hcomm : ∀ i j, Commute (F i) (F j) := by
    intro i j
    have hle : (⨆ χ ∈ S, jointEigen Y E χ) ≤ LinearMap.ker (F i * F j - F j * F i) := by
      refine iSup₂_le fun χ _ v hv => ?_
      have h := (mem_jointEigen_iff Y E).1 hv
      rw [LinearMap.mem_ker, LinearMap.sub_apply, Module.End.mul_apply, Module.End.mul_apply]
      change F i (F j v) - F j (F i v) = 0
      rw [show F j v = χ j • v from h j, show F i v = χ i • v from h i, LinearMap.map_smul, LinearMap.map_smul,
        show F i v = χ i • v from h i, show F j v = χ j • v from h j, smul_smul, smul_smul, mul_comm, sub_self]
    rw [htop, top_le_iff, LinearMap.ker_eq_top] at hle
    exact sub_eq_zero.mp hle
  have h1 := Module.End.independent_iInf_maxGenEigenspace_of_forall_mapsTo F (fun i j φ x hx => by
    rw [SetLike.mem_coe, Module.End.mem_maxGenEigenspace] at hx ⊢
    obtain ⟨k, hk⟩ := hx
    refine ⟨k, ?_⟩
    have hc1 : Commute (F i) (F j - φ • 1) := by
      refine LinearMap.ext fun y => ?_
      have := LinearMap.congr_fun (hcomm i j).eq y
      simp only [Module.End.mul_apply] at this
      simp only [Module.End.mul_apply, LinearMap.sub_apply, LinearMap.smul_apply, Module.End.one_apply, map_sub,
        LinearMap.map_smul, this]
    have hc : Commute (F i) ((F j - φ • 1) ^ k) := hc1.pow_right k
    rw [← Module.End.mul_apply, ← hc.eq, Module.End.mul_apply, hk, map_zero])
  refine h1.mono fun χ => iInf_mono fun i v hv => ?_
  rw [LinearMap.mem_ker] at hv
  rw [Module.End.mem_maxGenEigenspace]
  exact ⟨1, by rw [pow_one]; exact hv⟩


end HeckeRankC

/-- Every element of `ℚ_ℓ ⊗ A` is, up to a nonzero scalar of `ℤ_ℓ`, of the form `1 ⊗ a`. -/
lemma tensor_qp_clear {A : Type*} [AddCommMonoid A] [Module ℤ_[p] A] (x : ℚ_[p] ⊗[ℤ_[p]] A) :
    ∃ s : ℤ_[p], s ≠ 0 ∧ ∃ a : A, (algebraMap ℤ_[p] ℚ_[p] s) • x = (1 : ℚ_[p]) ⊗ₜ a := by
  have key : ∀ (c : ℤ_[p]) (a : A), (algebraMap ℤ_[p] ℚ_[p] c) • ((1 : ℚ_[p]) ⊗ₜ[ℤ_[p]] a) = (1 : ℚ_[p]) ⊗ₜ (c • a) := by
    intro c a
    rw [algebraMap_smul, TensorProduct.tmul_smul]
  induction x using TensorProduct.induction_on with
  | zero => exact ⟨1, one_ne_zero, 0, by simp⟩
  | tmul q t =>
    obtain ⟨⟨y, s⟩, hys⟩ := IsLocalization.surj (nonZeroDivisors ℤ_[p]) q
    refine ⟨s, nonZeroDivisors.ne_zero s.2, y • t, ?_⟩
    rw [← key, TensorProduct.smul_tmul', TensorProduct.smul_tmul', smul_eq_mul, smul_eq_mul, mul_one, mul_comm]
    exact congrArg (· ⊗ₜ[ℤ_[p]] t) hys
  | add x y hx hy =>
    obtain ⟨s1, hs1, a1, h1⟩ := hx
    obtain ⟨s2, hs2, a2, h2⟩ := hy
    refine ⟨s1 * s2, mul_ne_zero hs1 hs2, s2 • a1 + s1 • a2, ?_⟩
    have e1 : (algebraMap ℤ_[p] ℚ_[p] s1) • (algebraMap ℤ_[p] ℚ_[p] s2) • x =
        (algebraMap ℤ_[p] ℚ_[p] s2) • ((1 : ℚ_[p]) ⊗ₜ[ℤ_[p]] a1) := by rw [smul_comm, h1]
    rw [smul_add, map_mul, mul_smul, mul_smul, e1, h2, key, key, TensorProduct.tmul_add]

/-- **`lem:heckerankone`** (given Eichler–Shimura, `GL2.Literature.EichlerShimuraLevelOne`): for every idempotent
`e ∈ T^𝕃`, `rank_{ℤ_ℓ} e T^𝕃 = ⌈rank(e 𝕃')/2⌉`; and `T^𝕃 ⊗ ℚ_ℓ` is a product of fields (reduced).
`E ⊇ ℚ_ℓ` (characteristic `0`) is required: with `E` of characteristic `ℓ` the statement is false (F3 audit finding 1,
`L = ℤ_ℓ²`, `X = diag(0, ℓ)`, `E = F_ℓ`); [C]'s `E = \bar ℚ_ℓ`.

**Proof (L18-4).** `𝕃'` is free; the joint eigenspaces `V_χ ⊆ E ⊗ 𝕃'`, `χ ∈ S`, span and are independent
(`jointEigen_indep`), and every `a ∈ T^𝕃` acts on `V_χ` by a scalar, which gives the injective `ψ : T^𝕃 → E^S`
(`sysHom`). `e` acts by `0` or `1`; `S_e` := where it acts by `1`. (1) `rank e𝕃' = dim (e ⊗ E)(E ⊗ 𝕃') = Σ_{S_e} mult`
(`finrank_span_tmul`, `finrank_biSup_indep`). (2) `rank e T^𝕃 = dim_E span_E (e T^𝕃 ⊗ E) = |S_e|` (`bcEnd_injective`; the
scalars on `S_e` are an `E`-isomorphism onto `E^{S_e}`, onto by interpolation in the coordinates `χ ↦ χ(i)`).
(3) `mult ∈ {1, 2}`, at most one `1`: `⌈Σ_{S_e} mult / 2⌉ = |S_e|`. (4) `ℚ_ℓ ⊗ T^𝕃 → E^S` is injective (clear
denominators), so reduced. -/
theorem heckerankone (E : Type*) [Field E] [Algebra ℤ_[p] E]
    [Algebra ℚ_[p] E] [IsScalarTower ℤ_[p] ℚ_[p] E]
    (hES : GL2.Literature.EichlerShimuraLevelOne (Lfree (p := p) L) (fun i => onFree (X i)) E)
    (e : Module.End ℤ_[p] (Lfree (p := p) L)) (heT : e ∈ TL X) (he : e * e = e) :
    Module.finrank ℤ_[p] (Submodule.span ℤ_[p] ((fun t => e * t) '' (TL X : Set _))) =
        (Module.finrank ℤ_[p] (LinearMap.range e) + 1) / 2 ∧
      IsReduced (ℚ_[p] ⊗[ℤ_[p]] TL X) := by
  classical
  have : Module.Free ℤ_[p] (Lfree (p := p) L) := Module.free_of_finite_type_torsion_free'
  have hE := algebraMap_injective_of_tower (p := p) E
  set Y : ι → Module.End ℤ_[p] (Lfree (p := p) L) := fun i => onFree (X i) with hY
  obtain ⟨S, mult, hm, hm1, hdim, htop⟩ := hES.decomp
  have hne : ∀ χ ∈ (S : Set (ι → E)), jointEigen Y E χ ≠ ⊥ := by
    intro χ hχ hbot
    have := hdim χ hχ
    rw [hbot, finrank_bot] at this
    rcases hm χ hχ with h | h <;> omega
  have htop' : (⨆ χ ∈ (S : Set (ι → E)), jointEigen Y E χ) = ⊤ := by simpa using htop
  have hind := jointEigen_indep E Y S htop
  set ψ := sysHom Y (S : Set (ι → E)) hne with hψdef
  have hψinj := sysHom_injective Y E hE _ hne htop'
  let ê : TL X := ⟨e, heT⟩
  set ce : (ι → E) → E := fun χ => eigval Y χ ê with hce
  have hce_spec : ∀ χ, ∀ v ∈ jointEigen Y E χ, e.baseChange E v = ce χ • v := fun χ => eigval_spec Y χ ê
  have hψmul : ∀ (a b : TL X) (χ : ι → E) (hχ : χ ∈ S),
      eigval Y χ (a * b) = eigval Y χ a * eigval Y χ b := fun a b χ hχ =>
    congrFun (map_mul ψ a b) ⟨χ, hχ⟩
  have hce01 : ∀ χ ∈ S, ce χ = 0 ∨ ce χ = 1 := by
    intro χ hχ
    have h := hψmul ê ê χ hχ
    rw [show ê * ê = ê from Subtype.ext he] at h
    exact IsIdempotentElem.iff_eq_zero_or_one.mp h.symm
  set Se := S.filter (fun χ => ce χ = 1) with hSe
  -- (1) `rank (e 𝕃') = Σ_{χ ∈ S_e} mult χ`
  have hrange : LinearMap.range (e.baseChange E) = ⨆ χ ∈ Se, jointEigen Y E χ := by
    apply le_antisymm
    · rintro _ ⟨w, rfl⟩
      have hw : w ∈ (⨆ χ ∈ S, jointEigen Y E χ) := htop ▸ Submodule.mem_top
      have hle : (⨆ χ ∈ S, jointEigen Y E χ) ≤ (⨆ χ ∈ Se, jointEigen Y E χ).comap (e.baseChange E) := by
        refine iSup₂_le fun χ hχ v hv => ?_
        rw [Submodule.mem_comap, hce_spec χ v hv]
        rcases hce01 χ hχ with h | h
        · rw [h, zero_smul]; exact Submodule.zero_mem _
        · rw [h, one_smul]
          exact (le_iSup₂ (f := fun χ (_ : χ ∈ Se) => jointEigen Y E χ) χ (Finset.mem_filter.2 ⟨hχ, h⟩)) hv
      exact hle hw
    · refine iSup₂_le fun χ hχ v hv => ?_
      have h := (Finset.mem_filter.1 hχ).2
      exact ⟨v, by rw [hce_spec χ v hv, h, one_smul]⟩
  have hrank_range : Module.finrank ℤ_[p] (LinearMap.range e) = ∑ χ ∈ Se, mult χ := by
    rw [← finrank_span_tmul E (LinearMap.range e)]
    have hspan : Submodule.span E ((fun x => (1 : E) ⊗ₜ[ℤ_[p]] x) '' (LinearMap.range e : Set _)) =
        LinearMap.range (e.baseChange E) := by
      apply le_antisymm
      · rw [Submodule.span_le]
        rintro _ ⟨_, ⟨m, rfl⟩, rfl⟩
        exact ⟨(1 : E) ⊗ₜ m, by rw [LinearMap.baseChange_tmul]⟩
      · rintro _ ⟨z, rfl⟩
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul x m =>
          rw [LinearMap.baseChange_tmul]
          have : x ⊗ₜ[ℤ_[p]] e m = x • ((1 : E) ⊗ₜ[ℤ_[p]] e m) := by
            rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          rw [this]
          exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨e m, ⟨m, rfl⟩, rfl⟩)
        | add a b ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb
    rw [hspan, hrange, finrank_biSup_indep E _ hind Se]
    exact Finset.sum_congr rfl fun χ hχ => hdim χ (Finset.mem_filter.1 hχ).1
  -- (2) `rank (e T^𝕃) = |S_e|`
  set N := Submodule.span ℤ_[p] ((fun t => e * t) '' (TL X : Set (Module.End ℤ_[p] (Lfree (p := p) L))))
    with hN
  have hNA : ∀ x ∈ N, x ∈ TL X ∧ e * x = x := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨t, ht, rfl⟩ := hy
      exact ⟨Subalgebra.mul_mem _ heT ht, by rw [← mul_assoc, he]⟩
    | zero => exact ⟨Subalgebra.zero_mem _, mul_zero e⟩
    | add x y _ _ hx hy => exact ⟨Subalgebra.add_mem _ hx.1 hy.1, by rw [mul_add, hx.2, hy.2]⟩
    | smul c x _ hx => exact ⟨Subalgebra.smul_mem _ hx.1 c, by rw [mul_smul_comm, hx.2]⟩
  set W' : Submodule E (Module.End E (E ⊗[ℤ_[p]] Lfree (p := p) L)) :=
    Submodule.span E ((fun a => a.baseChange E) '' (N : Set (Module.End ℤ_[p] (Lfree (p := p) L)))) with hW'
  have hrankN : Module.finrank ℤ_[p] N = Module.finrank E W' := by
    rw [← finrank_span_tmul E N]
    have hfun : (bcEnd E ∘ fun x : Module.End ℤ_[p] (Lfree (p := p) L) => (1 : E) ⊗ₜ[ℤ_[p]] x) =
        fun a => a.baseChange E := funext fun a => by simp [bcEnd_tmul]
    have hmap : (Submodule.span E ((fun x => (1 : E) ⊗ₜ[ℤ_[p]] x) '' (N : Set _))).map (bcEnd E) = W' := by
      rw [Submodule.map_span, ← Set.image_comp, hfun]
    rw [← hmap]
    exact ((Submodule.equivMapOfInjective _ (bcEnd_injective E) _).finrank_eq)
  have hv : ∀ χ : Se, ∃ v ∈ jointEigen Y E χ.1, ∃ f : Module.Dual E (E ⊗[ℤ_[p]] Lfree (p := p) L), f v = 1 := by
    intro χ
    obtain ⟨v, hv, hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot (hne χ.1 (Finset.mem_filter.1 χ.2).1)
    obtain ⟨f, hf⟩ : ∃ f : Module.Dual E (E ⊗[ℤ_[p]] Lfree (p := p) L), f v ≠ 0 := by
      by_contra h
      push Not at h
      exact hv0 ((Module.forall_dual_apply_eq_zero_iff E v).1 h)
    exact ⟨v, hv, (f v)⁻¹ • f, by simp [hf]⟩
  choose v hvmem f hf using hv
  let Ev : Module.End E (E ⊗[ℤ_[p]] Lfree (p := p) L) →ₗ[E] (Se → E) :=
    { toFun := fun w χ => f χ (w (v χ))
      map_add' := fun _ _ => funext fun _ => by simp
      map_smul' := fun _ _ => funext fun _ => by simp }
  have hgood : ∀ w ∈ W', ∀ χ ∈ S, ∃ c : E, (∀ u ∈ jointEigen Y E χ, w u = c • u) ∧ (ce χ = 0 → c = 0) := by
    intro w hw
    induction hw using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨x, hx, rfl⟩ := hy
      intro χ hχ
      obtain ⟨hxA, hex⟩ := hNA x hx
      refine ⟨eigval Y χ ⟨x, hxA⟩, eigval_spec Y χ ⟨x, hxA⟩, fun h0 => ?_⟩
      have h := hψmul ê ⟨x, hxA⟩ χ hχ
      rw [show ê * ⟨x, hxA⟩ = ⟨x, hxA⟩ from Subtype.ext hex] at h
      change eigval Y χ ⟨x, hxA⟩ = ce χ * eigval Y χ ⟨x, hxA⟩ at h
      rw [h, h0, zero_mul]
    | zero => intro χ _; exact ⟨0, fun u _ => by simp, fun _ => rfl⟩
    | add w w' _ _ hw hw' =>
      intro χ hχ
      obtain ⟨c, hc, hc0⟩ := hw χ hχ
      obtain ⟨c', hc', hc0'⟩ := hw' χ hχ
      exact ⟨c + c', fun u hu => by rw [LinearMap.add_apply, hc u hu, hc' u hu, add_smul],
        fun h => by rw [hc0 h, hc0' h, add_zero]⟩
    | smul a w _ hw =>
      intro χ hχ
      obtain ⟨c, hc, hc0⟩ := hw χ hχ
      exact ⟨a * c, fun u hu => by rw [LinearMap.smul_apply, hc u hu, smul_smul],
        fun h => by rw [hc0 h, mul_zero]⟩
  have hEvinj : ∀ w ∈ W', Ev w = 0 → w = 0 := by
    intro w hw h0
    have hker : (⨆ χ ∈ S, jointEigen Y E χ) ≤ LinearMap.ker w := by
      refine iSup₂_le fun χ hχ u hu => ?_
      obtain ⟨c, hc, hc0⟩ := hgood w hw χ hχ
      rw [LinearMap.mem_ker, hc u hu]
      rcases hce01 χ hχ with h | h
      · rw [hc0 h, zero_smul]
      · have hχe : χ ∈ Se := Finset.mem_filter.2 ⟨hχ, h⟩
        have h1 := congrFun h0 ⟨χ, hχe⟩
        change f ⟨χ, hχe⟩ (w (v ⟨χ, hχe⟩)) = 0 at h1
        rw [hc (v ⟨χ, hχe⟩) (hvmem ⟨χ, hχe⟩), LinearMap.map_smul, hf, smul_eq_mul, mul_one] at h1
        rw [h1, zero_smul]
    rw [htop, top_le_iff, LinearMap.ker_eq_top] at hker
    exact hker
  have hEvinj2 : ∀ w1 ∈ W', ∀ w2 ∈ W', Ev w1 = Ev w2 → w1 = w2 := by
    intro w1 hw1 w2 hw2 h0
    have hker : (⨆ χ ∈ S, jointEigen Y E χ) ≤ LinearMap.eqLocus w1 w2 := by
      refine iSup₂_le fun χ hχ u hu => ?_
      obtain ⟨c1, hc1, hc01⟩ := hgood w1 hw1 χ hχ
      obtain ⟨c2, hc2, hc02⟩ := hgood w2 hw2 χ hχ
      rw [LinearMap.mem_eqLocus, hc1 u hu, hc2 u hu]
      rcases hce01 χ hχ with h | h
      · rw [hc01 h, hc02 h]
      · have hχe : χ ∈ Se := Finset.mem_filter.2 ⟨hχ, h⟩
        have h1 := congrFun h0 ⟨χ, hχe⟩
        change f ⟨χ, hχe⟩ (w1 (v ⟨χ, hχe⟩)) = f ⟨χ, hχe⟩ (w2 (v ⟨χ, hχe⟩)) at h1
        rw [hc1 (v ⟨χ, hχe⟩) (hvmem ⟨χ, hχe⟩), hc2 (v ⟨χ, hχe⟩) (hvmem ⟨χ, hχe⟩), LinearMap.map_smul,
          LinearMap.map_smul, hf, smul_eq_mul, smul_eq_mul, mul_one, mul_one] at h1
        rw [h1]
    rw [htop, top_le_iff] at hker
    exact LinearMap.ext fun u => (LinearMap.mem_eqLocus).1 (hker ▸ Submodule.mem_top)
  have hEvgen : ∀ t : TL X, Ev ((e * t).baseChange E) = fun χ => eigval Y χ.1 t := by
    intro t
    funext χ
    have hχS := (Finset.mem_filter.1 χ.2).1
    have hχ1 := (Finset.mem_filter.1 χ.2).2
    change f χ ((((ê * t : TL X)) : Module.End ℤ_[p] (Lfree (p := p) L)).baseChange E (v χ)) = _
    rw [eigval_spec Y χ.1 (ê * t) (v χ) (hvmem χ), hψmul ê t χ.1 hχS]
    change f χ ((ce χ.1 * eigval Y χ.1 t) • v χ) = _
    rw [hχ1, one_mul, LinearMap.map_smul, hf, smul_eq_mul, mul_one]
  have hmemW' : ∀ t : TL X, (e * t).baseChange E ∈ W' := fun t =>
    Submodule.subset_span ⟨e * t, Submodule.subset_span ⟨t, t.2, rfl⟩, rfl⟩
  -- the restriction `ρ : T^𝕃 → E^{S_e}`
  let ρ : TL X →ₐ[ℤ_[p]] (Se → E) :=
    (Pi.algHom ℤ_[p] (fun _ : Se => E) fun χ =>
      Pi.evalAlgHom ℤ_[p] (fun _ : (S : Set (ι → E)) => E) ⟨χ.1, (Finset.mem_filter.1 χ.2).1⟩).comp ψ
  have hρ : ∀ t χ, ρ t χ = eigval Y χ.1 t := fun _ _ => rfl
  have hρgen : ∀ i (χ : Se), ρ ⟨Y i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ χ = χ.1 i := by
    intro i χ
    rw [hρ]
    exact eigval_unique Y (hne χ.1 (Finset.mem_filter.1 χ.2).1) _ _
      fun u hu => (mem_jointEigen_iff Y E).1 hu i
  have hspan_le : Submodule.span E (ρ.range : Set (Se → E)) ≤ W'.map Ev := by
    rw [Submodule.span_le]
    rintro _ ⟨t, rfl⟩
    refine ⟨_, hmemW' t, ?_⟩
    rw [hEvgen]; rfl
  have hadj : (Algebra.adjoin E (ρ.range : Set (Se → E))).toSubmodule ≤ Submodule.span E (ρ.range : Set (Se → E)) := by
    rw [Algebra.adjoin_eq_span]
    exact Submodule.span_mono (by
      intro g hg
      exact (Submonoid.closure_le (S := ρ.range.toSubmonoid)).2 le_rfl hg)
  have hdelta : ∀ χ0 : Se, (fun j : Se => if χ0 = j then (1 : E) else 0) ∈ W'.map Ev := by
    intro χ0
    by_cases hι : Nonempty ι
    swap
    · have hall : ∀ j : Se, χ0 = j := fun j => Subtype.ext (funext fun i => (hι ⟨i⟩).elim)
      have h1 : (fun j : Se => if χ0 = j then (1 : E) else 0) = ρ 1 := by
        funext j; rw [if_pos (hall j), map_one, Pi.one_apply]
      rw [h1]
      exact hspan_le (Submodule.subset_span ⟨1, rfl⟩)
    have hidx : ∀ χ' : Se, χ' ≠ χ0 → ∃ i, χ0.1 i ≠ χ'.1 i := fun χ' h => by
      by_contra hc
      push Not at hc
      exact h (Subtype.ext (funext hc).symm)
    choose! idx hidx using hidx
    let fac : Se → (Se → E) := fun χ' =>
      (χ0.1 (idx χ') - χ'.1 (idx χ'))⁻¹ • (ρ ⟨Y (idx χ'), Algebra.subset_adjoin ⟨idx χ', rfl⟩⟩ -
        algebraMap E (Se → E) (χ'.1 (idx χ')))
    have hfac : ∀ χ', fac χ' ∈ Algebra.adjoin E (ρ.range : Set (Se → E)) := fun χ' =>
      Subalgebra.smul_mem _ (Subalgebra.sub_mem _
        (Algebra.subset_adjoin (Set.mem_range_self (f := ρ) ⟨Y (idx χ'), Algebra.subset_adjoin ⟨idx χ', rfl⟩⟩))
        (Subalgebra.algebraMap_mem _ _)) _
    have hprod : (fun j : Se => if χ0 = j then (1 : E) else 0) = ∏ χ' ∈ Finset.univ.erase χ0, fac χ' := by
      funext j
      rw [Finset.prod_apply]
      by_cases hj : χ0 = j
      · subst hj
        rw [if_pos rfl]
        refine (Finset.prod_eq_one fun χ' hχ' => ?_).symm
        have hne' := hidx χ' (Finset.ne_of_mem_erase hχ')
        simp only [fac, Pi.smul_apply, Pi.sub_apply, hρgen, Pi.algebraMap_apply, Algebra.algebraMap_self,
          RingHom.id_apply, smul_eq_mul]
        exact inv_mul_cancel₀ (sub_ne_zero.mpr hne')
      · rw [if_neg hj]
        refine (Finset.prod_eq_zero (i := j) (Finset.mem_erase.2 ⟨Ne.symm hj, Finset.mem_univ _⟩) ?_).symm
        simp only [fac, Pi.smul_apply, Pi.sub_apply, hρgen, Pi.algebraMap_apply, Algebra.algebraMap_self,
          RingHom.id_apply, sub_self, smul_zero]
    rw [hprod]
    exact hspan_le (hadj (Subalgebra.prod_mem _ fun χ' _ => hfac χ'))
  have hmaptop : W'.map Ev = ⊤ := by
    refine top_le_iff.1 fun g _ => ?_
    rw [pi_eq_sum_univ g]
    exact Submodule.sum_mem _ fun χ _ => Submodule.smul_mem _ _ (hdelta χ)
  have hrankW' : Module.finrank E W' = Se.card := by
    let Ev' : W' →ₗ[E] (Se → E) := Ev.comp W'.subtype
    have hinj : Function.Injective Ev' := by
      intro w1 w2 h
      exact Subtype.ext (hEvinj2 w1.1 w1.2 w2.1 w2.2 h)
    have hsurj : Function.Surjective Ev' := by
      intro g
      obtain ⟨w, hw, rfl⟩ := (hmaptop ▸ Submodule.mem_top : g ∈ W'.map Ev)
      exact ⟨⟨w, hw⟩, rfl⟩
    rw [(LinearEquiv.ofBijective Ev' ⟨hinj, hsurj⟩).finrank_eq, Module.finrank_fintype_fun_eq_card,
      Fintype.card_coe]
  -- (3) arithmetic
  have hsum : ∑ χ ∈ Se, mult χ + (Se.filter fun χ => mult χ = 1).card = 2 * Se.card := by
    rw [Finset.card_filter, ← Finset.sum_add_distrib, Finset.card_eq_sum_ones, Finset.mul_sum]
    refine Finset.sum_congr rfl fun χ hχ => ?_
    rcases hm χ (Finset.mem_filter.1 hχ).1 with h | h <;> simp [h]
  have hk : (Se.filter fun χ => mult χ = 1).card ≤ 1 :=
    le_trans (Finset.card_le_card (Finset.monotone_filter_left _ (Finset.filter_subset _ _))) hm1
  refine ⟨?_, ?_⟩
  · rw [hrankN, hrankW', hrank_range]
    omega
  -- (4) `ℚ_ℓ ⊗ T^𝕃` is reduced
  · let Φ : ℚ_[p] ⊗[ℤ_[p]] TL X →ₐ[ℚ_[p]] (↥(↑S : Set (ι → E)) → E) :=
      Algebra.TensorProduct.lift (Algebra.ofId ℚ_[p] _) (ψ : TL X →ₐ[ℤ_[p]] (↥(↑S : Set (ι → E)) → E))
        fun _ _ => Commute.all _ _
    have hΦ : Function.Injective Φ := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨s, hs, a, hsa⟩ := tensor_qp_clear x
      have h1 : Φ ((algebraMap ℤ_[p] ℚ_[p] s) • x) = 0 := by rw [map_smul, hx, smul_zero]
      have hΦt : Φ ((1 : ℚ_[p]) ⊗ₜ a) = ψ a := by
        erw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      rw [hsa, hΦt] at h1
      have ha : a = 0 := hψinj (h1.trans (map_zero ψ).symm)
      rw [ha, TensorProduct.tmul_zero] at hsa
      have hs' : algebraMap ℤ_[p] ℚ_[p] s ≠ 0 := fun h =>
        hs (IsFractionRing.injective ℤ_[p] ℚ_[p] (h.trans (map_zero _).symm))
      rw [← one_smul ℚ_[p] x, ← inv_mul_cancel₀ hs', mul_smul, hsa, smul_zero]
    exact isReduced_of_injective Φ hΦ


end HeckeRankOne

/-! ### `cor:stablecert` at `T_e = e T^𝕃` (L19-1, M3-a): `hrank` discharged by `heckerankone`

F3-18 §6: `T_e` is **not** `Algebra.adjoin ℤ_ℓ {e t}` (whose unit is `1`) but the image of `t ↦ (e t)|_{range e}` in
`End(range e)`, a commutative `ℤ_ℓ`-algebra with unit `e|_{range e} = id`, acting faithfully on `L_e = range e = e 𝕃'`.
The construction is generic in a module `M` and a subalgebra `T ⊆ End M` (commutative, `e ∈ T` idempotent), which keeps the
instance terms on `range e` uniform; `TL_mul_comm` supplies the commutativity of `T^𝕃` from `EichlerShimuraLevelOne`
(the `T_p` act on `E ⊗ 𝕃'` by scalars on a spanning family of joint eigenspaces, `sysHom_injective`), and
`rk_Te_eq_span` identifies `rank T_e` with `rank span(e T^𝕃)`, the quantity of `heckerankone`.  So `stablecert_ES`
is `stablecert` with `hrank` a theorem: its only literature hypothesis is `hES`. -/

section TeDef

variable {M : Type*} [AddCommGroup M] [Module ℤ_[p] M] (T : Subalgebra ℤ_[p] (Module.End ℤ_[p] M))
  (e : Module.End ℤ_[p] M) (he : e * e = e) (hcomm : ∀ a b : T, a * b = b * a) (heT : e ∈ T)

include hcomm heT in
lemma idem_comm_apply (t : T) (z : M) : e ((t : Module.End ℤ_[p] M) z) = (t : Module.End ℤ_[p] M) (e z) :=
  LinearMap.congr_fun (congrArg Subtype.val (hcomm ⟨e, heT⟩ t)) z

include he in
lemma idem_apply (z : M) : e (e z) = e z := LinearMap.congr_fun he z

/-- `f ↦ (e f)|_{range e}`, for any `f` (it maps `range e` into itself). -/
def resFun (f : Module.End ℤ_[p] M) : Module.End ℤ_[p] (LinearMap.range e) :=
  (e * f).restrict (p := LinearMap.range e) (q := LinearMap.range e) (fun x _ => ⟨f x, rfl⟩)

@[simp] lemma resFun_coe (f : Module.End ℤ_[p] M) (x : LinearMap.range e) :
    (resFun e f x : M) = e (f x) := rfl

/-- `t ↦ (e t)|_{range e}`, an algebra map `T → End(range e)` (`e` idempotent and central in `T`). -/
def resE : T →ₐ[ℤ_[p]] Module.End ℤ_[p] (LinearMap.range e) where
  toFun t := resFun e t
  map_one' := by
    ext ⟨_, y, rfl⟩
    simp [idem_apply e he]
  map_mul' a b := by
    ext ⟨_, y, rfl⟩
    simp [idem_comm_apply T e hcomm heT, idem_apply e he]
  map_zero' := by ext; simp
  map_add' a b := by ext; simp
  commutes' r := by
    ext ⟨_, y, rfl⟩
    simp [Module.algebraMap_end_apply, idem_apply e he]

@[simp] lemma resE_coe (t : T) (x : LinearMap.range e) :
    (resE T e he hcomm heT t x : M) = e ((t : Module.End ℤ_[p] M) x) := rfl

/-- `T_e := e T`, the image of `resE` in `End(range e)`. -/
def Te : Subalgebra ℤ_[p] (Module.End ℤ_[p] (LinearMap.range e)) := (resE T e he hcomm heT).range

theorem Te_mul_comm (a b : Te T e he hcomm heT) : a * b = b * a := by
  obtain ⟨_, a, rfl⟩ := a
  obtain ⟨_, b, rfl⟩ := b
  apply Subtype.ext
  change resE T e he hcomm heT a * resE T e he hcomm heT b = resE T e he hcomm heT b * resE T e he hcomm heT a
  rw [← map_mul, ← map_mul, hcomm]

instance Te.instCommRing : CommRing (Te T e he hcomm heT) :=
  { (inferInstance : Ring (Te T e he hcomm heT)) with mul_comm := Te_mul_comm T e he hcomm heT }

/-- The action of `T_e` on `range e` (the inclusion). -/
def actTe : Te T e he hcomm heT →ₐ[ℤ_[p]] Module.End ℤ_[p] (LinearMap.range e) := (Te T e he hcomm heT).val

theorem actTe_injective : Function.Injective (actTe T e he hcomm heT) := Subtype.val_injective

theorem rk_Te_eq_span : rk (p := p) (T := Te T e he hcomm heT) =
    Module.finrank ℤ_[p] (Submodule.span ℤ_[p] ((fun t => e * t) '' (T : Set _))) := by
  set Φ := (resE T e he hcomm heT).toLinearMap
  set Ψ : T →ₗ[ℤ_[p]] Module.End ℤ_[p] M := (LinearMap.mulLeft ℤ_[p] e).comp T.val.toLinearMap
  have hspan : Submodule.span ℤ_[p] ((fun t => e * t) '' (T : Set _)) = LinearMap.range Ψ := by
    apply le_antisymm
    · rw [Submodule.span_le]
      rintro _ ⟨t, ht, rfl⟩
      exact ⟨⟨t, ht⟩, rfl⟩
    · rintro _ ⟨t, rfl⟩
      exact Submodule.subset_span ⟨t.1, t.2, rfl⟩
  have hker : LinearMap.ker Φ = LinearMap.ker Ψ := by
    ext t
    simp only [LinearMap.mem_ker]
    constructor
    · intro h
      refine LinearMap.ext fun z => ?_
      have h1 := congrArg Subtype.val (LinearMap.congr_fun h ⟨e z, z, rfl⟩)
      simp [Φ] at h1
      simp [Ψ]
      rw [idem_comm_apply T e hcomm heT, ← idem_apply e he z, ← idem_comm_apply T e hcomm heT, h1]
    · intro h
      ext ⟨_, y, rfl⟩
      have := LinearMap.congr_fun h (e y)
      simpa [Φ, Ψ] using this
  have hTe : Subalgebra.toSubmodule (Te T e he hcomm heT) = LinearMap.range Φ := by
    ext x; simp [Te, Φ, AlgHom.mem_range]
  unfold rk
  rw [← Subalgebra.finrank_toSubmodule, hTe, hspan]
  exact (Φ.quotKerEquivRange.symm.trans
    ((Submodule.quotEquivOfEq _ _ hker).trans Ψ.quotKerEquivRange)).finrank_eq

/-- `t ↦ (e t)|_{range e}` with values in `T_e`. -/
def resTe : T →ₐ[ℤ_[p]] Te T e he hcomm heT := (resE T e he hcomm heT).rangeRestrict

/-- `range e` is free when `M` is free of finite rank (`ℤ_ℓ` is a PID). -/
theorem Te_range_free [Module.Free ℤ_[p] M] [Module.Finite ℤ_[p] M] : Module.Free ℤ_[p] (LinearMap.range e) :=
  Module.Free.of_basis (Submodule.basisOfPid (Module.Free.chooseBasis ℤ_[p] M) (LinearMap.range e)).2

theorem Te_range_finite [Module.Free ℤ_[p] M] [Module.Finite ℤ_[p] M] : Module.Finite ℤ_[p] (LinearMap.range e) :=
  Module.Finite.of_basis (Submodule.basisOfPid (Module.Free.chooseBasis ℤ_[p] M) (LinearMap.range e)).2

/-- The conclusion of `stablecert` (`cor:stablecert`(1)) at `act := actTe : T_e ↪ End(range e)`, for `ι' : T' ↪ T_e`
(`f = rank (range e)`). -/
def StablecertConcl {T' : Type*} [CommRing T'] [Algebra ℤ_[p] T'] (ι' : T' →ₐ[ℤ_[p]] Te T e he hcomm heT) : Prop :=
  let act := actTe T e he hcomm heT
  (∀ K, 1 ≤ K → Module.length ℤ_[p] (AK (act.comp ι') K ⧸ pI p • (⊤ : Submodule ℤ_[p] (AK (act.comp ι') K))) =
        ((Module.finrank ℤ_[p] (LinearMap.range e) + 1) / 2 : ℕ) →
      rk (p := p) (T := T') = rk (p := p) (T := Te T e he hcomm heT) ∧
        ∀ K', K ≤ K' → Function.Injective (redMap (act.comp ι') K')) ∧
    ((∃ K, 1 ≤ K ∧ Module.length ℤ_[p] (AK (act.comp ι') K ⧸ pI p • (⊤ : Submodule ℤ_[p] (AK (act.comp ι') K))) =
        ((Module.finrank ℤ_[p] (LinearMap.range e) + 1) / 2 : ℕ)) ↔
        rk (p := p) (T := T') = rk (p := p) (T := Te T e he hcomm heT)) ∧
    (rk (p := p) (T := T') = rk (p := p) (T := Te T e he hcomm heT) →
      ∃ K, 1 ≤ K ∧ K ≤ cSat (act.comp ι') + 1 ∧
      Module.length ℤ_[p] (AK (act.comp ι') K ⧸ pI p • (⊤ : Submodule ℤ_[p] (AK (act.comp ι') K))) =
        ((Module.finrank ℤ_[p] (LinearMap.range e) + 1) / 2 : ℕ))

/-- `stablecert` at `T_e = e T` on `range e`, given the rank equality `hrank` (generic in `M`; `stablecert_ES`
discharges `hrank` by `heckerankone`). -/
theorem stablecert_Te [Module.Free ℤ_[p] M] [Module.Finite ℤ_[p] M]
    (hrank : rk (p := p) (T := Te T e he hcomm heT) = (Module.finrank ℤ_[p] (LinearMap.range e) + 1) / 2)
    {T' : Type*} [CommRing T'] [Algebra ℤ_[p] T'] (ι' : T' →ₐ[ℤ_[p]] Te T e he hcomm heT)
    (hι : Function.Injective ι') : StablecertConcl T e he hcomm heT ι' := by
  have := Te_range_free (p := p) e
  have := Te_range_finite (p := p) e
  exact stablecert (actTe T e he hcomm heT) (actTe_injective T e he hcomm heT) hrank ι' hι

end TeDef

section StableCertES

open GL2.Literature


/-- `T^𝕃` is commutative, given `EichlerShimuraLevelOne`: `sysHom : T^𝕃 → E^S` is an injective ring map into a
commutative ring (`sysHom_injective`; the joint eigenspaces span `E ⊗ 𝕃'`). -/
theorem TL_mul_comm (E : Type*) [Field E] [Algebra ℤ_[p] E] [Algebra ℚ_[p] E] [IsScalarTower ℤ_[p] ℚ_[p] E]
    (hES : EichlerShimuraLevelOne (Lfree (p := p) L) (fun i => onFree (X i)) E) (a b : TL X) :
    a * b = b * a := by
  classical
  have : Module.Free ℤ_[p] (Lfree (p := p) L) := Module.free_of_finite_type_torsion_free'
  have hE := algebraMap_injective_of_tower (p := p) E
  set Y : ι → Module.End ℤ_[p] (Lfree (p := p) L) := fun i => onFree (X i) with hY
  obtain ⟨S, mult, hm, -, hdim, htop⟩ := hES.decomp
  have hne : ∀ χ ∈ (S : Set (ι → E)), jointEigen Y E χ ≠ ⊥ := by
    intro χ hχ hbot
    have := hdim χ hχ
    rw [hbot, finrank_bot] at this
    rcases hm χ hχ with h | h <;> omega
  have htop' : (⨆ χ ∈ (S : Set (ι → E)), jointEigen Y E χ) = ⊤ := by simpa using htop
  have hinj := sysHom_injective Y E hE _ hne htop'
  set ψ := sysHom Y (S : Set (ι → E)) hne
  exact hinj ((map_mul ψ a b).trans ((mul_comm _ _).trans (map_mul ψ b a).symm))

/-- **`hrank` from `heckerankone`**: `rank T_e = ⌈rank(e𝕃')/2⌉` for `T_e = e T^𝕃` on `e𝕃' = range e`
(`rk_Te_eq_span` and `heckerankone`(1)). -/
theorem rk_Te_eq (E : Type*) [Field E] [Algebra ℤ_[p] E] [Algebra ℚ_[p] E] [IsScalarTower ℤ_[p] ℚ_[p] E]
    (hES : EichlerShimuraLevelOne (Lfree (p := p) L) (fun i => onFree (X i)) E)
    (e : Module.End ℤ_[p] (Lfree (p := p) L)) (heT : e ∈ TL X) (he : e * e = e) :
    rk (p := p) (T := Te (TL X) e he (TL_mul_comm X E hES) heT) =
      (Module.finrank ℤ_[p] (LinearMap.range e) + 1) / 2 := by
  rw [rk_Te_eq_span]
  exact (heckerankone X E hES e heT he).1

/-- **`cor:stablecert`(1) at `T_e = e T^𝕃`** (L19-1, M3-a): `stablecert` for `act := actTe : T_e ↪ End(e𝕃')`,
`e ∈ T^𝕃` an idempotent, and any `ι' : T' ↪ T_e`, with `hrank` discharged by `rk_Te_eq`. The only literature
hypothesis is `hES`. The conclusion `StablecertConcl` is `stablecert`'s, verbatim, at this `act`. -/
theorem stablecert_ES (E : Type*) [Field E] [Algebra ℤ_[p] E] [Algebra ℚ_[p] E] [IsScalarTower ℤ_[p] ℚ_[p] E]
    (hES : EichlerShimuraLevelOne (Lfree (p := p) L) (fun i => onFree (X i)) E)
    (e : Module.End ℤ_[p] (Lfree (p := p) L)) (heT : e ∈ TL X) (he : e * e = e)
    {T' : Type*} [CommRing T'] [Algebra ℤ_[p] T'] (ι' : T' →ₐ[ℤ_[p]] Te (TL X) e he (TL_mul_comm X E hES) heT)
    (hι : Function.Injective ι') :
    StablecertConcl (TL X) e he (TL_mul_comm X E hES) heT ι' := by
  have : Module.Free ℤ_[p] (Lfree (p := p) L) := Module.free_of_finite_type_torsion_free'
  exact stablecert_Te (TL X) e he _ heT (rk_Te_eq X E hES e heT he) ι' hι

end StableCertES


/-- **`prop:cohforms`(3)** (given `GL2.Literature.EichlerShimuraLevelOne` and `GL2.Literature.FormsSameSystems`):
`T_p ↦ T_p` extends to an isomorphism `T^𝕃 ≅ T^f`; the natural map runs from cohomology to forms. `Mk` stands for
`M_k(ℤ_ℓ)` (torsion-free). [C]'s proof uses the same systems on both sides, **each semisimply**: `hES` supplies the
semisimplicity on `E ⊗ 𝕃'` (without it the statement is false, F3 audit finding 2: `𝕃' = ℤ_ℓ²`, `X = [[0,1],[0,0]]`,
`M_k = ℤ_ℓ`, `X_M = 0`). -/
theorem cohforms_iso {Mk : Type*} [AddCommGroup Mk] [Module ℤ_[p] Mk] [Module.Free ℤ_[p] Mk]
    [Module.Finite ℤ_[p] Mk] (XM : ι → Module.End ℤ_[p] Mk) (E : Type*) [Field E] [Algebra ℤ_[p] E]
    [Algebra ℚ_[p] E] [IsScalarTower ℤ_[p] ℚ_[p] E]
    (hES : GL2.Literature.EichlerShimuraLevelOne (Lfree (p := p) L) (fun i => onFree (X i)) E)
    (hF : GL2.Literature.FormsSameSystems (Lfree (p := p) L) Mk (fun i => onFree (X i)) XM E) :
    ∃ φ : TL X ≃ₐ[ℤ_[p]] Algebra.adjoin ℤ_[p] (Set.range XM),
      ∀ i, (φ ⟨onFree (X i), Algebra.subset_adjoin ⟨i, rfl⟩⟩ : Module.End ℤ_[p] Mk) = XM i := by
  classical
  have hE := algebraMap_injective_of_tower (p := p) E
  set YL : ι → Module.End ℤ_[p] (Lfree (p := p) L) := fun i => onFree (X i) with hYL
  let Sys : Set (ι → E) := {χ | GL2.Literature.jointEigen YL E χ ≠ ⊥}
  have hSysL : ∀ χ ∈ Sys, GL2.Literature.jointEigen YL E χ ≠ ⊥ := fun χ hχ => hχ
  have hSysM : ∀ χ ∈ Sys, GL2.Literature.jointEigen XM E χ ≠ ⊥ := fun χ hχ => (hF.same_systems χ).1 hχ
  have hspanL : (⨆ χ ∈ Sys, GL2.Literature.jointEigen YL E χ) = ⊤ := by
    obtain ⟨S, mult, hm, -, hdim, htop⟩ := hES.decomp
    refine top_le_iff.1 (htop ▸ iSup₂_le fun χ hχ => le_iSup₂_of_le χ ?_ le_rfl)
    intro hbot
    have := hdim χ hχ
    rw [hbot, finrank_bot] at this
    rcases hm χ hχ with h | h <;> omega
  have hspanM : (⨆ χ ∈ Sys, GL2.Literature.jointEigen XM E χ) = ⊤ := by
    obtain ⟨S, hdim, htop⟩ := hF.semisimple_forms
    refine top_le_iff.1 (htop ▸ iSup₂_le fun χ hχ => le_iSup₂_of_le χ ?_ le_rfl)
    show GL2.Literature.jointEigen YL E χ ≠ ⊥
    rw [hF.same_systems χ]
    intro hbot
    have := hdim χ hχ
    rw [hbot, finrank_bot] at this
    omega
  have hL := sysHom_injective YL E hE Sys hSysL hspanL
  have hM := sysHom_injective XM E hE Sys hSysM hspanM
  have hr : (sysHom YL Sys hSysL).range = (sysHom XM Sys hSysM).range := by
    rw [sysHom_range, sysHom_range]
  refine ⟨(AlgEquiv.ofInjective _ hL).trans ((Subalgebra.equivOfEq _ _ hr).trans (AlgEquiv.ofInjective _ hM).symm),
    fun i => ?_⟩
  have hgen : (AlgEquiv.ofInjective _ hM) ⟨XM i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ =
      Subalgebra.equivOfEq _ _ hr ((AlgEquiv.ofInjective _ hL) ⟨onFree (X i), Algebra.subset_adjoin ⟨i, rfl⟩⟩) := by
    apply Subtype.ext
    simp only [AlgEquiv.ofInjective_apply, Subalgebra.equivOfEq_apply]
    rw [sysHom_gen XM E Sys hSysM i]
    exact (sysHom_gen YL E Sys hSysL i).symm
  change ((AlgEquiv.ofInjective _ hM).symm (Subalgebra.equivOfEq _ _ hr
    ((AlgEquiv.ofInjective _ hL) ⟨onFree (X i), Algebra.subset_adjoin ⟨i, rfl⟩⟩)) : Module.End ℤ_[p] Mk) = XM i
  rw [← hgen, AlgEquiv.symm_apply_apply]

/-- **`prop:cohforms`(4)**, the surjection `𝖠 ↠ 𝖠^𝕃`: an operator of `T^coh` acting as `0` on `𝕃/ℓ` acts as `0` on
`𝕃'/ℓ`. (No natural map between `𝖠` and `T^f/ℓ` is asserted, and none is stated.) -/
theorem cohforms_census_surj (a : Module.End ℤ_[p] L) (ha : a ∈ Tcoh X) :
    endQ (pI p) a = 0 → endQ (pI p) (onFree a) = 0 := by
  intro h
  refine Submodule.linearMap_qext _ (LinearMap.ext fun z => ?_)
  induction z using Submodule.Quotient.induction_on with
  | H v =>
  have hv := LinearMap.congr_fun h (Submodule.Quotient.mk v)
  change Submodule.Quotient.mk (a v) = 0 at hv
  rw [Submodule.Quotient.mk_eq_zero, mem_pI_smul_top] at hv
  obtain ⟨w, hw⟩ := hv
  change Submodule.Quotient.mk (Submodule.Quotient.mk (a v) : Lfree (p := p) L) = 0
  rw [Submodule.Quotient.mk_eq_zero, mem_pI_smul_top, hw]
  exact ⟨Submodule.Quotient.mk w, rfl⟩


/-- `endQ I` as an algebra map `End M → End(M / I M)` (L18-4). -/
def endQAlg {M : Type*} [AddCommGroup M] [Module ℤ_[p] M] (I : Ideal ℤ_[p]) :
    Module.End ℤ_[p] M →ₐ[ℤ_[p]] Module.End ℤ_[p] (M ⧸ I • (⊤ : Submodule ℤ_[p] M)) where
  toFun := endQ I
  map_one' := Submodule.linearMap_qext _ (LinearMap.ext fun _ => rfl)
  map_mul' _ _ := Submodule.linearMap_qext _ (LinearMap.ext fun _ => rfl)
  map_zero' := Submodule.linearMap_qext _ (LinearMap.ext fun _ => rfl)
  map_add' _ _ := Submodule.linearMap_qext _ (LinearMap.ext fun _ => rfl)
  commutes' _ := Submodule.linearMap_qext _ (LinearMap.ext fun _ => rfl)

/-- **`prop:cohforms`(4)**, the second surjection (L18-4; L17-1 audit MINOR-2), given the inputs of `cohforms_iso`:
`T^f → T^𝕃 → 𝖠^𝕃 ⊆ End(𝕃'/ℓ)`, `T_p ↦ T_p`, kills `ℓ T^f` (so factors through `T^f/ℓ ≅ T^𝕃/ℓ`) and is onto `𝖠^𝕃`, the
image of `T^𝕃` in `End(𝕃'/ℓ)`. -/
theorem cohforms_census_surj2 {Mk : Type*} [AddCommGroup Mk] [Module ℤ_[p] Mk] [Module.Free ℤ_[p] Mk]
    [Module.Finite ℤ_[p] Mk] (XM : ι → Module.End ℤ_[p] Mk) (E : Type*) [Field E] [Algebra ℤ_[p] E]
    [Algebra ℚ_[p] E] [IsScalarTower ℤ_[p] ℚ_[p] E]
    (hES : GL2.Literature.EichlerShimuraLevelOne (Lfree (p := p) L) (fun i => onFree (X i)) E)
    (hF : GL2.Literature.FormsSameSystems (Lfree (p := p) L) Mk (fun i => onFree (X i)) XM E) :
    ∃ ψ : Algebra.adjoin ℤ_[p] (Set.range XM) →ₐ[ℤ_[p]]
        Module.End ℤ_[p] (Lfree (p := p) L ⧸ pI p • (⊤ : Submodule ℤ_[p] (Lfree (p := p) L))),
      (∀ i, ψ ⟨XM i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ = endQ (pI p) (onFree (X i))) ∧
      (∀ b, ψ ((p : ℤ_[p]) • b) = 0) ∧
      Set.range ψ = endQ (pI p) '' (TL X : Set (Module.End ℤ_[p] (Lfree (p := p) L))) := by
  obtain ⟨φ, hφ⟩ := cohforms_iso X XM E hES hF
  let ψ : Algebra.adjoin ℤ_[p] (Set.range XM) →ₐ[ℤ_[p]]
      Module.End ℤ_[p] (Lfree (p := p) L ⧸ pI p • (⊤ : Submodule ℤ_[p] (Lfree (p := p) L))) :=
    (endQAlg (pI p)).comp ((TL X).val.comp φ.symm.toAlgHom)
  have hψ : ∀ b, ψ b = endQAlg (pI p) ((φ.symm b : TL X) : Module.End ℤ_[p] (Lfree (p := p) L)) := fun _ => rfl
  have hE : ∀ a, endQAlg (p := p) (M := Lfree (p := p) L) (pI p) a = endQ (pI p) a := fun _ => rfl
  refine ⟨ψ, fun i => ?_, fun b => ?_, ?_⟩
  · have : φ.symm ⟨XM i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ = ⟨onFree (X i), Algebra.subset_adjoin ⟨i, rfl⟩⟩ := by
      rw [AlgEquiv.symm_apply_eq]; exact Subtype.ext (hφ i).symm
    rw [hψ, this, hE]
  · rw [map_smul, hψ, hE]
    refine Submodule.linearMap_qext _ (LinearMap.ext fun v => ?_)
    rw [LinearMap.comp_apply, LinearMap.smul_apply, LinearMap.zero_comp, LinearMap.zero_apply,
      Submodule.mkQ_apply, endQ, Submodule.mapQ_apply, ← Submodule.Quotient.mk_smul,
      Submodule.Quotient.mk_eq_zero, mem_pI_smul_top]
    exact ⟨_, rfl⟩
  · ext y
    constructor
    · rintro ⟨b, rfl⟩
      exact ⟨_, (φ.symm b).2, (hψ b).trans (hE _)⟩
    · rintro ⟨a, ha, rfl⟩
      refine ⟨φ ⟨a, ha⟩, ?_⟩
      rw [hψ, AlgEquiv.symm_apply_apply, hE]
end GL2.Sat

/-! ### P18: `prop:hidaalgconst` -/

namespace GL2.Sat

open GL2.Literature

/-- **`prop:hidaalgconst`(1)**, the ideal identity: `(ℓ, P_k) = (ℓ, X)` in `Λ = ℤ_ℓ[[X]]`. -/
theorem ideal_p_Pk (p : ℕ) [Fact p.Prime] (k : ℕ) :
    Ideal.span {PowerSeries.C (p : ℤ_[p]), Pk p k} = Ideal.span {PowerSeries.C (p : ℤ_[p]), PowerSeries.X} := by
  obtain ⟨u, hu⟩ : (p : ℤ_[p]) ∣ (1 + (p : ℤ_[p])) ^ k - 1 := by
    simpa using sub_dvd_pow_sub_pow (1 + (p : ℤ_[p])) 1 k
  have hP : Pk p k = PowerSeries.X - PowerSeries.C (p : ℤ_[p]) * PowerSeries.C u := by
    rw [Pk, ← map_mul, ← hu, map_sub, map_one]; ring
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro x (rfl | rfl)
    · exact Ideal.subset_span (by simp)
    · rw [hP]
      exact Ideal.sub_mem _ (Ideal.subset_span (by simp)) (Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp)))
  · rw [Ideal.span_le]
    rintro x (rfl | rfl)
    · exact Ideal.subset_span (by simp)
    · have hX : (PowerSeries.X : Iw p) = Pk p k + PowerSeries.C (p : ℤ_[p]) * PowerSeries.C u := by
        rw [hP]; ring
      rw [hX]
      exact Ideal.add_mem _ (Ideal.subset_span (by simp)) (Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp)))

/-- **`prop:hidaalgconst`(1)–(2)** (from Hida's control, `GL2.Literature.HidaEns32`): for `k, k' ≥ 2` in the class `a`,
`h⁰_k/ℓ ≅ h⁰/(ℓ, X) ≅ h⁰_{k'}/ℓ` as rings; so the maximal ideals, residual systems, Hilbert functions and Loewy lengths
of `h⁰_k/ℓ` do not depend on `k` in the class. (The "each Hecke operator goes to itself" clause needs the universal
`T(m)` of the interface data, which `HidaEns32` does not carry; recorded in [GT].) -/
theorem hidaalgconst (p : ℕ) [Fact p.Prime] (a : ZMod (p - 1)) (h : Type*) [CommRing h] [Algebra (Iw p) h]
    (hk : ℕ → Type*) [∀ k, CommRing (hk k)] (N : ℕ) (hH : HidaEns32 p N a h hk) (hp : 5 ≤ p) (hpN : p ∣ N)
    (k k' : ℕ) (hk2 : 2 ≤ k)
    (hk2' : 2 ≤ k') (hka : (k : ZMod (p - 1)) = a) (hka' : (k' : ZMod (p - 1)) = a) :
    Nonempty ((hk k ⧸ Ideal.span {(p : hk k)}) ≃+* (hk k' ⧸ Ideal.span {(p : hk k')})) := by
  have hc : algebraMap (Iw p) h (PowerSeries.C (p : ℤ_[p])) = (p : h) := by
    rw [show PowerSeries.C (p : ℤ_[p]) = (p : Iw p) from map_natCast _ p, map_natCast]
  have key : ∀ (j : ℕ), (h ⧸ Ideal.span {algebraMap (Iw p) h (Pk p j)}) ≃+* hk j →
      Nonempty ((hk j ⧸ Ideal.span {(p : hk j)}) ≃+*
        (h ⧸ Ideal.map (algebraMap (Iw p) h) (Ideal.span {PowerSeries.C (p : ℤ_[p]), PowerSeries.X}))) := by
    intro j e
    let I := Ideal.span {algebraMap (Iw p) h (Pk p j)}
    have e1 : ((h ⧸ I) ⧸ Ideal.span {(p : h ⧸ I)}) ≃+* (hk j ⧸ Ideal.span {(p : hk j)}) :=
      Ideal.quotientEquiv _ _ e (by rw [Ideal.map_span, Set.image_singleton, map_natCast])
    have hmap : Ideal.span {(p : h ⧸ I)} = (Ideal.span {(p : h)}).map (Ideal.Quotient.mk I) := by
      rw [Ideal.map_span, Set.image_singleton, map_natCast]
    have hid : I ⊔ Ideal.span {(p : h)} =
        Ideal.map (algebraMap (Iw p) h) (Ideal.span {PowerSeries.C (p : ℤ_[p]), PowerSeries.X}) := by
      rw [← ideal_p_Pk p j, Ideal.map_span, Set.image_pair, Ideal.span_insert, hc, sup_comm]
    exact ⟨e1.symm.trans ((Ideal.quotEquivOfEq hmap).trans
      ((DoubleQuot.quotQuotEquivQuotSup I _).trans (Ideal.quotEquivOfEq hid)))⟩
  obtain ⟨ek⟩ := hH.control hp hpN k hk2 hka
  obtain ⟨ek'⟩ := hH.control hp hpN k' hk2' hka'
  obtain ⟨f⟩ := key k ek
  obtain ⟨f'⟩ := key k' ek'
  exact ⟨f.trans f'.symm⟩

/-! ### P20: `rmk:thetaforms` -/

/-- `θ = q d/dq` on `F_ℓ[[q]]`. -/
def thetaQ (p : ℕ) (f : PowerSeries (ZMod p)) : PowerSeries (ZMod p) :=
  PowerSeries.mk fun m => (m : ZMod p) * PowerSeries.coeff m f

/-- **`rmk:thetaforms`(1)**, first sentence: `ker θ = F_ℓ[[q^ℓ]]`. -/
theorem thetaQ_eq_zero_iff (p : ℕ) [Fact p.Prime] (f : PowerSeries (ZMod p)) :
    thetaQ p f = 0 ↔ ∀ m : ℕ, ¬ p ∣ m → PowerSeries.coeff m f = 0 := by
  constructor
  · intro h m hm
    have := congrArg (PowerSeries.coeff m) h
    rw [thetaQ, PowerSeries.coeff_mk, map_zero] at this
    rcases mul_eq_zero.mp this with h0 | h0
    · exact absurd ((ZMod.natCast_eq_zero_iff m p).mp h0) hm
    · exact h0
  · intro h
    ext m
    rw [thetaQ, PowerSeries.coeff_mk, map_zero]
    by_cases hm : p ∣ m
    · rw [(ZMod.natCast_eq_zero_iff m p).mpr hm, zero_mul]
    · rw [h m hm, mul_zero]

/-- **`rmk:thetaforms`(1)**, second sentence: `V(g) := g(q^ℓ) = g^ℓ` on `F_ℓ[[q]]` (Frobenius on coefficients in `F_ℓ`),
so `V(g) ∈ ker θ`. -/
theorem frobenius_eq_V (p : ℕ) [Fact p.Prime] (g : PowerSeries (ZMod p)) :
    (PowerSeries.mk fun m => if p ∣ m then PowerSeries.coeff (m / p) g else 0) = g ^ p := by
  ext m
  rw [PowerSeries.coeff_mk]
  have h1 : PowerSeries.coeff m (g ^ p) = (PowerSeries.trunc (m + 1) (g ^ p)).coeff m := by
    rw [PowerSeries.coeff_trunc, if_pos (Nat.lt_succ_self m)]
  rw [h1, ← PowerSeries.trunc_trunc_pow, PowerSeries.coeff_trunc, if_pos (Nat.lt_succ_self m),
    ← Polynomial.coe_pow, Polynomial.coeff_coe, ← ZMod.expand_card,
    Polynomial.coeff_expand (Fact.out : p.Prime).pos]
  split_ifs with hm
  · rw [PowerSeries.coeff_trunc, if_pos (Nat.lt_succ_of_le (Nat.div_le_self m p))]
  · rfl

end GL2.Sat

