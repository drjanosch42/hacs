noncomputable section

namespace GL2.Sat

open Submodule
open scoped TensorProduct

variable {p : ℕ} [Fact p.Prime]

/-- `M / I M` with `I` an ideal of `ℤ_p`, and the endomorphism an `f : End M` induces on it. -/
def endQ {M : Type*} [AddCommGroup M] [Module ℤ_[p] M] (I : Ideal ℤ_[p]) (f : Module.End ℤ_[p] M) :
    Module.End ℤ_[p] (M ⧸ I • (⊤ : Submodule ℤ_[p] M)) :=
  mapQ _ _ f (map_le_iff_le_comap.mp (by rw [map_smul'']; exact smul_mono_right _ le_top))

variable {L : Type*} [AddCommGroup L] [Module ℤ_[p] L]

/-- `𝕃' = 𝕃 / 𝕃_tors`. -/
abbrev Lfree (L : Type*) [AddCommGroup L] [Module ℤ_[p] L] := L ⧸ Submodule.torsion ℤ_[p] L

/-- An endomorphism of `𝕃` preserves `𝕃_tors`, and induces one of `𝕃'`. -/
def onFree (f : Module.End ℤ_[p] L) : Module.End ℤ_[p] (Lfree (p := p) L) :=
  mapQ _ _ f (by
    intro x hx
    rw [mem_comap, mem_torsion_iff] at *
    obtain ⟨a, ha⟩ := hx
    exact ⟨a, by rw [Submonoid.smul_def] at ha ⊢; rw [← map_smul, ha, map_zero]⟩)

variable {ι : Type*} (X : ι → Module.End ℤ_[p] L)

/-- `T^coh ⊆ End(𝕃)`: the algebra generated by the `T_p`. -/
def Tcoh : Subalgebra ℤ_[p] (Module.End ℤ_[p] L) := Algebra.adjoin ℤ_[p] (Set.range X)

/-- `T^𝕃 ⊆ End(𝕃')`: the algebra generated by the induced `T_p`. -/
def TL : Subalgebra ℤ_[p] (Module.End ℤ_[p] (Lfree (p := p) L)) :=
  Algebra.adjoin ℤ_[p] (Set.range fun i => onFree (X i))

