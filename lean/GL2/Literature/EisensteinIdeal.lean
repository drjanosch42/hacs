import GL2.Literature.Basic

/-!
# L1: Mazur's Eisenstein ideal at prime level (L16-3)

Source: Mazur, *Modular curves and the Eisenstein ideal*, Publ. Math. IHÉS 47 (1977), 33-186
(`papers/m/Mazur/…`, read-only; text layer; the printed page header `96 B. MAZUR` was read).

**Cross-reference (L16-1).** The weight-2 statement is *attested* upstream: Anthropic FLT proves
`ModularCurve.natCard_heckeLatticeAlgebra_quotient_eisensteinIdeal_eq_eisensteinNumerator`
(`|T/I| = num((p-1)/12)`; F-A, closure 1159 theorems, 549k lines;
`lean/survey/flt_harvest_survey.tsv`). Until a machine-checked bridge exists, this structure is the
register's entry, with FLT's name as the replacement target (`lit_flt_attested`).
-/

namespace GL2.Literature

/-- Mazur's `n = numerator((N - 1)/12)`. -/
def mazurN (N : ℕ) : ℕ := ((((N : ℚ) - 1) / 12).num).natAbs

/-- The Eisenstein ideal `𝔍 ⊂ T`: "generated by the elements `1 + ℓ - T_ℓ` (all `ℓ ≠ N`) and by `1 + w`"
(Mazur, II §9, Definition before (9.7), p. 95). `Tl ℓ` is the Hecke operator `T_ℓ`, `w` the Atkin-Lehner
involution. -/
def eisensteinIdeal (N : ℕ) {T : Type*} [CommRing T] (Tl : ℕ → T) (w : T) : Ideal T :=
  Ideal.span ({1 + w} ∪ {x | ∃ l : ℕ, l.Prime ∧ l ≠ N ∧ x = 1 + (l : T) - Tl l})

/-- **Mazur, Chapter II, Proposition (9.7), p. 96.** `VERIFIED` (text layer plus page header).

Quotation: "Proposition (9.7). — 𝕋/𝔍 = ℤ/nℤ; the Eisenstein ideal 𝔍 contains the integer n." with
"N : a fixed prime number ≥ 5 (the level)" and "n : numerator((N-1)/12)" (Conventions, p. 42).

Interface data: `T` is the Hecke algebra `𝕋 = End(J₀(N))`, `Tl` its operators `T_ℓ`, `w` the involution.
(The identification of `𝕋` with a Hecke algebra of `S₂(Γ₀(N))` is Mazur's (9.4) and is not part of this
statement.) Used by: [C] `rmk:levelNcheckable` (LN4), [E] `pr:eiscusp`. -/
structure Mazur97 (N : ℕ) (T : Type*) [CommRing T] (Tl : ℕ → T) (w : T) : Prop where
  quotient : N.Prime → 5 ≤ N → Nonempty (T ⧸ eisensteinIdeal N Tl w ≃+* ZMod (mazurN N))
  contains_n : N.Prime → 5 ≤ N → (mazurN N : T) ∈ eisensteinIdeal N Tl w

/-! ### Sanity instance: `N = 5` (genus 0, `n = num(4/12) = 1`, `𝕋 = 0`) -/

theorem mazurN_five : mazurN 5 = 1 := by
  unfold mazurN
  norm_num

/-- At `N = 5`, `J₀(5) = 0`, `𝕋` is the zero ring and `n = 1`: `Mazur97` holds on `T = ZMod 1`. This checks
that the ring-equivalence `T/𝔍 ≃ ℤ/n` and the membership `n ∈ 𝔍` are mutually consistent at the one level
where everything is decidable. (`N = 11` would need the eigenvalues of `11a`.) -/
theorem mazur97_N5 : Mazur97 5 (ZMod 1) (fun _ => 0) 0 := by
  have hn : mazurN 5 = 1 := mazurN_five
  refine ⟨fun _ _ => ?_, fun _ _ => ?_⟩
  · rw [hn]
    have h1 : Subsingleton (ZMod 1) := inferInstance
    have h2 : Subsingleton (ZMod 1 ⧸ eisensteinIdeal 5 (fun _ => (0 : ZMod 1)) 0) :=
      Function.Surjective.subsingleton (Ideal.Quotient.mk_surjective)
    exact ⟨{ toFun := fun _ => 0, invFun := fun _ => 0,
             left_inv := fun _ => Subsingleton.elim _ _, right_inv := fun _ => Subsingleton.elim _ _,
             map_mul' := fun _ _ => Subsingleton.elim _ _, map_add' := fun _ _ => Subsingleton.elim _ _ }⟩
  · rw [hn]
    exact Subsingleton.elim (1 : ZMod 1) 0 ▸ Ideal.zero_mem _

end GL2.Literature
