import GL2.Literature.Hida

/-!
# L1: Hida's control theorem at tame level 1 and Emerton's Theorem 5 (`hHidaControl`, `hEmertonEis`; L-K9, slot 25)

`docs/implementation/slot24/heckez/07-lean-plan.md` §3 (the rows `hHidaControl`, `hEmertonEis`), §5.9 (the Λ-adic reading of K9);
[GT] `lit:hz-hida-control`, `lit:hz-emerton-eis` (`gt_part_HZL.tex`; quotations read on the **page images** by the LIT agent,
2026-11-04). The LIT rulings applied here:

* **`hHidaControl` carries Hida ENS Thm. 3.1 and (3.3 b) only** — not (3.3 a) (the full algebra, which needs `k ≥ j(a)`), and not
  [U] `prop:u-truncbasic`(2) (a consequence of `hHidaControl` + `hEmertonEis`, to be proved in Lean by L-H0). It is the conjunction of
  the already verified structures `HidaEns31` and `HidaEns32` (rows `lit:hida-ens-3.1`, `lit:hida-ens-3.2`) **at Hida's level
  `N = p`** (tame level `N₀ = 1`, [C] `thm:hidacontrol`(3)): the guard `p ∣ N` of those structures is then automatic, `5 ≤ p` stays.
* **`hEmertonEis` quotes Emerton's Theorem 5** (preprint p. 6): "For any `i (mod p−1)` we denote by `𝔍_{Eis,(i)}` the ideal in
  `𝐓^{ord}_{(i)}` generated by the elements `T_l − 1 − ⟨l⟩l^{−1}` (where `l` ranges over all primes distinct from `p`) together with
  the element `U_p − 1`. … We let `𝔍′_{Eis,(i)}` denote the image of the ideal `𝔍_{Eis}` in `𝐓^{ord}_{par,(i)}`. Theorem 5. Suppose
  that `i ≢ 0 (mod p−1)`. Then the pullback of `𝔍′_{Eis,(i)}` via the natural map `Λ_(i) → 𝐓^{ord}_{par,(i)}` is equal to the principal
  ideal of `Λ_(i)` generated by the Kubota-Leopoldt `p`-adic `L`-function `L_p(ω^i, 1−s)`, and the consequent injection
  `Λ_(i)/L_p(ω^i, 1−s) → 𝐓^{ord}_{par,(i)}/𝔍′_{Eis,(i)}` is an isomorphism." Standing hypothesis p. 1: "Let us fix a prime number
  `p ≥ 5`"; tame level one. Compared with `EmertonThm` (row `lit:emerton`, the Introduction's statement with an arbitrary ideal `I`),
  the ideal here is **defined** from the operators, as on p. 6: `emertonEisIdeal p Tl dl Up` is generated by `T_l − 1 − d_l`
  (`l ≠ p` prime; `d_l` the image of `⟨l⟩l^{−1}`) and `U_p − 1`. The derivation of [U] `pr:u-U1` (`C_Eis(a) = Λ/(G_a)`,
  `L_k = v(B_k/k)`) from Theorem 5 — with [U] `lem:u-emerton`(4) identifying `L_p(ω^a, 1−s)` with `G_a` — is L-H0's, not done here.

**Interface data** (as in `GL2.Literature.Hida`): the ordinary Hecke algebras and their operators are parameters, constrained only
by the shape of the quoted statements; nothing identifies them with objects computed by the C++. **No theorem of the project uses
these two structures yet** (07 §5.9: the Λ-adic reading of K9 is `proved_mod_lit` only after L-H0). The sanity instances show that
the structures are satisfiable (no vacuous literature input).
-/

namespace GL2.Literature

/-- **`hHidaControl`** — Hida (ENS 1986) Thm. 3.1 and Cor. 3.2 (3.3 b) at Hida's level `N = p` (tame level 1). Interface data:
`h` is the cuspidal ordinary algebra `𝔥₀(p, a; ℤ_p)` as a `Λ`-algebra, `hk k` the weight-`k` ordinary cuspidal Hecke algebra
`𝔥⁰_k(Γ₁(p), a; ℤ_p)`, `ordRank k` the `ℤ_p`-rank of the weight-`k` ordinary cusp forms. Used by: L-H0 (later), the Λ-adic reading of
K9 ([U] `prop:u-H11`, `prop:u-H12`(1)–(3)). -/
structure HidaControl (p : ℕ) [Fact p.Prime] (a : ZMod (p - 1)) (h : Type*) [CommRing h] [Algebra (Iw p) h]
    (hk : ℕ → Type*) [∀ k, CommRing (hk k)] (ordRank : ℕ → ℕ) : Prop where
  /-- Thm. 3.1 at `N = p`: freeness, finiteness, the rank -/
  thm31 : HidaEns31 p p a h ordRank
  /-- Cor. 3.2 (3.3 b) at `N = p`: control -/
  cor32b : HidaEns32 p p a h hk

/-- The ideal of Emerton's p. 6: generated by `T_l − 1 − d_l` (`l ≠ p` prime; `d_l` the image of `⟨l⟩l^{−1}`) and `U_p − 1`. -/
def emertonEisIdeal (p : ℕ) {T : Type*} [CommRing T] (Tl dl : ℕ → T) (Up : T) : Ideal T :=
  Ideal.span ({x | ∃ l : ℕ, l.Prime ∧ l ≠ p ∧ x = Tl l - 1 - dl l} ∪ {Up - 1})

/-- **`hEmertonEis`** — Emerton, *The Eisenstein ideal in Hida's ordinary Hecke algebra*, Theorem 5 (p. 6), tame level one,
`p ≥ 5`, for the Eisenstein ideal **defined** from the operators (`emertonEisIdeal`). Interface data: `T` is
`𝐓^{ord}_{par,(i)}` as a `Λ_(i)`-algebra, `Tl l`, `dl l`, `Up` the images of `T_l`, `⟨l⟩l^{−1}`, `U_p`, and `Lp` the element of
`Λ_(i)` for `L_p(ω^i, 1−s)`. Used by: L-H0 (later; [U] `pr:u-U1`, `lem:u-emerton`). -/
structure EmertonEis (p : ℕ) [Fact p.Prime] (i : ℕ) (T : Type*) [CommRing T] [Algebra (Iw p) T] (Tl dl : ℕ → T) (Up : T)
    (Lp : Iw p) : Prop where
  /-- Theorem 5 for `emertonEisIdeal` -/
  thm5 : EmertonThm p i T (emertonEisIdeal p Tl dl Up) Lp

/-- Sanity: `hHidaControl` is satisfiable — the rank-one model `h = Λ`, `hk k = Λ/(P_k)`, `ordRank = 1`. -/
theorem hidaControl_rankOne (p : ℕ) [Fact p.Prime] (a : ZMod (p - 1)) :
    HidaControl p a (Iw p) (fun k => Iw p ⧸ Ideal.span {Pk p k}) (fun _ => 1) := by
  refine ⟨⟨fun _ _ => ⟨inferInstance, inferInstance⟩, fun _ _ k _ _ => Module.finrank_self (Iw p)⟩,
    ⟨fun _ _ k _ _ => ⟨Ideal.quotEquivOfEq ?_⟩⟩⟩
  rfl

/-- Sanity: `hEmertonEis` is satisfiable — the rank-one model `T = Λ`, `T_l = 1 + L`, `d_l = 0`, `U_p = 1 + L`, for any `L`. -/
theorem emertonEis_rankOne (p : ℕ) [Fact p.Prime] (i : ℕ) (L : Iw p) :
    EmertonEis p i (Iw p) (fun _ => 1 + L) (fun _ => 0) (1 + L) L := by
  have hI : emertonEisIdeal p (fun _ => 1 + L) (fun _ => (0 : Iw p)) (1 + L) = Ideal.span {L} := by
    unfold emertonEisIdeal
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro x (⟨l, -, -, rfl⟩ | hx)
      · simp
      · rw [Set.mem_singleton_iff] at hx; rw [hx]; simp
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.subset_span (Or.inr (by simp))
  refine ⟨⟨fun _ _ => ?_, fun _ _ => ?_⟩⟩
  · rw [hI]; exact Ideal.comap_id _
  · exact Ideal.Quotient.mk_surjective

end GL2.Literature
