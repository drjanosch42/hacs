import Mathlib
import GL2.Saturation.LevelOne

/-!
# L3-b(2): the `stable`-certificate checker (L17-2)

[GT] `chk:stablecert`, mirroring [C] `cor:stablecert`(1) (the B1 form), `prop:saturation`(3), and the C++
`hecke_ext::ringalg::CertifyStable` (slot-15 WP-5) whose verdict it re-checks.

**What a certificate is.** A `SatCert` is the dump of `HECKE_DUMP_SAT_CERT` (`HeckeSatCertDumpValidation`, L17-2)
for one torsion-free block `e_m M_K` with a `stable` verdict at level `K`, completed by an *untrusted* witness
generator (`lean/tools/satcert_to_lean.py`):

* `p = ℓ`, `K`, `f` (the free rank of the block, so the block is `(ℤ/ℓ^K)^f`), and `gens`: the dumped `f × f`
  matrices of the `T_q`, `q ∈ S`, on the block, column convention (`T b_j = Σ_i A_{ij} b_i`), entries mod `ℓ^K`;
* `prog`: a straight-line program of matrices, each the identity, a generator, or the product of two earlier ones,
  stored explicitly (so the kernel checks one product per step);
* `wits`: `r` witnesses `W_i = Σ_k c_{ik} P_k`, stored explicitly, each with a pivot position.

**The predicate `SatSpec`** (decided by `satCheck`, `satCheck_sound`): `r = ⌈f/2⌉`, `K ≥ 1`, and every `W_i` lies
in the subsemiring of `M_f(ℤ/ℓ^K)` generated by the `T_q` (i.e. in `𝖠'_K`), is killed by `ℓ`, and the witnesses are
in **pivot form**: `W_i` at the pivot of `W_j` is `δ_{ij} ℓ^{K-1}`.

**Soundness (`stable_of_spec`).** For the abstract data of `GL2.Sat.stablecert` (`Te` acting faithfully on a free
`Le` with `rank Te = ⌈rank Le / 2⌉` -- the hypothesis `hrank`, i.e. [C] `lem:heckerankone` (proved modulo Eichler--Shimura in L18-4; instantiated at `Te = e T^𝕃` by `stable_of_spec_ES`, L19-1, which carries `hES` instead)
and is **carried** here exactly as `stablecert` carries it -- and `T' ↪ Te`), if the reduction of `Le` mod
`ℓ^K` is identified, `ℤ_ℓ`-semilinearly, with `(ℤ/ℓ^K)^f` so that given elements `g_q ∈ T'` act by the dumped
matrices (**the trust boundary**: that the dumped matrices are the `T_q` on `e_m 𝕃 / ℓ^K` is the C++ module run,
[C] `cl:bockstein`; it is an input, not re-proved), and `rank Le = f`, then `SatSpec` implies:
`dim 𝖠'_K/ℓ = ⌈f/2⌉`, `rank T' = rank Te`, and `T'/ℓ → 𝖠'_{K'}/ℓ` is injective (an isomorphism) at every
`K' ≥ K` -- the conclusion of [C] `cor:stablecert`(1).

*Why this is enough.* The witnesses give `r` elements of `𝖠'_K[ℓ]` that are independent over `F_ℓ`, so
`length 𝖠'_K[ℓ] = length 𝖠'_K/ℓ ≥ r` (`length_torsionBy_eq`); the upper bound `≤ rank T' ≤ rank Te = r` is
`stopping_rule` and `hrank`. No generation statement for `T'` is needed (the generation certificate,
[C] `cor:stablecert`(2), is `stablecert_generation` and is not what this checker certifies).

No `native_decide`: the data theorems (`GL2.SatChk.Data`) run `decide +kernel`.
-/

noncomputable section

namespace GL2.SatChk

/-! ### The data and the executable checker -/

/-- One step of the straight-line program. -/
inductive Step where
  | one
  | gen (j : ℕ)
  | mul (a b : ℕ)
  deriving Repr, DecidableEq, Inhabited

/-- A witness: coefficients over the program, the claimed matrix, and its pivot position `(row, col)`. -/
structure Witness where
  coeffs : List ℕ
  rows : List (List ℕ)
  pos : ℕ × ℕ
  deriving Repr, Inhabited

/-- A `stable` certificate: the dumped block (`p`, `K`, `f`, `gens`) and the untrusted witness data. -/
structure SatCert where
  n : ℕ
  p : ℕ
  K : ℕ
  f : ℕ
  system : List ℕ
  primes : List ℕ
  gens : List (List (List ℕ))
  prog : List (Step × List (List ℕ))
  wits : List Witness
  deriving Repr

/-- Entry `(i, j)` of a list matrix (`0` when absent). -/
def entry (M : List (List ℕ)) (i j : ℕ) : ℕ := (M.getD i []).getD j 0

/-- `Σ_{l < f} A_{il} B_{lj}` over `ℕ`. -/
def mulEntry (f : ℕ) (A B : List (List ℕ)) (i j : ℕ) : ℕ :=
  ((List.range f).map fun l => entry A i l * entry B l j).sum

/-- `∀ i j < f, P i j`. -/
def allFin (f : ℕ) (P : ℕ → ℕ → Bool) : Bool :=
  (List.range f).all fun i => (List.range f).all fun j => P i j

/-- The modulus `p^K`. -/
def SatCert.m (c : SatCert) : ℕ := c.p ^ c.K

/-- The `k`-th program matrix. -/
def SatCert.P (c : SatCert) (k : ℕ) : List (List ℕ) := (c.prog.getD k default).2

/-- The `i`-th witness. -/
def SatCert.w (c : SatCert) (i : ℕ) : Witness := c.wits.getD i default

/-- `r`, the number of witnesses. -/
def SatCert.r (c : SatCert) : ℕ := c.wits.length

/-- One program step is correct mod `m`. -/
def stepOK (c : SatCert) (k : ℕ) : Bool :=
  match (c.prog.getD k default).1 with
  | .one => allFin c.f fun i j => entry (c.P k) i j % c.m == (if i = j then 1 else 0) % c.m
  | .gen j => decide (j < c.gens.length) &&
      allFin c.f fun i l => entry (c.P k) i l % c.m == entry (c.gens.getD j []) i l % c.m
  | .mul a b => decide (a < k) && decide (b < k) &&
      allFin c.f fun i j => entry (c.P k) i j % c.m == mulEntry c.f (c.P a) (c.P b) i j % c.m

/-- `Σ_k c_k (P_k)_{ij}` over `ℕ`. -/
def combEntry (c : SatCert) (w : Witness) (i j : ℕ) : ℕ :=
  ((List.range c.prog.length).map fun k => w.coeffs.getD k 0 * entry (c.P k) i j).sum

/-- One witness is correct: it is the stated combination, killed by `p`, its pivot inside the matrix. -/
def witOK (c : SatCert) (w : Witness) : Bool :=
  (allFin c.f fun i j => entry w.rows i j % c.m == combEntry c w i j % c.m) &&
  (allFin c.f fun i j => c.p * entry w.rows i j % c.m == 0) &&
  decide (w.pos.1 < c.f) && decide (w.pos.2 < c.f)

/-- The pivot form: `W_i` at the pivot of `W_j` is `δ_{ij} p^{K-1}`. -/
def pivotOK (c : SatCert) : Bool :=
  (List.range c.r).all fun i => (List.range c.r).all fun j =>
    entry (c.w i).rows (c.w j).pos.1 (c.w j).pos.2 % c.m == (if i = j then c.p ^ (c.K - 1) else 0) % c.m

/-- **The checker.** -/
def satCheck (c : SatCert) : Bool :=
  decide (1 ≤ c.K) && c.r == (c.f + 1) / 2 &&
  (List.range c.prog.length).all (stepOK c) &&
  c.wits.all (witOK c) && pivotOK c

/-! ### The specification -/

/-- A list matrix read in `M_f(ℤ/m)`. -/
def toMat (f m : ℕ) (M : List (List ℕ)) : Matrix (Fin f) (Fin f) (ZMod m) :=
  Matrix.of fun i j => (entry M i j : ZMod m)

/-- The dumped generators, read in `M_f(ℤ/p^K)`. -/
def genSet (c : SatCert) : Set (Matrix (Fin c.f) (Fin c.f) (ZMod c.m)) :=
  (fun j => toMat c.f c.m (c.gens.getD j [])) '' {j | j < c.gens.length}

/-- The `i`-th witness, read in `M_f(ℤ/p^K)`. -/
def wMat (c : SatCert) (i : ℕ) : Matrix (Fin c.f) (Fin c.f) (ZMod c.m) := toMat c.f c.m (c.w i).rows

/-- **`SatSpec`**: `r = ⌈f/2⌉`, `K ≥ 1`, and `r` elements of the algebra generated by the dumped `T_q`, killed by
`p`, in pivot form. -/
structure SatSpec (c : SatCert) : Prop where
  hK : 1 ≤ c.K
  hr : c.r = (c.f + 1) / 2
  mem : ∀ i < c.r, wMat c i ∈ Subsemiring.closure (genSet c)
  tors : ∀ i < c.r, (c.p : ZMod c.m) • wMat c i = 0
  pos_lt : ∀ i < c.r, (c.w i).pos.1 < c.f ∧ (c.w i).pos.2 < c.f
  pivot : ∀ i < c.r, ∀ j < c.r,
    ((entry (c.w i).rows (c.w j).pos.1 (c.w j).pos.2 : ℕ) : ZMod c.m) =
      if i = j then (c.p : ZMod c.m) ^ (c.K - 1) else 0

/-! ### Soundness of the checker -/

lemma list_sum_range_map' {M : Type*} [AddCommMonoid M] (g : ℕ → M) (k : ℕ) :
    ((List.range k).map g).sum = ∑ i ∈ Finset.range k, g i := by
  induction k with
  | zero => simp
  | succ k ih => rw [List.range_succ, List.map_append, List.sum_append, ih, Finset.sum_range_succ]; simp

lemma allFin_iff (f : ℕ) (P : ℕ → ℕ → Bool) : allFin f P = true ↔ ∀ i < f, ∀ j < f, P i j = true := by
  simp [allFin, List.all_eq_true, List.mem_range]

lemma cast_eq_of_mod {m a b : ℕ} (h : (a % m == b % m) = true) : (a : ZMod m) = (b : ZMod m) := by
  rw [ZMod.natCast_eq_natCast_iff']; simpa using h

lemma toMat_ext {f m : ℕ} {M : List (List ℕ)} {X : Matrix (Fin f) (Fin f) (ZMod m)}
    (h : ∀ i j : Fin f, (entry M i j : ZMod m) = X i j) : toMat f m M = X := by
  ext i j; exact h i j

lemma toMat_mul (f m : ℕ) (A B : List (List ℕ)) (i j : Fin f) :
    (toMat f m A * toMat f m B) i j = ((mulEntry f A B i j : ℕ) : ZMod m) := by
  simp only [Matrix.mul_apply, toMat, Matrix.of_apply, mulEntry, list_sum_range_map', Nat.cast_sum,
    Nat.cast_mul]
  exact (Fin.sum_univ_eq_sum_range (fun l => (entry A i l : ZMod m) * (entry B l j : ZMod m)) f)

/-- Every program matrix lies in the subsemiring generated by the dumped generators. -/
theorem prog_mem (c : SatCert) (hprog : (List.range c.prog.length).all (stepOK c) = true) :
    ∀ k < c.prog.length, toMat c.f c.m (c.P k) ∈ Subsemiring.closure (genSet c) := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
  intro hk
  have hs : stepOK c k = true := List.all_eq_true.mp hprog k (List.mem_range.mpr hk)
  unfold stepOK at hs
  split at hs
  · have : toMat c.f c.m (c.P k) = 1 := toMat_ext fun i j => by
      have := (allFin_iff _ _).mp hs i i.2 j j.2
      rw [cast_eq_of_mod this, Matrix.one_apply]
      by_cases hij : i = j
      · subst hij; simp
      · have : (i : ℕ) ≠ j := fun h => hij (Fin.ext h)
        simp [hij, this]
    rw [this]; exact Subsemiring.one_mem _
  · rename_i j _
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hs
    have : toMat c.f c.m (c.P k) = toMat c.f c.m (c.gens.getD j []) := toMat_ext fun i l => by
      rw [cast_eq_of_mod ((allFin_iff _ _).mp hs.2 i i.2 l l.2)]; rfl
    rw [this]; exact Subsemiring.subset_closure ⟨j, hs.1, rfl⟩
  · rename_i a b _
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hs
    obtain ⟨⟨ha, hb⟩, hent⟩ := hs
    have : toMat c.f c.m (c.P k) = toMat c.f c.m (c.P a) * toMat c.f c.m (c.P b) := toMat_ext fun i j => by
      rw [cast_eq_of_mod ((allFin_iff _ _).mp hent i i.2 j j.2), toMat_mul]
    rw [this]
    exact Subsemiring.mul_mem _ (ih a ha (by omega)) (ih b hb (by omega))

/-- **Soundness of the checker**: `satCheck c = true → SatSpec c`. -/
theorem satCheck_sound (c : SatCert) (h : satCheck c = true) : SatSpec c := by
  simp only [satCheck, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
  obtain ⟨⟨⟨⟨hK, hr⟩, hprog⟩, hwits⟩, hpiv⟩ := h
  have hw : ∀ i < c.r, witOK c (c.w i) = true := fun i hi =>
    List.all_eq_true.mp hwits _ (by simp only [SatCert.w]; rw [List.getD_eq_getElem _ _ hi]; exact List.getElem_mem hi)
  have hpm := prog_mem c hprog
  refine ⟨hK, hr, fun i hi => ?_, fun i hi => ?_, fun i hi => ?_, fun i hi j hj => ?_⟩
  · have h1 := hw i hi
    simp only [witOK, Bool.and_eq_true, decide_eq_true_eq] at h1
    have : wMat c i = ∑ k ∈ Finset.range c.prog.length,
        ((c.w i).coeffs.getD k 0 : ZMod c.m) • toMat c.f c.m (c.P k) := toMat_ext fun a b => by
      rw [cast_eq_of_mod ((allFin_iff _ _).mp h1.1.1.1 a a.2 b b.2)]
      simp only [combEntry, list_sum_range_map', Nat.cast_sum, Nat.cast_mul, Matrix.sum_apply,
        Matrix.smul_apply, toMat, Matrix.of_apply, smul_eq_mul]
    rw [this]
    refine Subsemiring.sum_mem _ fun k hk => ?_
    rw [Nat.cast_smul_eq_nsmul]
    exact nsmul_mem (hpm k (Finset.mem_range.mp hk)) _
  · have h1 := hw i hi
    simp only [witOK, Bool.and_eq_true, decide_eq_true_eq] at h1
    ext a b
    have := (allFin_iff _ _).mp h1.1.1.2 a a.2 b b.2
    have h0 : ((c.p * entry (c.w i).rows a b : ℕ) : ZMod c.m) = ((0 : ℕ) : ZMod c.m) := cast_eq_of_mod (by simpa using this)
    simpa [wMat, toMat] using h0
  · have h1 := hw i hi
    simp only [witOK, Bool.and_eq_true, decide_eq_true_eq] at h1
    exact ⟨h1.1.2, h1.2⟩
  · have := List.all_eq_true.mp (List.all_eq_true.mp hpiv i (List.mem_range.mpr hi)) j (List.mem_range.mpr hj)
    rw [cast_eq_of_mod this]
    split_ifs <;> simp

/-! ### Soundness of the certificate: `SatSpec` ⇒ [C] `cor:stablecert`(1) -/

section Bridge

open GL2.Sat Submodule Matrix
open scoped Pointwise

variable {p : ℕ} [Fact p.Prime] {Le : Type*} [AddCommGroup Le] [Module ℤ_[p] Le]
  {T' : Type*} [CommRing T'] [Algebra ℤ_[p] T'] (A : T' →ₐ[ℤ_[p]] Module.End ℤ_[p] Le) {K f : ℕ}
  (β : (Le ⧸ (pI p ^ K) • (⊤ : Submodule ℤ_[p] Le)) ≃+ (Fin f → ZMod (p ^ K)))

/-- `t ∈ T'` acts on `Le / p^K Le`, read through `β`, by the matrix `W`. -/
def Realizes (t : T') (W : Matrix (Fin f) (Fin f) (ZMod (p ^ K))) : Prop :=
  ∀ x : Le, β (Submodule.Quotient.mk (A t x)) = W *ᵥ β (Submodule.Quotient.mk x)

lemma realizes_one : Realizes A β 1 1 := fun x => by simp

lemma realizes_zero : Realizes A β 0 0 := fun x => by simp

lemma realizes_add {t s : T'} {W V : Matrix (Fin f) (Fin f) (ZMod (p ^ K))} (ht : Realizes A β t W)
    (hs : Realizes A β s V) : Realizes A β (t + s) (W + V) := fun x => by
  rw [map_add, LinearMap.add_apply, Submodule.Quotient.mk_add, map_add, ht x, hs x, Matrix.add_mulVec]

lemma realizes_mul {t s : T'} {W V : Matrix (Fin f) (Fin f) (ZMod (p ^ K))} (ht : Realizes A β t W)
    (hs : Realizes A β s V) : Realizes A β (t * s) (W * V) := fun x => by
  rw [map_mul, Module.End.mul_apply, ht, hs, Matrix.mulVec_mulVec]

lemma realizes_smul (hβ : ∀ (a : ℤ_[p]) y, β (a • y) = PadicInt.toZModPow K a • β y) (a : ℤ_[p]) {t : T'}
    {W : Matrix (Fin f) (Fin f) (ZMod (p ^ K))} (ht : Realizes A β t W) :
    Realizes A β (a • t) (PadicInt.toZModPow K a • W) := fun x => by
  rw [map_smul, LinearMap.smul_apply, Submodule.Quotient.mk_smul, hβ, ht, Matrix.smul_mulVec]

lemma realizes_sum (hβ : ∀ (a : ℤ_[p]) y, β (a • y) = PadicInt.toZModPow K a • β y) {ι : Type*}
    (s : Finset ι) (v : ι → ℤ_[p]) (t : ι → T') (W : ι → Matrix (Fin f) (Fin f) (ZMod (p ^ K)))
    (h : ∀ i ∈ s, Realizes A β (t i) (W i)) :
    Realizes A β (∑ i ∈ s, v i • t i) (∑ i ∈ s, PadicInt.toZModPow K (v i) • W i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using realizes_zero A β
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha]
    exact realizes_add A β (realizes_smul A β hβ _ (h a (Finset.mem_insert_self a s)))
      (ih fun i hi => h i (Finset.mem_insert_of_mem hi))

/-- The kernel of `T' → End(Le/p^K)`, read through `β`: `t ∈ kerK A K ↔ W = 0`. -/
lemma mem_kerK_iff_of_realizes {t : T'} {W : Matrix (Fin f) (Fin f) (ZMod (p ^ K))} (ht : Realizes A β t W) :
    t ∈ kerK A K ↔ W = 0 := by
  rw [mem_kerK]
  constructor
  · intro h
    have hz : ∀ u, W *ᵥ u = 0 := fun u => by
      obtain ⟨y, rfl⟩ := β.surjective u
      obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ y
      rw [← ht, (Submodule.Quotient.mk_eq_zero _).mpr (h x), map_zero]
    ext i j
    have := congrFun (hz (Pi.single j 1)) i
    rw [Matrix.mulVec_single_one] at this
    simpa using this
  · intro hW x
    have : β (Submodule.Quotient.mk (A t x)) = 0 := by rw [ht, hW, Matrix.zero_mulVec]
    exact (Submodule.Quotient.mk_eq_zero _).mp (β.injective (by rw [this, map_zero]))

/-- Every element of the subsemiring generated by matrices realised by elements of `T'` is realised. -/
lemma realizes_of_mem_closure {S : Set (Matrix (Fin f) (Fin f) (ZMod (p ^ K)))}
    (hS : ∀ W ∈ S, ∃ t, Realizes A β t W) {W : Matrix (Fin f) (Fin f) (ZMod (p ^ K))}
    (hW : W ∈ Subsemiring.closure S) : ∃ t, Realizes A β t W := by
  induction hW using Subsemiring.closure_induction with
  | mem W h => exact hS W h
  | zero => exact ⟨0, realizes_zero A β⟩
  | one => exact ⟨1, realizes_one A β⟩
  | add W V _ _ hW hV =>
    obtain ⟨t, ht⟩ := hW; obtain ⟨s, hs⟩ := hV; exact ⟨t + s, realizes_add A β ht hs⟩
  | mul W V _ _ hW hV =>
    obtain ⟨t, ht⟩ := hW; obtain ⟨s, hs⟩ := hV; exact ⟨t * s, realizes_mul A β ht hs⟩

/-- `v · p^{K-1} ↦ 0` in `ℤ/p^K` forces `p ∣ v` in `ℤ_p`. -/
lemma dvd_of_toZModPow_mul_eq_zero (hK : 1 ≤ K) (v : ℤ_[p])
    (h : PadicInt.toZModPow K v * (p : ZMod (p ^ K)) ^ (K - 1) = 0) : ∃ c : ℤ_[p], v = (p : ℤ_[p]) • c := by
  have h' : v * (p : ℤ_[p]) ^ (K - 1) ∈ RingHom.ker (PadicInt.toZModPow K : ℤ_[p] →+* ZMod (p ^ K)) := by
    rw [RingHom.mem_ker, map_mul, map_pow, map_natCast]; exact h
  rw [PadicInt.ker_toZModPow, Ideal.mem_span_singleton] at h'
  obtain ⟨c, hc⟩ := h'
  refine ⟨c, mul_right_cancel₀ (pZp_pow_ne_zero (p := p) (K - 1)) ?_⟩
  rw [hc, smul_eq_mul, mul_assoc, mul_comm c, ← mul_assoc, ← pow_succ', Nat.sub_add_cancel hK]

/-- **The lower bound.** `r` elements of `T'` realising `p`-torsion matrices in pivot form give
`length(𝖠_K/p) ≥ r`. -/
theorem le_length_of_pivots [Module.Finite ℤ_[p] T'] (hK : 1 ≤ K)
    (hβ : ∀ (a : ℤ_[p]) y, β (a • y) = PadicInt.toZModPow K a • β y) {r : ℕ} (t : Fin r → T')
    (W : Fin r → Matrix (Fin f) (Fin f) (ZMod (p ^ K))) (ht : ∀ i, Realizes A β (t i) (W i))
    (htors : ∀ i, (p : ZMod (p ^ K)) • W i = 0) (pos : Fin r → Fin f × Fin f)
    (hpiv : ∀ i j, W i (pos j).1 (pos j).2 = if i = j then (p : ZMod (p ^ K)) ^ (K - 1) else 0) :
    (r : ℕ∞) ≤ Module.length ℤ_[p] (AK A K ⧸ pI p • (⊤ : Submodule ℤ_[p] (AK A K))) := by
  classical
  set φ : (Fin r → ℤ_[p]) →ₗ[ℤ_[p]] AK A K :=
    ∑ i, (LinearMap.proj i : (Fin r → ℤ_[p]) →ₗ[ℤ_[p]] ℤ_[p]).smulRight (Submodule.Quotient.mk (t i)) with hφ
  have hφv : ∀ v, φ v = Submodule.Quotient.mk (∑ i, v i • t i) := fun v => by
    rw [← Submodule.mkQ_apply, map_sum]
    simp [hφ, LinearMap.sum_apply]
  have hreal : ∀ v : Fin r → ℤ_[p],
      Realizes A β (∑ i, v i • t i) (∑ i, PadicInt.toZModPow K (v i) • W i) := fun v =>
    realizes_sum A β hβ Finset.univ v t W fun i _ => ht i
  have hker : LinearMap.ker φ = pI p • (⊤ : Submodule ℤ_[p] (Fin r → ℤ_[p])) := by
    ext v
    rw [LinearMap.mem_ker, hφv, Submodule.Quotient.mk_eq_zero, mem_kerK_iff_of_realizes A β (hreal v),
      mem_pI_smul_top]
    constructor
    · intro h0
      have hc : ∀ j, ∃ c : ℤ_[p], v j = (p : ℤ_[p]) • c := fun j => by
        refine dvd_of_toZModPow_mul_eq_zero hK (v j) ?_
        have := congrFun (congrFun h0 (pos j).1) (pos j).2
        simp only [Matrix.sum_apply, Matrix.smul_apply, hpiv, smul_eq_mul, mul_ite, mul_zero,
          Finset.sum_ite_eq', Finset.mem_univ, if_true, Matrix.zero_apply] at this
        exact this
      choose c hc using hc
      exact ⟨c, funext fun j => by rw [hc j]; rfl⟩
    · rintro ⟨y, rfl⟩
      have : ∀ i, PadicInt.toZModPow K (((p : ℤ_[p]) • y) i) • W i = 0 := fun i => by
        rw [Pi.smul_apply, smul_eq_mul, map_mul, map_natCast, mul_comm, mul_smul, htors, smul_zero]
      exact Finset.sum_eq_zero fun i _ => this i
  -- the image of `φ` is `p`-torsion
  have hrange : LinearMap.range φ ≤ Submodule.torsionBy ℤ_[p] (AK A K) (p : ℤ_[p]) := by
    rintro _ ⟨v, rfl⟩
    rw [Submodule.mem_torsionBy_iff, ← map_smul]
    exact LinearMap.mem_ker.mp (by rw [hker, mem_pI_smul_top]; exact ⟨v, rfl⟩)
  -- `𝖠_K` has finite length: finite, killed by `p^K`
  have hfin : Module.length ℤ_[p] (AK A K) ≠ ⊤ := by
    refine length_ne_top_of_killed K fun x => ?_
    obtain ⟨s, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, mem_kerK]
    intro v
    rw [map_smul, LinearMap.smul_apply, mem_pI_pow_smul_top]
    exact ⟨_, rfl⟩
  have hdom : Module.length ℤ_[p] ((Fin r → ℤ_[p]) ⧸ pI p • (⊤ : Submodule ℤ_[p] (Fin r → ℤ_[p]))) = r := by
    have h := length_free_quot (p := p) (Fin r → ℤ_[p]) 1
    rw [pow_one, one_mul, Module.finrank_fin_fun] at h
    exact h
  have e : pI p • (⊤ : Submodule ℤ_[p] (AK A K)) = (p : ℤ_[p]) • ⊤ := by
    simpa using pI_pow_smul_top (M := AK A K) 1
  rw [← hdom, e, ← length_torsionBy_eq (p : ℤ_[p]) hfin, ← hker]
  calc Module.length ℤ_[p] ((Fin r → ℤ_[p]) ⧸ LinearMap.ker φ)
      = Module.length ℤ_[p] (LinearMap.range φ) := (φ.quotKerEquivRange).length_eq
    _ ≤ Module.length ℤ_[p] (Submodule.torsionBy ℤ_[p] (AK A K) (p : ℤ_[p])) :=
        Module.length_le_of_injective (Submodule.inclusion hrange) (Submodule.inclusion_injective hrange)

/-- **Soundness of the `stable` certificate** ([GT] `chk:stablecert`): `SatSpec c` for the dumped block, with the
dumped matrices realised by `g_q ∈ T'` on `Le / p^K` (the trust boundary) and `rank Le = f`, gives the conclusion of
[C] `cor:stablecert`(1) at `K`: `dim 𝖠'_K/ℓ = ⌈f/2⌉`, `rank T' = rank Te`, and `T'/ℓ ≅ 𝖠'_{K'}/ℓ` for all `K' ≥ K`.
The hypothesis `hrank` is [C] `lem:heckerankone` (`GL2.Sat.heckerankone`), carried as in `GL2.Sat.stablecert`; `stable_of_spec_ES` discharges it at `Te = e T^𝕃`. -/
theorem stable_of_spec {Le : Type*} [AddCommGroup Le] [Module ℤ_[p] Le] [Module.Free ℤ_[p] Le]
    [Module.Finite ℤ_[p] Le] {Te : Type*} [CommRing Te] [Algebra ℤ_[p] Te]
    (act : Te →ₐ[ℤ_[p]] Module.End ℤ_[p] Le) (hact : Function.Injective act)
    (hrank : rk (p := p) (T := Te) = (Module.finrank ℤ_[p] Le + 1) / 2)
    {T' : Type*} [CommRing T'] [Algebra ℤ_[p] T'] (ι' : T' →ₐ[ℤ_[p]] Te) (hι : Function.Injective ι')
    (c : SatCert) (hc : SatSpec c) (hp : c.p = p) (hf : Module.finrank ℤ_[p] Le = c.f)
    (β : (Le ⧸ (pI p ^ c.K) • (⊤ : Submodule ℤ_[p] Le)) ≃+ (Fin c.f → ZMod (p ^ c.K)))
    (hβ : ∀ (a : ℤ_[p]) y, β (a • y) = PadicInt.toZModPow c.K a • β y)
    (g : ℕ → T')
    (hg : ∀ j < c.gens.length, Realizes (act.comp ι') β (g j) (toMat c.f (p ^ c.K) (c.gens.getD j []))) :
    Module.length ℤ_[p] (AK (act.comp ι') c.K ⧸ pI p • (⊤ : Submodule ℤ_[p] (AK (act.comp ι') c.K))) =
        ((Module.finrank ℤ_[p] Le + 1) / 2 : ℕ) ∧
      rk (p := p) (T := T') = rk (p := p) (T := Te) ∧
      ∀ K', c.K ≤ K' → Function.Injective (redMap (act.comp ι') K') := by
  subst hp
  have hinj : Function.Injective (act.comp ι') := hact.comp hι
  have := finite_T act hact
  have := free_T act hact
  have := finite_T (act.comp ι') hinj
  have := free_T (act.comp ι') hinj
  have hle : rk (p := c.p) (T := T') ≤ rk (p := c.p) (T := Te) :=
    LinearMap.finrank_le_finrank_of_injective (f := ι'.toLinearMap) hι
  -- every element of the generated subsemiring is realised
  have hS : ∀ W ∈ genSet c, ∃ t, Realizes (act.comp ι') β t W := by
    rintro _ ⟨j, hj, rfl⟩; exact ⟨g j, hg j hj⟩
  have hreal : ∀ i : Fin c.r, ∃ t, Realizes (act.comp ι') β t (wMat c i) := fun i =>
    realizes_of_mem_closure (act.comp ι') β hS (hc.mem i i.2)
  choose t ht using hreal
  have hlow := le_length_of_pivots (act.comp ι') β hc.hK hβ t (fun i => wMat c i) ht
    (fun i => hc.tors i i.2)
    (fun j => (⟨(c.w j).pos.1, (hc.pos_lt j j.2).1⟩, ⟨(c.w j).pos.2, (hc.pos_lt j j.2).2⟩))
    (fun i j => by
      have := hc.pivot i i.2 j j.2
      simp only [Fin.val_inj] at this
      exact this)
  have hup := (stopping_rule (act.comp ι') hinj c.K hc.hK).1
  have hr : (c.r : ℕ∞) = ((Module.finrank ℤ_[c.p] Le + 1) / 2 : ℕ) := by rw [hc.hr, hf]
  rw [hr] at hlow
  have heq : Module.length ℤ_[c.p] (AK (act.comp ι') c.K ⧸ pI c.p • (⊤ : Submodule ℤ_[c.p] (AK (act.comp ι') c.K))) =
      ((Module.finrank ℤ_[c.p] Le + 1) / 2 : ℕ) := by
    refine le_antisymm ?_ hlow
    calc _ ≤ (rk (p := c.p) (T := T') : ℕ∞) := hup
      _ ≤ (rk (p := c.p) (T := Te) : ℕ∞) := by exact_mod_cast hle
      _ = _ := by rw [hrank]
  have h1 := (stablecert act hact hrank ι' hι).1 c.K hc.hK heq
  exact ⟨heq, h1⟩

/-- **`stable_of_spec` at the contract's `T'`** (L18-4; L17-2 audit MINOR-2). `stable_of_spec` holds for *any* `T' ↪ Te`
containing elements `g_j` that realise the dumped matrices; the containment `ℤ_ℓ[g_j] ⊆ T'` is all it uses. [C]'s `T'` is
`ℤ_ℓ[T_q : q ∈ S]`: here `T' := Algebra.adjoin ℤ_ℓ {g_j}` inside `Te`, the `g_j ∈ Te` realising the dumped `T_q`. -/
theorem stable_of_spec_adjoin {Le : Type*} [AddCommGroup Le] [Module ℤ_[p] Le] [Module.Free ℤ_[p] Le]
    [Module.Finite ℤ_[p] Le] {Te : Type*} [CommRing Te] [Algebra ℤ_[p] Te]
    (act : Te →ₐ[ℤ_[p]] Module.End ℤ_[p] Le) (hact : Function.Injective act)
    (hrank : rk (p := p) (T := Te) = (Module.finrank ℤ_[p] Le + 1) / 2)
    (c : SatCert) (hc : SatSpec c) (hp : c.p = p) (hf : Module.finrank ℤ_[p] Le = c.f)
    (β : (Le ⧸ (pI p ^ c.K) • (⊤ : Submodule ℤ_[p] Le)) ≃+ (Fin c.f → ZMod (p ^ c.K)))
    (hβ : ∀ (a : ℤ_[p]) y, β (a • y) = PadicInt.toZModPow c.K a • β y)
    (g : ℕ → Te) (hg : ∀ j < c.gens.length, Realizes act β (g j) (toMat c.f (p ^ c.K) (c.gens.getD j []))) :
    Module.length ℤ_[p] (AK (act.comp (Algebra.adjoin ℤ_[p] (Set.range g)).val) c.K ⧸
        pI p • (⊤ : Submodule ℤ_[p] (AK (act.comp (Algebra.adjoin ℤ_[p] (Set.range g)).val) c.K))) =
        ((Module.finrank ℤ_[p] Le + 1) / 2 : ℕ) ∧
      rk (p := p) (T := Algebra.adjoin ℤ_[p] (Set.range g)) = rk (p := p) (T := Te) ∧
      ∀ K', c.K ≤ K' → Function.Injective (redMap (act.comp (Algebra.adjoin ℤ_[p] (Set.range g)).val) K') :=
  stable_of_spec act hact hrank (Algebra.adjoin ℤ_[p] (Set.range g)).val Subtype.val_injective c hc hp hf β hβ
    (fun j => ⟨g j, Algebra.subset_adjoin ⟨j, rfl⟩⟩) hg

end Bridge

/-! ### `chk:stablecert-sound` at `T_e = e T^𝕃` (L19-1, M3-a)

`stable_of_spec_adjoin` instantiated at `act := actTe : T_e ↪ End(range e)` and `T' := ℤ_ℓ[(e g_j)|_{range e}]` for
elements `g_j ∈ T^𝕃` (the `T_q`) realising the dumped matrices; `hrank` is `rk_Te_eq` (`heckerankone`), so
`stable_of_spec_ES` carries `hES` and the checked `hc`, not `hrank`.  The trust boundary (`β`, `hβ`, `hg`, `hf`) is as
in `stable_of_spec`. -/

section StableSpecES

open GL2.Sat GL2.Literature

variable {p : ℕ} [Fact p.Prime]

variable {M : Type*} [AddCommGroup M] [Module ℤ_[p] M] (T : Subalgebra ℤ_[p] (Module.End ℤ_[p] M))
  (e : Module.End ℤ_[p] M) (he : e * e = e) (hcomm : ∀ a b : T, a * b = b * a) (heT : e ∈ T)

/-- `T' := ℤ_ℓ[(e g_j)|_{range e}] ⊆ T_e`, for elements `g_j ∈ T` (the `T_q`). -/
def Tprime (g : ℕ → T) : Subalgebra ℤ_[p] (Te T e he hcomm heT) :=
  Algebra.adjoin ℤ_[p] (Set.range fun j => resTe T e he hcomm heT (g j))

/-- The conclusion of `stable_of_spec_adjoin` at `T_e = e T` acting on `range e`, `T' = ℤ_ℓ[e g_j]`, level `K`. -/
def SpecConcl (K : ℕ) (g : ℕ → T) : Prop :=
  Module.length ℤ_[p] (AK ((actTe T e he hcomm heT).comp (Tprime T e he hcomm heT g).val) K ⧸
        pI p • (⊤ : Submodule ℤ_[p] (AK ((actTe T e he hcomm heT).comp (Tprime T e he hcomm heT g).val) K))) =
      ((Module.finrank ℤ_[p] (LinearMap.range e) + 1) / 2 : ℕ) ∧
    rk (p := p) (T := Tprime T e he hcomm heT g) = rk (p := p) (T := Te T e he hcomm heT) ∧
    ∀ K', K ≤ K' → Function.Injective (redMap ((actTe T e he hcomm heT).comp (Tprime T e he hcomm heT g).val) K')

/-- `stable_of_spec_adjoin` at `T_e = e T` on `range e`, given `hrank` (generic in `M`; `stable_of_spec_ES`
discharges `hrank`). -/
theorem stable_of_spec_Te [Module.Free ℤ_[p] M] [Module.Finite ℤ_[p] M]
    (hrank : rk (p := p) (T := Te T e he hcomm heT) = (Module.finrank ℤ_[p] (LinearMap.range e) + 1) / 2)
    (c : SatCert) (hc : SatSpec c) (hp : c.p = p) (hf : Module.finrank ℤ_[p] (LinearMap.range e) = c.f)
    (β : (LinearMap.range e ⧸ (pI p ^ c.K) • (⊤ : Submodule ℤ_[p] (LinearMap.range e))) ≃+ (Fin c.f → ZMod (p ^ c.K)))
    (hβ : ∀ (a : ℤ_[p]) y, β (a • y) = PadicInt.toZModPow c.K a • β y)
    (g : ℕ → T) (hg : ∀ j < c.gens.length, Realizes (actTe T e he hcomm heT) β (resTe T e he hcomm heT (g j))
      (toMat c.f (p ^ c.K) (c.gens.getD j []))) :
    SpecConcl T e he hcomm heT c.K g := by
  have := Te_range_free (p := p) e
  have := Te_range_finite (p := p) e
  exact stable_of_spec_adjoin (actTe T e he hcomm heT) (actTe_injective T e he hcomm heT) hrank c hc hp hf β hβ
    (fun j => resTe T e he hcomm heT (g j)) hg

variable {L : Type*} [AddCommGroup L] [Module ℤ_[p] L] [Module.Finite ℤ_[p] L]
  {ι : Type*} (X : ι → Module.End ℤ_[p] L)

/-- **Soundness of the `stable` checker at `T_e = e T^𝕃`** (L19-1, M3-a; [GT] `chk:stablecert-sound`):
`stable_of_spec_adjoin` with `act := actTe : T_e ↪ End(e𝕃')`, `T' := ℤ_ℓ[(e g_j)|_{e𝕃'}]` for `g_j ∈ T^𝕃` realising the
dumped matrices (`hg`, the trust boundary, with `β`, `hβ`, `hf`), and `hrank` discharged by `rk_Te_eq`
(`heckerankone`). Literature: `hES` only; `hc` is the checked predicate. -/
theorem stable_of_spec_ES (E : Type*) [Field E] [Algebra ℤ_[p] E] [Algebra ℚ_[p] E] [IsScalarTower ℤ_[p] ℚ_[p] E]
    (hES : EichlerShimuraLevelOne (Lfree (p := p) L) (fun i => onFree (X i)) E)
    (e : Module.End ℤ_[p] (Lfree (p := p) L)) (heT : e ∈ TL X) (he : e * e = e)
    (c : SatCert) (hc : SatSpec c) (hp : c.p = p) (hf : Module.finrank ℤ_[p] (LinearMap.range e) = c.f)
    (β : (LinearMap.range e ⧸ (pI p ^ c.K) • (⊤ : Submodule ℤ_[p] (LinearMap.range e))) ≃+ (Fin c.f → ZMod (p ^ c.K)))
    (hβ : ∀ (a : ℤ_[p]) y, β (a • y) = PadicInt.toZModPow c.K a • β y)
    (g : ℕ → TL X) (hg : ∀ j < c.gens.length,
      Realizes (actTe (TL X) e he (TL_mul_comm X E hES) heT) β (resTe (TL X) e he (TL_mul_comm X E hES) heT (g j))
        (toMat c.f (p ^ c.K) (c.gens.getD j []))) :
    SpecConcl (TL X) e he (TL_mul_comm X E hES) heT c.K g := by
  have : Module.Free ℤ_[p] (Lfree (p := p) L) := Module.free_of_finite_type_torsion_free'
  exact stable_of_spec_Te (TL X) e he _ heT (rk_Te_eq X E hES e heT he) c hc hp hf β hβ g hg

end StableSpecES

end GL2.SatChk
