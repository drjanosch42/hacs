    email: fabian.januszewski@math.uni-paderborn.de
    affiliation: "Universität Paderborn"
license: LGPL-3.0-only
repository-code: "https://github.com/drjanosch42/hacs"
version: "0.1.0"
keywords:
  - cohomology of arithmetic groups
  - Hecke operators
  - orbifold cohomology
  - modular forms
  - congruences
references:
